<Project TreatAsLocalProperty="IsoplaneMemoryMaxBytes">
  <PropertyGroup>
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '../../../..', '.build', 'wasm32', 'runtime', 'nuget'))</RestorePackagesPath>
    <IsoplaneSqliteDirectory Condition="'$(IsoplaneSqliteDirectory)' == '' AND '$(ISOPLANE_SQLITE_DIRECTORY)' != ''">$([MSBuild]::EnsureTrailingSlash('$(ISOPLANE_SQLITE_DIRECTORY)'))</IsoplaneSqliteDirectory>
    <IsoplaneLocalDebug Condition="'$(IsoplaneLocalDebug)' == ''">false</IsoplaneLocalDebug>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../Build/Isoplane.SourceReferences.props" />

  <!--
    The application-independent Mono runtime: the interpreter, the BCL and the
    SDK behind a fixed entry that loads whichever application package the host
    serves. Its managed/native bridges come from those assemblies alone, so one
    linked and compiled module serves every interpreted application.
  -->
  <Import Project="../../Isoplane.Guest.props" />
  <Import Project="../../../../tools/BuildProtocol/WasmMemory.props" />

  <PropertyGroup>
    <AssemblyName>Isoplane.MonoRuntime</AssemblyName>
    <RootNamespace>Isoplane.MonoRuntime</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WasmBuildOnlyAfterPublish>true</WasmBuildOnlyAfterPublish>
    <EventSourceSupport>true</EventSourceSupport>
    <!-- The shared module serves every application limit; the host bounds each instance. -->
    <IsoplaneMemoryMaxBytes>$(Wasm32MemoryMaxBytes)</IsoplaneMemoryMaxBytes>
    <IsoplaneRouter>Isoplane.MonoRuntime.PackageRouter</IsoplaneRouter>
  </PropertyGroup>

  <!-- The runtime's own assemblies need only blittable marshalling, so the
       build would link the marshaller stub, which aborts the instance on an
       application declaration that needs more, such as SQLitePCLRaw's out
       parameters and safe handles. -->
  <ItemGroup>
    <_MonoComponent Include="marshal-ilgen" />
  </ItemGroup>

  <!-- SQLite, as the e_sqlite3 module SQLitePCLRaw imports, from
       ../sqlite/build.sh, whose output directory build.sh passes. -->
  <ItemGroup>
    <NativeFileReference Include="$(IsoplaneSqliteDirectory)e_sqlite3.a" />
    <IsoplanePInvokeModule Include="e_sqlite3" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../sqlite/sqlite_callbacks.c" />
    <Compile Include="$(IsoplaneSqliteDirectory)SqliteImports.g.cs" />
    <WasiAfterRuntimeLoadedDeclarations Include="void isoplane_install_sqlite_callbacks(void)%3B" />
    <WasiAfterRuntimeLoadedCalls Include="isoplane_install_sqlite_callbacks()%3B" />
  </ItemGroup>
  <Target Name="IsoplaneRequireSqlite" BeforeTargets="CoreCompile">
    <Error Condition="'$(IsoplaneSqliteDirectory)' == '' OR !Exists('$(IsoplaneSqliteDirectory)e_sqlite3.a') OR !Exists('$(IsoplaneSqliteDirectory)SqliteImports.g.cs')"
           Text="isoplane: build the runtime with task runtime:modules, which builds SQLite and passes -p:IsoplaneSqliteDirectory." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../Isoplane.Sdk.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../AspNetCore/Isoplane.AspNetCore.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../../tools/BuildProtocol/ManagedApplication.cs" Link="ManagedApplication.cs" />
  </ItemGroup>

  <!-- The managed bundle treats the framework and the SDK as the platform and
       carries every NuGet assembly, the SDK's dependencies included, in the
       package; a runtime copy would shadow the package's. -->
  <Target Name="IsoplaneRuntimeLeavesPackagesToApplications" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" />
    </ItemGroup>
  </Target>
  <!-- Isoplane.AspNetCore is runtime content; the ASP.NET it binds to is
       package content, so an application chooses its ASP.NET patch release. -->
  <Target Name="IsoplaneRuntimeLeavesAspNetToApplications" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(_IsoplaneAspNetAssembly)" />
    </ItemGroup>
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../Isoplane.Guest.targets" />
  <Import Project="../../AspNetCore/buildTransitive/Isoplane.AspNetCore.Framework.targets" />
  <Import Project="../../Build/Isoplane.Exports.targets" />
</Project>
