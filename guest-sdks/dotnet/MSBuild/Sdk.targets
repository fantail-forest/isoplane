<Project>
  <PropertyGroup>
    <IsoplaneGuestRuntime Condition="'$(IsoplaneGuestRuntime)' == '' AND '$(PublishAot)' == 'true'">NativeAOT</IsoplaneGuestRuntime>
    <IsoplaneGuestRuntime Condition="'$(IsoplaneGuestRuntime)' == '' AND '$(PublishAot)' == 'false'">Mono</IsoplaneGuestRuntime>
  </PropertyGroup>
  <Import Project="../tools/Isoplane.Guest.props" />
  <Import Project="../tools/Build/Isoplane.ManagedBundle.props" />
  <PropertyGroup>
    <WasmBuildOnlyAfterPublish Condition="'$(IsoplaneGuestRuntime)' == 'Mono'">true</WasmBuildOnlyAfterPublish>
    <SupportsHotReload>false</SupportsHotReload>
    <RunCommand Condition="'$(RunCommand)' == ''">isoplane</RunCommand>
  </PropertyGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../tools/Isoplane.Guest.targets" />
  <Import Project="../tools/Build/Isoplane.Run.targets" />
  <Import Project="../tools/Build/Isoplane.ManagedBundle.targets" />
  <Import Project="../tools/Build/Isoplane.Conformance.targets" />
  <Import Project="../tools/Build/Isoplane.Handler.targets" />
  <Import Project="../tools/Build/Isoplane.Exports.targets" />
</Project>
