<Project>
  <PropertyGroup>
    <WispGuestRuntime Condition="'$(WispGuestRuntime)' == '' AND '$(PublishAot)' == 'true'">NativeAOT</WispGuestRuntime>
    <WispGuestRuntime Condition="'$(WispGuestRuntime)' == '' AND '$(PublishAot)' == 'false'">Mono</WispGuestRuntime>
  </PropertyGroup>
  <Import Project="../tools/Wisp.Guest.props" />
  <Import Project="../tools/Build/Wisp.ManagedBundle.props" />
  <PropertyGroup>
    <WasmBuildOnlyAfterPublish Condition="'$(WispGuestRuntime)' == 'Mono'">true</WasmBuildOnlyAfterPublish>
    <SupportsHotReload>false</SupportsHotReload>
    <RunCommand Condition="'$(RunCommand)' == ''">isoplane</RunCommand>
  </PropertyGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../tools/Wisp.Guest.targets" />
  <Import Project="../tools/Build/Wisp.Run.targets" />
  <Import Project="../tools/Build/Wisp.ManagedBundle.targets" />
  <Import Project="../tools/Build/Wisp.Conformance.targets" />
  <Import Project="../tools/Build/Wisp.Handler.targets" />
  <Import Project="../tools/Build/Wisp.Exports.targets" />
</Project>
