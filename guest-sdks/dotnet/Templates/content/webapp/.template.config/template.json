{
  "$schema": "http://json.schemastore.org/template",
  "author": "Isoplane",
  "classifications": ["Web", "Razor Pages", "Isoplane"],
  "identity": "Isoplane.Templates.WebApp",
  "name": "Isoplane ASP.NET Core Web App (Razor Pages)",
  "description": "A server-rendered web application for the Isoplane sandbox with Razor Pages, Entity Framework Core, PostgreSQL and tests.",
  "shortName": "isoplane-webapp",
  "sourceName": "Sample-WebApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "guids": ["9d2e4b7a-1c3f-4a85-b6e0-7f1a2c3d4e58"],
  "symbols": {
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json."
    },
    "HttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 5000, "high": 5300 }
    },
    "HttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "HttpPort", "fallbackVariableName": "HttpPortGenerated" },
      "replaces": "5080"
    }
  },
  "primaryOutputs": [
    { "path": "src/Sample-WebApp/Sample-WebApp.csproj" },
    { "path": "tests/Sample-WebApp.Tests/Sample-WebApp.Tests.csproj" }
  ]
}
