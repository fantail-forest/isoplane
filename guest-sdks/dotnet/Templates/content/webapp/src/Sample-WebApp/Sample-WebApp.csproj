<!--
  Isoplane.AspNetCore builds this project into an application package for the
  Isoplane sandbox, and makes `dotnet run` start it there. It takes the place of
  Microsoft.NET.Sdk.Web: Razor pages are compiled and the files in wwwroot are
  packaged as they are there. The number after the slash is the SDK version,
  which also selects the runtime the application runs on.
-->
<Project Sdk="Isoplane.AspNetCore/0.1.0">

  <PropertyGroup>
    <!-- The SDK sets TargetFramework to net10.0, the framework it supports. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Names this project's User Secrets store. Program.cs shows where configuration comes from. -->
    <UserSecretsId>9d2e4b7a-1c3f-4a85-b6e0-7f1a2c3d4e58</UserSecretsId>

    <!--
      The build warns about code that does not suit the sandbox: starting a thread
      (ISOPLANE1002) and waiting synchronously (ISOPLANE1003). It inspects this
      project and the projects it references. Remove the comment markers from a
      line below to change that.
    -->
    <!-- Inspect NuGet packages too: -->
    <!-- <IsoplaneAnalyzeDependencies>true</IsoplaneAnalyzeDependencies> -->
    <!-- Report declarations of native imports (ISOPLANE1001): -->
    <!-- <IsoplaneWarnOnNativeImports>true</IsoplaneWarnOnNativeImports> -->
    <!-- Fail the build on these warnings: -->
    <!-- <WarningsAsErrors>$(WarningsAsErrors);ISOPLANE1002;ISOPLANE1003</WarningsAsErrors> -->

    <!--
      The build writes the `isoplane` skill for AI coding agents, with the rules and reference
      pages for the Isoplane packages this project uses, into `.agents/skills/` and `.claude/skills/`
      at the repository root; `.agents/skills/isoplane/SKILL.md` explains it. Remove the comment
      markers from a line below to change that.
    -->
    <!-- Do not write the skill: -->
    <!-- <IsoplaneWriteAgentSkill>false</IsoplaneWriteAgentSkill> -->
    <!-- Write it to other skills directories; the first holds the files, the others link to it: -->
    <!-- <IsoplaneAgentSkillDirectories>.agents/skills;.claude/skills</IsoplaneAgentSkillDirectories> -->
    <!-- Write it under a directory other than the nearest one with a .git entry or a solution file: -->
    <!-- <IsoplaneAgentSkillRoot>$(MSBuildProjectDirectory)/..</IsoplaneAgentSkillRoot> -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      ASP.NET Core itself, Razor Pages included, comes with the SDK. Add other
      NuGet packages as in any .NET project:
        dotnet add src/Sample-WebApp package <name>
    -->
    <!--
      Provides UseKeysFromDbContext, which Program.cs calls to keep the Data
      Protection keys in the database. It brings in
      Microsoft.AspNetCore.DataProtection.EntityFrameworkCore, which defines
      the DataProtectionKeys table that Data/AppDbContext.cs declares.

      Isoplane puts what it adds for one particular library in a package of
      its own, named after that library, so that an application which does not
      use Entity Framework Core never restores it: the Isoplane.AspNetCore SDK
      above does not depend on it. Keep this version equal to the SDK version
      in the <Project> line, and change both together when you update.
    -->
    <PackageReference Include="Isoplane.AspNetCore.DataProtection.EntityFrameworkCore" Version="0.1.0" />
    <!-- Used by `dotnet ef` on your machine only; PrivateAssets keeps it out of the application package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
