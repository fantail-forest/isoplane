<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sample-WebApp</title>
    @* wwwroot/css/site.css. asp-append-version links to the fingerprinted name the build gives the file. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a asp-page="/Index">Sample-WebApp</a>
    </header>
    <main>
        @* A page handler calls TempData.Confirm before it redirects (see Confirmation.cs), and
           the page redirected to shows the confirmation once. TempData keeps it in a cookie that
           Data Protection encrypts (see Program.cs). The wording is in ConfirmationWording, to
           change as you like, and a confirmation with no wording is not shown. data-confirmation
           names the outcome, so a script or a test can tell one confirmation from another without
           reading the wording. *@
        @if (TempData.TakeConfirmation() is { } confirmation && ConfirmationWording.For(confirmation) is { } wording)
        {
            <p id="confirmation" class="flash" role="status" data-confirmation="@confirmation">@wording</p>
        }
        @RenderBody()
    </main>
</body>
</html>
