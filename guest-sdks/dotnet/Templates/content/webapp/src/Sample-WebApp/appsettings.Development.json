{
  // Read after appsettings.json when ASPNETCORE_ENVIRONMENT is Development, which
  // the launch profile in Properties/launchSettings.json sets. Values here
  // override the ones in appsettings.json.
  "ConnectionStrings": {
    // The database that `docker compose up` starts from compose.yaml. Its
    // password is a development default, which is why it can be committed. A
    // real connection string belongs in User Secrets:
    //   dotnet user-secrets set "ConnectionStrings:Database" "Host=...;Password=..." --project src/Sample-WebApp
    "Database": "Host=localhost;Port=5432;Database=sample_webapp;Username=postgres;Password=postgres"
  }
}
