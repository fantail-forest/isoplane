<!--
  Isoplane.Sdk builds this project into an application package for the Isoplane
  sandbox, and makes `dotnet run` start it there. The number after the slash is
  the SDK version, which also selects the runtime the application runs on.

  An ASP.NET Core application uses Isoplane.AspNetCore in place of Isoplane.Sdk;
  `dotnet new isoplane-web` creates one.
-->
<Project Sdk="Isoplane.Sdk/0.1.0">

  <PropertyGroup>
    <!-- The SDK sets TargetFramework to net10.0, the framework it supports. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Names this project's User Secrets store. Handler.InitializeAsync shows where settings come from. -->
    <UserSecretsId>aae6837a-c53b-4877-84c1-f726d9d4cf65</UserSecretsId>

    <!--
      The build warns about code that does not suit the sandbox: starting a thread
      (ISOPLANE1002) and waiting synchronously (ISOPLANE1003). It inspects this
      project and the projects it references. Remove the comment markers from a
      line below to change that.
    -->
    <!-- Inspect NuGet packages too: -->
    <!-- <IsoplaneAnalyzeDependencies>true</IsoplaneAnalyzeDependencies> -->
    <!-- Report declarations of native imports (ISOPLANE1001): -->
    <!-- <IsoplaneWarnOnNativeImports>true</IsoplaneWarnOnNativeImports> -->
    <!-- Fail the build on these warnings: -->
    <!-- <WarningsAsErrors>$(WarningsAsErrors);ISOPLANE1002;ISOPLANE1003</WarningsAsErrors> -->

    <!--
      The build writes the `isoplane` skill for AI coding agents, with the rules and reference
      pages for the Isoplane packages this project uses, into `.agents/skills/` and `.claude/skills/`
      at the repository root; `.agents/skills/isoplane/SKILL.md` explains it. Remove the comment
      markers from a line below to change that.
    -->
    <!-- Do not write the skill: -->
    <!-- <IsoplaneWriteAgentSkill>false</IsoplaneWriteAgentSkill> -->
    <!-- Write it to other skills directories; the first holds the files, the others link to it: -->
    <!-- <IsoplaneAgentSkillDirectories>.agents/skills;.claude/skills</IsoplaneAgentSkillDirectories> -->
    <!-- Write it under a directory other than the nearest one with a .git entry or a solution file: -->
    <!-- <IsoplaneAgentSkillRoot>$(MSBuildProjectDirectory)/..</IsoplaneAgentSkillRoot> -->
  </PropertyGroup>

  <!--
    Add NuGet packages as in any .NET project:
      dotnet add src/Sample-Handler package <name>
  -->

</Project>
