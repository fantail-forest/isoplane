{
  "$schema": "http://json.schemastore.org/template",
  "author": "Isoplane",
  "classifications": ["Isoplane", "Service", "Handler"],
  "identity": "Isoplane.Templates.Handler",
  "name": "Isoplane Handler",
  "description": "A service for the Isoplane sandbox that handles HTTP requests in one static method, without ASP.NET, with tests.",
  "shortName": "isoplane-handler",
  "sourceName": "Sample-Handler",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "guids": ["aae6837a-c53b-4877-84c1-f726d9d4cf65"],
  "symbols": {
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json."
    },
    "DotAgents": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Whether to include the isoplane skill for AI coding agents in .agents/skills, for agents that follow the Agent Skills convention."
    },
    "DotClaude": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Whether to include the isoplane skill for AI coding agents in .claude/skills, for Claude Code."
    },
    "HttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 5000, "high": 5300 }
    },
    "HttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "HttpPort", "fallbackVariableName": "HttpPortGenerated" },
      "replaces": "5080"
    }
  },
  "sources": [
    { "source": "./", "target": "./" },
    {
      "source": "./.template.config/skills/isoplane/",
      "target": "./.agents/skills/isoplane/",
      "condition": "(DotAgents)",
      "copyOnly": ["**"]
    },
    {
      "source": "./.template.config/skills/isoplane/",
      "target": "./.claude/skills/isoplane/",
      "condition": "(DotClaude)",
      "copyOnly": ["**"]
    }
  ],
  "primaryOutputs": [
    { "path": "src/Sample-Handler/Sample-Handler.csproj" },
    { "path": "tests/Sample-Handler.Tests/Sample-Handler.Tests.csproj" }
  ]
}
