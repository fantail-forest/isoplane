{
  "$schema": "http://json.schemastore.org/template",
  "author": "Isoplane",
  "classifications": ["Isoplane", "Service", "Handler"],
  "identity": "Isoplane.Templates.Handler",
  "name": "Isoplane Handler",
  "description": "A service for the Isoplane sandbox that handles HTTP requests in one static method, without ASP.NET, with tests.",
  "shortName": "isoplane-handler",
  "sourceName": "Sample-Handler",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json."
    },
    "HttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 5000, "high": 5300 }
    },
    "HttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "HttpPort", "fallbackVariableName": "HttpPortGenerated" },
      "replaces": "5080"
    }
  },
  "primaryOutputs": [
    { "path": "src/Sample-Handler/Sample-Handler.csproj" },
    { "path": "tests/Sample-Handler.Tests/Sample-Handler.Tests.csproj" }
  ]
}
