{
  "$schema": "http://json.schemastore.org/template",
  "author": "Isoplane",
  "classifications": ["Web", "Web API", "API", "Service", "Isoplane"],
  "identity": "Isoplane.Templates.WebApi",
  "name": "Isoplane ASP.NET Core Web API",
  "description": "A Web API for the Isoplane sandbox with Entity Framework Core, PostgreSQL, OpenAPI and tests.",
  "shortName": "isoplane-webapi",
  "sourceName": "Sample-Api",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "guids": ["b7c3d2a1-5e4f-4a6b-9c8d-0e1f2a3b4c5d"],
  "symbols": {
    "UseControllers": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to use controllers instead of minimal APIs."
    },
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json."
    },
    "HttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 5000, "high": 5300 }
    },
    "HttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "HttpPort", "fallbackVariableName": "HttpPortGenerated" },
      "replaces": "5080"
    }
  },
  "sources": [
    {
      "modifiers": [
        { "condition": "(UseControllers)", "exclude": ["src/Sample-Api/Todos/TodoEndpoints.cs"] },
        { "condition": "(!UseControllers)", "exclude": ["src/Sample-Api/Todos/TodosController.cs"] }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "src/Sample-Api/Sample-Api.csproj" },
    { "path": "tests/Sample-Api.Tests/Sample-Api.Tests.csproj" }
  ]
}
