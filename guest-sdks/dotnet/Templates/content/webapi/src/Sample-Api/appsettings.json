{
  // Settings for every environment. ASP.NET reads this file with comments and
  // trailing commas allowed. Keep credentials out of it: put them in User Secrets
  // (see Program.cs).
  "Logging": {
    "LogLevel": {
      // Log output appears in the terminal running the session and, once
      // deployed, in `isoplane logs`.
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Set to "Information" to see the SQL each request runs.
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Notifications": {
    // Where completed todos are posted. Notifications are off while this is null.
    // Bound to NotificationOptions in Notifications/CompletionNotifier.cs.
    "WebhookUrl": null
  }
}
