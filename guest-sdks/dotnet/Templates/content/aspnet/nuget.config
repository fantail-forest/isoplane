<?xml version="1.0" encoding="utf-8"?>
<!-- The NativeAOT-LLVM compiler is not on nuget.org; it ships only from the
     dnceng `dotnet-experimental` feed. The whole C# story rides on an
     experimental feed nobody here controls, and this file is where that
     dependency is concrete. -->
<configuration>
  <packageSources>
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-experimental" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json" />
  </packageSources>
</configuration>
