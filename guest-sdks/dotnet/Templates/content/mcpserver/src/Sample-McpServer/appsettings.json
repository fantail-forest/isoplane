{
  // Settings for every environment. ASP.NET reads this file with comments and
  // trailing commas allowed. Keep credentials out of it: put them in User Secrets
  // (see Program.cs).
  "Logging": {
    "LogLevel": {
      // Log output appears in the terminal running the session and, once
      // deployed, in `isoplane logs`.
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Set to "Information" to see each MCP request the server handles.
      "ModelContextProtocol": "Warning"
    }
  },
  "Handbook": {
    // The most articles one search returns, whatever limit the caller asks for.
    // Bound to HandbookOptions in Knowledge/Handbook.cs.
    "MaxResults": 5
  }
}
