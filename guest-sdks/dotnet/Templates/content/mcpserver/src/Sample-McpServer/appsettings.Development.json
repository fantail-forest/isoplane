{
  // Read after appsettings.json when ASPNETCORE_ENVIRONMENT is Development, which
  // the launch profile in Properties/launchSettings.json sets. A value here
  // overrides the same value in appsettings.json.
  "Logging": {
    "LogLevel": {
      // Set to "Information" to see each request ASP.NET handles.
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
