{
  "$schema": "http://json.schemastore.org/template",
  "author": "Isoplane",
  "classifications": ["Web", "Isoplane", "Empty"],
  "identity": "Isoplane.Templates.AspNetCore",
  "name": "Isoplane ASP.NET Core Empty",
  "description": "An empty ASP.NET Core application that runs in the Isoplane sandbox.",
  "shortName": "isoplane-web",
  "sourceName": "Sample-App",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "guids": ["75e845a2-0587-46f2-856a-d06cc6dd4495"],
  "symbols": {
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json."
    },
    "DotAgents": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Whether to include the isoplane skill for AI coding agents in .agents/skills, for agents that follow the Agent Skills convention."
    },
    "DotClaude": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Whether to include the isoplane skill for AI coding agents in .claude/skills, for Claude Code."
    },
    "HttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 5000, "high": 5300 }
    },
    "HttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": { "sourceVariableName": "HttpPort", "fallbackVariableName": "HttpPortGenerated" },
      "replaces": "5080"
    }
  },
  "sources": [
    { "source": "./", "target": "./" },
    {
      "source": "./.template.config/skills/isoplane/",
      "target": "./.agents/skills/isoplane/",
      "condition": "(DotAgents)",
      "copyOnly": ["**"]
    },
    {
      "source": "./.template.config/skills/isoplane/",
      "target": "./.claude/skills/isoplane/",
      "condition": "(DotClaude)",
      "copyOnly": ["**"]
    }
  ],
  "primaryOutputs": [{ "path": "Sample-App.csproj" }]
}
