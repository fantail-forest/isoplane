{
  // Settings for every environment. ASP.NET reads this file with comments and
  // trailing commas allowed. Keep credentials out of it: put them in User Secrets
  // (see Program.cs).
  "Logging": {
    "LogLevel": {
      // Log output appears in the terminal running the session and, once
      // deployed, in `isoplane logs`.
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }

  // Add your own settings as sections beside "Logging", for example:
  //
  //   "Greeting": { "Message": "Hello from a setting!" }
  //
  // and read them through IConfiguration as "Greeting:Message" (see Program.cs).
}
