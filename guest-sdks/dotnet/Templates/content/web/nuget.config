<?xml version="1.0" encoding="utf-8"?>
<!--
  Where packages are restored from. The Isoplane SDK named in the project file
  comes from nuget.org like any other package.
  To use a private feed as well, give it an <add> line of its own.
-->
<configuration>
  <packageSources>
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
