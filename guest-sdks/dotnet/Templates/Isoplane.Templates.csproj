<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Isoplane.Templates</PackageId>
    <Description>Isoplane .NET application templates.</Description>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="PackageReadme.md" Pack="true" PackagePath="/" />
    <TemplateProject Include="content/**/*.csproj" />
    <Content Include="content/**" Exclude="content/**/bin/**;content/**/obj/**;content/**/.isoplane/**;@(TemplateProject)" />
  </ItemGroup>
  <!-- The assembly is not shipped, but its source revision changes the package metadata. -->
  <Target Name="TrackTemplateAssemblyForPacking" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <NuGetPackInput Include="$(TargetPath)" />
    </ItemGroup>
  </Target>
  <!-- A generated project names the SDK and test library of the release that generated it. -->
  <Target Name="StampTemplateVersions" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_IsoplanePackagePin>(Sdk="Isoplane\.[A-Za-z.]+/|PackageReference Include="Isoplane\.[A-Za-z.]+" Version=")[^"]+</_IsoplanePackagePin>
    </PropertyGroup>
    <ItemGroup>
      <_StampedTemplateProject Include="@(TemplateProject->'$(IntermediateOutputPath)package/%(RecursiveDir)%(Filename)%(Extension)')"
                               Stamped="$([MSBuild]::Escape($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_IsoplanePackagePin)', '${1}$(PackageVersion)'))))"
                               PackagePath="content/content/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <WriteLinesToFile File="%(_StampedTemplateProject.Identity)" Lines="%(_StampedTemplateProject.Stamped)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="@(_StampedTemplateProject)" Pack="true" />
    </ItemGroup>
  </Target>
  <Import Project="../../../licenses/SdkPackage.props" />
</Project>
