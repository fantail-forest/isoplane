<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Build/Isoplane.SourceReferences.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <PackageId>Isoplane.AspNetCore</PackageId>
    <Description>ASP.NET hosting over Isoplane request dispatch, without a guest listener.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Isoplane.AspNetCore.Tests" />
    <InternalsVisibleTo Include="Isoplane.MonoRuntime" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- A dependency's analyzers are private by default; these check ASP.NET applications too. -->
    <ProjectReference Include="../Isoplane.Sdk.csproj" PrivateAssets="contentfiles;build" />
    <ProjectReference Include="../Conformance/Conformance.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Update="PackageReadme.md" Pack="true" PackagePath="/" />
    <None Include="Sdk/**" Exclude="Sdk/Sdk.props" Pack="true" PackagePath="Sdk/" />
    <None Include="../Build/Isoplane.ManagedBundle.*;../Build/Isoplane.Conformance.targets;../Build/Isoplane.Run.targets;../Build/Isoplane.AgentSkill.targets" Pack="true" PackagePath="tools/Build/" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <Target Name="StampPackagedSdkVersion" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_PackagedSdkProps>$(IntermediateOutputPath)package/Sdk.props</_PackagedSdkProps>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)package" />
    <Copy SourceFiles="Sdk/Sdk.props" DestinationFiles="$(_PackagedSdkProps)" />
    <XmlPoke XmlInputPath="$(_PackagedSdkProps)" Query="/Project/ItemGroup/PackageReference[@Include='Isoplane.AspNetCore']/@Version" Value="$(PackageVersion)" />
    <XmlPoke XmlInputPath="$(_PackagedSdkProps)" Query="/Project/PropertyGroup/IsoplaneSdkVersion" Value="$(PackageVersion)" />
    <ItemGroup>
      <None Include="$(_PackagedSdkProps)" Pack="true" PackagePath="Sdk/Sdk.props" />
    </ItemGroup>
  </Target>
  <Import Project="../../../licenses/SdkPackage.props" />
  <Import Project="../Conformance/Pack.targets" />
  <PropertyGroup><IsoplaneSkillPart>aspnetcore</IsoplaneSkillPart></PropertyGroup>
  <Import Project="../Skill/Pack.targets" />
</Project>
