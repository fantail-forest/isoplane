<Project>
  <PropertyGroup>
    <_IsoplaneAspNetCorePropsImported>true</_IsoplaneAspNetCorePropsImported>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <!-- The agent skill part for this package; `isoplane skills install` reads it from the project's evaluation. -->
  <ItemGroup>
    <IsoplaneAgentSkillPart Include="$(MSBuildThisFileDirectory)../tools/skill/aspnetcore.md" />
  </ItemGroup>
</Project>
