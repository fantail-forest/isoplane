<Project>
  <PropertyGroup>
    <_IsoplaneAspNetCorePropsImported>true</_IsoplaneAspNetCorePropsImported>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <!-- The agent skill part for this package; the Isoplane SDK writes it into the project's skill. -->
  <ItemGroup>
    <IsoplaneAgentSkillPart Include="$(MSBuildThisFileDirectory)../tools/skill/references/aspnetcore" Name="aspnetcore" />
  </ItemGroup>
</Project>
