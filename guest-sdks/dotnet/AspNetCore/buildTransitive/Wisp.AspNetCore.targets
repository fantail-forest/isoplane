<Project>
  <PropertyGroup><_WispAspNetCoreTargetsImported>true</_WispAspNetCoreTargetsImported></PropertyGroup>
  <Target Name="WispSelectAspNetCore" BeforeTargets="ProcessFrameworkReferences;ResolveAssemblyReferences;WispResolveManagedPlatform"
          Condition="'$(WispAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <_WispAspNetFramework Include="@(FrameworkReference)" Condition="'%(Identity)' == 'Microsoft.AspNetCore.App'" />
      <_WispAspNetKnownFramework Include="@(KnownFrameworkReference)" Condition="'%(Identity)' == 'Microsoft.AspNetCore.App' AND '%(TargetFramework)' == '$(TargetFramework)'" />
    </ItemGroup>
    <PropertyGroup>
      <WispAspNetCoreRuntimeVersion Condition="'$(WispAspNetCoreRuntimeVersion)' == ''">@(_WispAspNetFramework->'%(RuntimeFrameworkVersion)')</WispAspNetCoreRuntimeVersion>
      <WispAspNetCoreRuntimeVersion Condition="'$(WispAspNetCoreRuntimeVersion)' == ''">$(RuntimeFrameworkVersion)</WispAspNetCoreRuntimeVersion>
      <WispAspNetCoreRuntimeVersion Condition="'$(WispAspNetCoreRuntimeVersion)' == ''">@(_WispAspNetKnownFramework->'%(LatestRuntimeFrameworkVersion)')</WispAspNetCoreRuntimeVersion>
    </PropertyGroup>
  </Target>
  <Target Name="WispAspNetCoreDownloads" BeforeTargets="CollectPackageDownloads" DependsOnTargets="WispSelectAspNetCore"
          Condition="'$(WispAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <PackageDownload Remove="Microsoft.AspNetCore.App.Runtime.linux-x64;Microsoft.AspNetCore.App.Ref" />
      <PackageDownload Include="Microsoft.AspNetCore.App.Runtime.linux-x64;Microsoft.AspNetCore.App.Ref" Version="[$(WispAspNetCoreRuntimeVersion)]" />
    </ItemGroup>
  </Target>
  <Target Name="WispGenerateAspNetCoreEntrypoint" BeforeTargets="CoreCompile" Condition="'$(WispManagedBundleBuild)' != 'true'">
    <Error Condition="'$(WispApplicationFactory)' == ''" Code="WISP0079"
           Text="Set WispApplicationFactory to the fully qualified static method that builds and returns your WebApplication, for example MyApp.Application.Create." />
    <PropertyGroup>
      <_WispEntrypoint>$(IntermediateOutputPath)Wisp.AspNetCore.g.cs</_WispEntrypoint>
      <_WispEntrypointSource><![CDATA[
#nullable enable
using System.Runtime.InteropServices;
using Guest = Wisp.Abi.Exports<WispGeneratedRouter>;
internal sealed class WispGeneratedRouter : Wisp.Durable.IStreamingHttpRouter {
  private Wisp.AspNetCore.WispApplication? application;
  public void Boot() { application = new(global::$(WispApplicationFactory)()); }
  public bool StreamsRequest(Wisp.RequestHead request) => true;
  public System.Threading.Tasks.Task<Wisp.Response> RouteStreamingAsync(Wisp.StreamingRequest request, Wisp.Ctx context) => application!.HandleStreamingAsync(request);
  public System.Threading.Tasks.Task<Wisp.Response> Route(Wisp.Abi.DispatchRecord record, Wisp.Ctx context) {
    return application!.HandleAsync(Wisp.Request.FromDispatch(record));
  }
}
]]></_WispEntrypointSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(_WispEntrypoint)" Lines="$([MSBuild]::Escape($(_WispEntrypointSource)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(_WispEntrypoint)" /></ItemGroup>
  </Target>
  <Target Name="WispAspNetCoreFrameworkReferences" BeforeTargets="ProcessFrameworkReferences" DependsOnTargets="WispSelectAspNetCore">
    <ItemGroup><FrameworkReference Remove="Microsoft.AspNetCore.App" /></ItemGroup>
  </Target>
  <Target Name="WispAspNetCoreFrameworkAssemblies" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="WispSelectAspNetCore;ResolvePackageAssets" Condition="'$(WispAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <_WispAspNetAssembly Include="$(NuGetPackageRoot)/microsoft.aspnetcore.app.runtime.linux-x64/$(WispAspNetCoreRuntimeVersion)/runtimes/linux-x64/lib/net10.0/*.dll" />
    </ItemGroup>
    <Error Condition="'@(_WispAspNetAssembly)' == ''" Text="wisp: selected managed ASP.NET implementation pack missing; restore the project before publishing." />
    <ItemGroup>
      <_WispAspNetAssembly Remove="@(ResolvedCompileFileDefinitions)" MatchOnMetadata="Filename;Extension" MatchOnMetadataOptions="CaseInsensitive" />
      <Reference Include="@(_WispAspNetAssembly)" Private="true" />
    </ItemGroup>
  </Target>
  <Target Name="WispAspNetCoreGenerator" BeforeTargets="CoreCompile" DependsOnTargets="WispSelectAspNetCore"
          Condition="'$(WispAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.Http.RequestDelegateGenerator'" />
      <Analyzer Include="$(NuGetPackageRoot)/microsoft.aspnetcore.app.ref/$(WispAspNetCoreRuntimeVersion)/analyzers/dotnet/cs/Microsoft.AspNetCore.Http.RequestDelegateGenerator.dll" />
    </ItemGroup>
  </Target>
  <Target Name="WispAspNetCoreTransitiveFramework" AfterTargets="AddTransitiveFrameworkReferences">
    <ItemGroup><FrameworkReference Remove="Microsoft.AspNetCore.App" /></ItemGroup>
  </Target>
  <Import Project="../tools/Build/Wisp.Exports.targets" Condition="'$(WispManagedBundleBuild)' != 'true'" />
</Project>
