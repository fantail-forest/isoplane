<Project>
  <!-- Compiles against the Linux ASP.NET implementation assemblies, which a
       application IL package carries, in place of the shared
       framework a wasm target cannot restore. -->
  <Target Name="IsoplaneSelectAspNetCore" BeforeTargets="ProcessFrameworkReferences;ResolveAssemblyReferences;IsoplaneResolveManagedPlatform"
          Condition="'$(IsoplaneAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <_IsoplaneAspNetFramework Include="@(FrameworkReference)" Condition="'%(Identity)' == 'Microsoft.AspNetCore.App'" />
      <_IsoplaneAspNetKnownFramework Include="@(KnownFrameworkReference)" Condition="'%(Identity)' == 'Microsoft.AspNetCore.App' AND '%(TargetFramework)' == '$(TargetFramework)'" />
    </ItemGroup>
    <PropertyGroup>
      <IsoplaneAspNetCoreRuntimeVersion Condition="'$(IsoplaneAspNetCoreRuntimeVersion)' == ''">@(_IsoplaneAspNetFramework->'%(RuntimeFrameworkVersion)')</IsoplaneAspNetCoreRuntimeVersion>
      <IsoplaneAspNetCoreRuntimeVersion Condition="'$(IsoplaneAspNetCoreRuntimeVersion)' == ''">$(RuntimeFrameworkVersion)</IsoplaneAspNetCoreRuntimeVersion>
      <IsoplaneAspNetCoreRuntimeVersion Condition="'$(IsoplaneAspNetCoreRuntimeVersion)' == ''">@(_IsoplaneAspNetKnownFramework->'%(LatestRuntimeFrameworkVersion)')</IsoplaneAspNetCoreRuntimeVersion>
    </PropertyGroup>
  </Target>
  <Target Name="IsoplaneAspNetCoreDownloads" BeforeTargets="CollectPackageDownloads" DependsOnTargets="IsoplaneSelectAspNetCore"
          Condition="'$(IsoplaneAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <PackageDownload Remove="Microsoft.AspNetCore.App.Runtime.linux-x64;Microsoft.AspNetCore.App.Ref" />
      <PackageDownload Include="Microsoft.AspNetCore.App.Runtime.linux-x64;Microsoft.AspNetCore.App.Ref" Version="[$(IsoplaneAspNetCoreRuntimeVersion)]" />
    </ItemGroup>
  </Target>
  <Target Name="IsoplaneAspNetCoreFrameworkReferences" BeforeTargets="ProcessFrameworkReferences" DependsOnTargets="IsoplaneSelectAspNetCore">
    <ItemGroup><FrameworkReference Remove="Microsoft.AspNetCore.App" /></ItemGroup>
  </Target>
  <!-- The SDK names the packages a framework already provides, for restore to leave out, from the
       project's framework references. ASP.NET is no longer among them by then, so its packages are
       named here. Without them a dependency's older copy of a framework assembly is restored and
       chosen over the framework's own. -->
  <Target Name="IsoplaneAspNetCorePrunePackages" DependsOnTargets="AddPrunePackageReferences" BeforeTargets="CollectPrunePackageReferences"
          Condition="'$(IsoplaneAspNetCoreProvidedAssemblies)' != 'true' AND ('$(RestoreEnablePackagePruning)' == 'true' OR '$(RestoreEnablePackagePruning)' == '')">
    <ItemGroup>
      <_IsoplanePrunedFramework Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <GetPackagesToPrune TargetFrameworkIdentifier="$(TargetFrameworkIdentifier)"
                        TargetFrameworkVersion="$(_TargetFrameworkVersionWithoutV)"
                        FrameworkReferences="@(_IsoplanePrunedFramework)"
                        TargetingPacks="@(TargetingPack)"
                        TargetingPackRoots="$(PrunePackageTargetingPackRoots)"
                        PrunePackageDataRoot="$(PrunePackageDataRoot)"
                        AllowMissingPrunePackageData="$(AllowMissingPrunePackageData)">
      <Output TaskParameter="PackagesToPrune" ItemName="_IsoplanePrunePackageReference" />
    </GetPackagesToPrune>
    <ItemGroup>
      <PrunePackageReference Include="@(_IsoplanePrunePackageReference)" Exclude="@(PrunePackageReference)" />
    </ItemGroup>
  </Target>
  <Target Name="IsoplaneAspNetCoreFrameworkAssemblies" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="IsoplaneSelectAspNetCore;ResolvePackageAssets" Condition="'$(IsoplaneAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <_IsoplaneAspNetAssembly Include="$(NuGetPackageRoot)/microsoft.aspnetcore.app.runtime.linux-x64/$(IsoplaneAspNetCoreRuntimeVersion)/runtimes/linux-x64/lib/net10.0/*.dll" />
    </ItemGroup>
    <Error Condition="'@(_IsoplaneAspNetAssembly)' == ''" Text="isoplane: selected managed ASP.NET implementation pack missing; restore the project before publishing." />
    <ItemGroup>
      <_IsoplaneAspNetAssembly Remove="@(ResolvedCompileFileDefinitions)" MatchOnMetadata="Filename;Extension" MatchOnMetadataOptions="CaseInsensitive" />
      <!-- Compiled against, and packaged from the pack by the bundle; not copied beside the application.
           These images are built for linux-x64, so .NET tools that run the entry point on another
           platform could not load a copy. -->
      <Reference Include="@(_IsoplaneAspNetAssembly)" Private="false" />
    </ItemGroup>
  </Target>
  <!-- .NET tools that run the entry point on the developer's machine, such as dotnet ef, take
       ASP.NET from the installed shared framework. Any 10.0 patch serves them. -->
  <Target Name="IsoplaneAspNetCoreToolingFramework" BeforeTargets="GenerateBuildRuntimeConfigurationFiles"
          Condition="'$(IsoplaneAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <RuntimeFramework Include="Microsoft.AspNetCore.App" FrameworkName="Microsoft.AspNetCore.App" Version="10.0.0" />
    </ItemGroup>
  </Target>
  <Target Name="IsoplaneAspNetCoreGenerator" BeforeTargets="CoreCompile" DependsOnTargets="IsoplaneSelectAspNetCore"
          Condition="'$(IsoplaneAspNetCoreProvidedAssemblies)' != 'true'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.Http.RequestDelegateGenerator'" />
      <!-- The analyzers and generators the removed framework reference would have supplied.
           One a package already supplies, such as the logging generator, is not added twice. -->
      <_IsoplaneAspNetAnalyzer Include="$(NuGetPackageRoot)/microsoft.aspnetcore.app.ref/$(IsoplaneAspNetCoreRuntimeVersion)/analyzers/dotnet/cs/*.dll" />
      <_IsoplaneAspNetAnalyzer Remove="@(Analyzer)" MatchOnMetadata="Filename" MatchOnMetadataOptions="CaseInsensitive" />
      <!-- As with a framework reference, these two run only where the project enables them. -->
      <_IsoplaneAspNetAnalyzer Remove="@(_IsoplaneAspNetAnalyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.Http.RequestDelegateGenerator' AND '$(EnableRequestDelegateGenerator)' != 'true'" />
      <_IsoplaneAspNetAnalyzer Remove="@(_IsoplaneAspNetAnalyzer)" Condition="'%(Filename)' == 'Microsoft.Extensions.Configuration.Binder.SourceGeneration' AND '$(EnableConfigurationBindingGenerator)' != 'true'" />
      <Analyzer Include="@(_IsoplaneAspNetAnalyzer)" />
    </ItemGroup>
  </Target>
  <Target Name="IsoplaneAspNetCoreTransitiveFramework" AfterTargets="AddTransitiveFrameworkReferences">
    <ItemGroup><FrameworkReference Remove="Microsoft.AspNetCore.App" /></ItemGroup>
  </Target>
</Project>
