<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <Import Project="../buildTransitive/Wisp.AspNetCore.props" Condition="'$(_WispAspNetCorePropsImported)' != 'true'" />
  <ItemGroup>
    <PackageReference Include="Wisp.AspNetCore" Version="0.1.0" />
  </ItemGroup>
</Project>
