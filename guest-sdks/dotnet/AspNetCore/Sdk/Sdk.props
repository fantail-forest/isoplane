<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <Import Project="../buildTransitive/Isoplane.AspNetCore.props" Condition="'$(_IsoplaneAspNetCorePropsImported)' != 'true'" />
  <ItemGroup>
    <PackageReference Include="Isoplane.AspNetCore" Version="0.1.0-preview.1" />
  </ItemGroup>
</Project>
