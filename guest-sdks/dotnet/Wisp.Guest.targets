<!--
  The targets every C# WISP guest imports after the .NET SDK's own, so that
  targets which replace a workload target (the Mono toolchain setup) are the
  last definition MSBuild sees. Wisp.Guest.props selects the runtime; this
  file completes the pipeline it selected.
-->
<Project>
  <!-- The Mono pipeline is the source-built Wasi SDK pack the feed names,
       between the workload's Mono targets, in the order the workload itself
       would import them. -->
  <ImportGroup Condition="'$(WispGuestRuntime)' == 'Mono'">
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Runtime.MonoTargets.Sdk.net10" />
    <!-- A missing feed is reported by Wisp.Guest.props' WispRequireGuestRuntimeFeed. -->
    <Import Project="$(WispGuestWasiSdkPackDirectory)Sdk/Sdk.props" Condition="Exists('$(WispGuestWasiSdkPackDirectory)Sdk/Sdk.props')" />
    <Import Project="$(WispGuestWasiSdkPackDirectory)Sdk/Sdk.targets" Condition="Exists('$(WispGuestWasiSdkPackDirectory)Sdk/Sdk.targets')" />
    <!-- The workload's Mono AOT cross compiler prints the interpreter's icall
         table; the source-built runtime does not change that table, and the
         source build does not yet produce the cross compiler pack. -->
    <Import Project="Sdk.props" Sdk="Microsoft.NETCore.App.Runtime.AOT.Cross.net10.wasi-wasm" />
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Runtime.MonoTargets.Sdk.net10" />
    <Import Project="Build/Wisp.Mono.targets" />
  </ImportGroup>
</Project>
