<Project>
  <PropertyGroup>
    <WispGuestRuntimeFeed Condition="'$(WispGuestRuntimeFeed)' == '' AND '$(WISP_GUEST_RUNTIME_FEED)' != ''">$([MSBuild]::EnsureTrailingSlash('$(WISP_GUEST_RUNTIME_FEED)'))</WispGuestRuntimeFeed>
    <WispCli Condition="'$(WispCli)' == '' AND '$(WISP_CLI)' != ''">$(WISP_CLI)</WispCli>
    <_WispToolchainHome Condition="'$(ISOPLANE_HOME)' != ''">$(ISOPLANE_HOME)</_WispToolchainHome>
    <_WispToolchainHome Condition="'$(_WispToolchainHome)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.isoplane</_WispToolchainHome>
  </PropertyGroup>
  <Import Project="$(_WispToolchainHome)/toolchain.props" Condition="Exists('$(_WispToolchainHome)/toolchain.props')" />
  <PropertyGroup>
    <WispGuestRuntime Condition="'$(WispGuestRuntime)' == ''">NativeAOT</WispGuestRuntime>
    <WispMemoryMaxBytes Condition="'$(WispMemoryMaxBytes)' == ''">134217728</WispMemoryMaxBytes>
    <_WispSdkDirectory>$(MSBuildThisFileDirectory)</_WispSdkDirectory>
    <!-- Both profiles run the WISP guest runtime built from source by
         guest-runtime/build.sh: the Mono runtime pack and the NativeAOT
         framework pack, published to a local feed with a props file naming
         each pack's version and digest. A project outside this checkout
         names its feed with WispGuestRuntimeFeed or WISP_GUEST_RUNTIME_FEED;
         a published feed replaces this path later. -->
    <WispGuestRuntimeFeed Condition="'$(WispGuestRuntimeFeed)' == ''">$([MSBuild]::NormalizeDirectory('$(_WispSdkDirectory)', '..', '..', 'guest-runtime', 'out', 'feed'))</WispGuestRuntimeFeed>
    <_WispGuestRuntimeFeedDirectory>$([MSBuild]::EnsureTrailingSlash('$(WispGuestRuntimeFeed)'))</_WispGuestRuntimeFeedDirectory>
  </PropertyGroup>
  <Import Project="$(_WispGuestRuntimeFeedDirectory)Wisp.GuestRuntime.props" Condition="Exists('$(_WispGuestRuntimeFeedDirectory)Wisp.GuestRuntime.props')" />
  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(WispGuestRuntimeFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <!-- The libc and System.Native symbols the link wraps: the PAL objects
         answer the socket and file calls through the host interface, and the
         runtime pack's System.Native observes a socket's pollables through
         libc's poll and recovers the network error code libc drops from a
         failed stream operation. -->
    <WispWrappedSymbol Include="SystemNative_MksTemps;SystemNative_SetLingerOption;socket;close;connect;getsockopt;setsockopt;send;sendmsg" />
    <WispWrappedSymbol Include="poll_poll;streams_method_input_stream_read;streams_method_output_stream_check_write;streams_method_output_stream_write" />
  </ItemGroup>
  <ItemGroup>
    <!-- HttpClient runs SocketsHttpHandler over the delegated sockets:
         HTTP/1.1 and HTTP/2 (h2 through the guest's own TLS with ALPN, h2c
         with prior knowledge). HTTP/3 needs QUIC over UDP, which the host
         interface does not carry. -->
    <RuntimeHostConfigurationOption Include="System.Net.SocketsHttpHandler.Http3Support" Value="false" Trim="true" />
  </ItemGroup>
  <Import Project="Wisp.NativeAot.props" Condition="'$(WispGuestRuntime)' == 'NativeAOT'" />
  <Import Project="Build/Wisp.Mono.props" Condition="'$(WispGuestRuntime)' == 'Mono'" />
  <Target Name="WispValidateRuntimeProfile" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(TargetFramework)' != 'net10.0'" Text="This WISP SDK requires TargetFramework=net10.0." />
    <Error Condition="'$(WispContainerBuild)' != 'true' AND '$(RuntimeIdentifier)' != 'wasi-wasm'" Text="WISP applications require RuntimeIdentifier=wasi-wasm." />
    <Error Condition="'$(WispLocalDebug)' == 'true' AND '$(WispGuestRuntime)' != 'Mono'" Text="Local debugging requires an interpreted project configuration (PublishAot=false)." />
    <Error Condition="'$(WispGuestRuntime)' != 'NativeAOT' AND '$(WispGuestRuntime)' != 'Mono'"
           Text="The project selected an unsupported guest runtime; choose an interpreted or NativeAOT project configuration." />
  </Target>
  <Target Name="WispRequireGuestRuntimeFeed" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(WispGuestRuntimePackVersion)' == '' OR '$(WispGuestNativeAotPackVersion)' == ''"
           Text="wisp: the guest runtime feed at $(WispGuestRuntimeFeed) has no Wisp.GuestRuntime.props naming both packs; run isoplane setup with the supplied toolchain bundle, then isoplane doctor." />
  </Target>
</Project>
