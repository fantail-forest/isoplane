<Project>
  <PropertyGroup>
    <WispGuestRuntime Condition="'$(WispGuestRuntime)' == ''">NativeAOT</WispGuestRuntime>
    <WispManagedRuntimeVersion>10.0.11</WispManagedRuntimeVersion>
    <WispMemoryMaxBytes Condition="'$(WispMemoryMaxBytes)' == ''">134217728</WispMemoryMaxBytes>
  </PropertyGroup>
  <Import Project="Wisp.NativeAot.props" Condition="'$(WispGuestRuntime)' == 'NativeAOT'" />
  <Import Project="Build/Wisp.Mono.props" Condition="'$(WispGuestRuntime)' == 'Mono'" />
  <Target Name="WispValidateRuntimeProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WispLocalDebug)' == 'true' AND '$(WispGuestRuntime)' != 'Mono'" Text="Local debugging requires WispGuestRuntime=Mono." />
    <Error Condition="'$(WispGuestRuntime)' != 'NativeAOT' AND '$(WispGuestRuntime)' != 'Mono'"
           Text="WispGuestRuntime must be NativeAOT or Mono." />
  </Target>
</Project>
