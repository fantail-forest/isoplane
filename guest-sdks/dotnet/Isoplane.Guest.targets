<!--
  The targets every C# Isoplane guest imports after the .NET SDK's own, so that
  targets which replace a workload target (the Mono toolchain setup) are the
  last definition MSBuild sees. Isoplane.Guest.props selects the runtime; this
  file completes the pipeline it selected.
-->
<Project>
  <Target Name="IsoplaneSelectRuntimePack" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(IsoplaneGuestRuntimePackVersion)" />
    </ItemGroup>
  </Target>
  <Import Project="Build/Isoplane.NativeAot.PackageResolution.targets" Condition="'$(IsoplaneGuestRuntime)' == 'NativeAOT'" />
  <!-- The Mono pipeline is the source-built Wasi SDK pack the feed names,
       between the workload's Mono targets, in the order the workload itself
       would import them. -->
  <ImportGroup Condition="'$(IsoplaneGuestRuntime)' == 'Mono'">
    <Import Project="Sdk.props" Sdk="Isoplane.MonoTargets" Condition="'$(IsoplaneWorkloadInstalled)' == 'true'" />
    <Import Project="$(IsoplaneMonoTargetsDirectory)Sdk.props" Condition="'$(IsoplaneMonoTargetsDirectory)' != ''" />
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Runtime.MonoTargets.Sdk.net10" Condition="'$(IsoplaneWorkloadInstalled)' != 'true' AND '$(IsoplaneMonoTargetsDirectory)' == '' AND '$(_IsoplaneWindowsSdk)' == ''" />
    <!-- A missing feed is reported by Isoplane.Guest.props' IsoplaneRequireGuestRuntimeFeed. -->
    <Import Project="$(IsoplaneGuestWasiSdkPackDirectory)Sdk/Sdk.props" Condition="Exists('$(IsoplaneGuestWasiSdkPackDirectory)Sdk/Sdk.props')" />
    <Import Project="$(IsoplaneGuestWasiSdkPackDirectory)Sdk/Sdk.targets" Condition="Exists('$(IsoplaneGuestWasiSdkPackDirectory)Sdk/Sdk.targets')" />
    <!-- The workload's Mono AOT cross compiler prints the interpreter's icall
         table; the source-built runtime does not change that table, and the
         source build does not yet produce the cross compiler pack. -->
    <Import Project="Sdk.props" Sdk="Isoplane.Wasi.Cross" Condition="'$(IsoplaneWorkloadInstalled)' == 'true'" />
    <Import Project="$(IsoplaneWasiCrossDirectory)Sdk.props" Condition="'$(IsoplaneWasiCrossDirectory)' != ''" />
    <Import Project="Sdk.props" Sdk="Microsoft.NETCore.App.Runtime.AOT.Cross.net10.wasi-wasm" Condition="'$(IsoplaneWorkloadInstalled)' != 'true' AND '$(IsoplaneWasiCrossDirectory)' == '' AND '$(_IsoplaneWindowsSdk)' == ''" />
    <Import Project="Sdk.targets" Sdk="Isoplane.MonoTargets" Condition="'$(IsoplaneWorkloadInstalled)' == 'true'" />
    <Import Project="$(IsoplaneMonoTargetsDirectory)Sdk.targets" Condition="'$(IsoplaneMonoTargetsDirectory)' != ''" />
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Runtime.MonoTargets.Sdk.net10" Condition="'$(IsoplaneWorkloadInstalled)' != 'true' AND '$(IsoplaneMonoTargetsDirectory)' == '' AND '$(_IsoplaneWindowsSdk)' == ''" />
    <Import Project="Build/Isoplane.Mono.targets" />
  </ImportGroup>
</Project>
