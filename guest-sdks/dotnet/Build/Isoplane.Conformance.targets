<Project>
  <PropertyGroup>
    <IsoplaneAnalyzeDependencies Condition="'$(IsoplaneAnalyzeDependencies)' == ''">false</IsoplaneAnalyzeDependencies>
    <IsoplaneWarnOnNativeImports Condition="'$(IsoplaneWarnOnNativeImports)' == ''">false</IsoplaneWarnOnNativeImports>
  </PropertyGroup>
  <UsingTask TaskName="Isoplane.Conformance.InspectManagedAssemblies"
             AssemblyFile="$(MSBuildThisFileDirectory)../Conformance/Isoplane.Conformance.dll" />
  <Target Name="IsoplaneInspectManagedAssemblies" AfterTargets="CoreCompile" DependsOnTargets="IsoplaneResolveManagedPlatform"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(WasmBuildingForNestedPublish)' != 'true'">
    <ItemGroup>
      <_IsoplaneConformanceApplication Include="@(IntermediateAssembly)" />
      <_IsoplaneConformanceApplication Include="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' OR '%(ReferenceCopyLocalPaths.MSBuildSourceProjectFile)' != ''" />
      <_IsoplaneConformanceAssembly Include="@(IntermediateAssembly)" />
      <_IsoplaneConformanceAssembly Include="@(ReferenceCopyLocalPaths)"
                                Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' AND '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Isoplane.Sdk' AND '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Isoplane.AspNetCore'" />
      <_IsoplaneConformanceAssembly Remove="@(IsoplaneBundlePlatformReference)" MatchOnMetadata="Filename;Extension" MatchOnMetadataOptions="CaseInsensitive" />
      <_IsoplaneConformanceAssembly Remove="@(RuntimePackAsset)" />
    </ItemGroup>
    <Isoplane.Conformance.InspectManagedAssemblies Assemblies="@(_IsoplaneConformanceAssembly)"
        ApplicationAssemblies="@(_IsoplaneConformanceApplication)"
        EntryAssembly="@(IntermediateAssembly)"
        AnalyzeDependencies="$(IsoplaneAnalyzeDependencies)" WarnOnNativeImports="$(IsoplaneWarnOnNativeImports)"
        NoWarn="$(NoWarn)" WarningsAsErrors="$(WarningsAsErrors)"
        WarningsNotAsErrors="$(WarningsNotAsErrors)" TreatWarningsAsErrors="$([MSBuild]::ValueOrDefault('$(TreatWarningsAsErrors)', 'false'))" />
  </Target>
</Project>
