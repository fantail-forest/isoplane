<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">wasi-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <WasmSingleFileBundle>true</WasmSingleFileBundle>
    <WasmBuildNative>true</WasmBuildNative>
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">false</InvariantGlobalization>
    <WasmIncludeFullIcuData Condition="'$(WasmIncludeFullIcuData)' == ''">true</WasmIncludeFullIcuData>
    <WasmEnableExceptionHandling>false</WasmEnableExceptionHandling>
    <MSBuildEnableWorkloadResolver>true</MSBuildEnableWorkloadResolver>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <DefineConstants>$(DefineConstants);WISP_MONO</DefineConstants>
    <WASI_SDK_PATH Condition="'$(WASI_SDK_PATH)' == ''">/opt/wasi-sdk</WASI_SDK_PATH>
    <!-- The interpreter runs the feed's Mono runtime pack. The build
         pipeline (WasiApp.targets) comes from the Wasi SDK pack built beside
         it, imported by Wisp.Guest.targets, not from the installed
         workload's copy, whose link flags belong to its own runtime pack. -->
    <UsingWasiRuntimeWorkload>false</UsingWasiRuntimeWorkload>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WispLocalDebug)' == 'true'">
    <WasmDebugLevel>1</WasmDebugLevel>
    <DebuggerSupport>true</DebuggerSupport>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>
</Project>
