<Project>
  <Target Name="IsoplaneResolveManagedPlatform">
    <ItemGroup>
      <_IsoplaneBundleAspNetReference Include="$(NuGetPackageRoot)/microsoft.aspnetcore.app.runtime.linux-x64/$(IsoplaneAspNetCoreRuntimeVersion)/runtimes/linux-x64/lib/net10.0/*.dll" Condition="'$(IsoplaneAspNetCoreRuntimeVersion)' != ''" />
      <!-- The runtime binds its SDK assemblies by name, however the project referenced them. -->
      <IsoplaneBundlePlatformReference Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App' OR '%(ReferencePath.Filename)' == 'Isoplane.Sdk' OR '%(ReferencePath.Filename)' == 'Isoplane.AspNetCore'" />
      <_IsoplaneSdkReference Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'Isoplane.Sdk'" />
    </ItemGroup>
    <!-- The runtimes ship in the Isoplane.Sdk package the application compiled
         against, so the two always match. -->
    <PropertyGroup>
      <_IsoplaneSdkLibrary>@(_IsoplaneSdkReference->'%(RootDir)%(Directory)')</_IsoplaneSdkLibrary>
      <IsoplaneRuntimeDirectory Condition="'$(IsoplaneRuntimeDirectory)' == ''">$(ISOPLANE_RUNTIME_DIRECTORY)</IsoplaneRuntimeDirectory>
      <IsoplaneRuntimeDirectory Condition="'$(IsoplaneRuntimeDirectory)' == '' AND '$(_IsoplaneSdkLibrary)' != ''">$([System.IO.Path]::GetFullPath('$(_IsoplaneSdkLibrary)../../tools/runtime/'))</IsoplaneRuntimeDirectory>
    </PropertyGroup>
  </Target>
  <Target Name="IsoplaneManagedBundle" DependsOnTargets="Build;IsoplaneResolveManagedPlatform">
    <Error Condition="'$(IsoplaneManagedBundleBuild)' != 'true'" Text="Use isoplane bundle to build managed deployment input." />
    <Error Condition="'$(IsoplaneApplicationFactory)' == ''" Text="Set IsoplaneApplicationFactory to the application's public static factory method." />
    <ItemGroup>
      <IsoplaneBundleAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' AND '%(ReferenceCopyLocalPaths.Filename)' != 'Isoplane.Sdk' AND '%(ReferenceCopyLocalPaths.Filename)' != 'Isoplane.AspNetCore'" />
      <_IsoplaneBundleAspNetReference Remove="@(IsoplaneBundleAssembly)" MatchOnMetadata="Filename;Extension" MatchOnMetadataOptions="CaseInsensitive" />
      <IsoplaneBundleAssembly Include="@(_IsoplaneBundleAspNetReference)" />
      <IsoplaneBundleAssembly Remove="@(IsoplaneBundlePlatformReference)" MatchOnMetadata="Filename;Extension" MatchOnMetadataOptions="CaseInsensitive" />
      <IsoplaneBundleAssembly Remove="@(RuntimePackAsset)" />
      <IsoplaneBundleAssembly Include="$(TargetPath);@(IntermediateSatelliteAssembliesWithTargetPath)" />
      <_IsoplaneBundleSymbol Include="@(IsoplaneBundleAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <IsoplaneBundleSymbol Include="@(_IsoplaneBundleSymbol)" Condition="Exists('%(_IsoplaneBundleSymbol.Identity)')" />
      <IsoplaneBundleAsset Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' != '.dll' AND '%(Extension)' != '.pdb' AND '%(Extension)' != '.xml'" />
      <IsoplaneBundleAsset Remove="@(RuntimePackAsset)" />
      <IsoplaneBundleAsset Include="@(_NoneWithTargetPath)" Condition="'%(_NoneWithTargetPath.CopyToPublishDirectory)' != 'Never' AND (('%(_NoneWithTargetPath.CopyToOutputDirectory)' != '' AND '%(_NoneWithTargetPath.CopyToOutputDirectory)' != 'Never') OR '%(_NoneWithTargetPath.CopyToPublishDirectory)' != '')" />
      <IsoplaneBundleAsset Include="@(ContentWithTargetPath)" Condition="'%(ContentWithTargetPath.CopyToPublishDirectory)' != 'Never' AND (('%(ContentWithTargetPath.CopyToOutputDirectory)' != '' AND '%(ContentWithTargetPath.CopyToOutputDirectory)' != 'Never') OR ('%(ContentWithTargetPath.CopyToPublishDirectory)' != '' AND '%(ContentWithTargetPath.CopyToPublishDirectory)' != 'Never'))" />
      <IsoplaneBundleAsset Remove="NuGet.Config;nuget.config;$(MSBuildProjectDirectory)/NuGet.Config;$(MSBuildProjectDirectory)/nuget.config" />
    </ItemGroup>
  </Target>
</Project>
