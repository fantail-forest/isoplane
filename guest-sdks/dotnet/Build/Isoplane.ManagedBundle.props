<Project>
  <!-- An interpreted application builds as a package for the SDK's shared
       runtime. A local debug session still publishes its own module. -->
  <PropertyGroup>
    <IsoplaneManagedBundleBuild Condition="'$(IsoplaneManagedBundleBuild)' == '' AND '$(IsoplaneGuestRuntime)' == 'Mono' AND '$(IsoplaneLocalDebug)' != 'true'">true</IsoplaneManagedBundleBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsoplaneManagedBundleBuild)' == 'true'">
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/managed-bundle/</IntermediateOutputPath>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">bin/</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)/managed-bundle/</OutputPath>
  </PropertyGroup>
</Project>
