<Project>
  <PropertyGroup>
    <IsoplaneManagedBundleBuild>true</IsoplaneManagedBundleBuild>
    <OutputType>Library</OutputType>
    <UseAppHost>false</UseAppHost>
    <!-- An executable for wasi-wasm would otherwise have an installed wasi workload link it a runtime. -->
    <UsingWasiRuntimeWorkload>false</UsingWasiRuntimeWorkload>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- An application package carries each static web asset once, as built. The build would
         otherwise also describe compressed copies that only a publish lays out beside them. -->
    <CompressionEnabled Condition="'$(CompressionEnabled)' == ''">false</CompressionEnabled>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/managed-bundle/</IntermediateOutputPath>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">bin/</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)/managed-bundle/</OutputPath>
  </PropertyGroup>
  <Target Name="IsoplaneValidateApplication" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(TargetFramework)' != 'net10.0'" Text="This Isoplane SDK requires TargetFramework=net10.0." />
  </Target>
</Project>
