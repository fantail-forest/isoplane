<Project>
  <Target Name="IsoplaneGenerateHandlerEntrypoint" BeforeTargets="CoreCompile" Condition="'$(IsoplaneManagedBundleBuild)' != 'true'">
    <Error Condition="'$(IsoplaneApplicationFactory)' == ''" Text="Set IsoplaneApplicationFactory to a public static method returning Isoplane.Durable.IIsoplaneHandler." />
    <PropertyGroup>
      <_IsoplaneHandlerPath>$(IntermediateOutputPath)Isoplane.Handler.g.cs</_IsoplaneHandlerPath>
      <_IsoplaneHandlerSource><![CDATA[
#nullable enable
internal sealed class IsoplaneGeneratedRouter() : Isoplane.Durable.HandlerFactoryRouter(global::$(IsoplaneApplicationFactory));
]]></_IsoplaneHandlerSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(_IsoplaneHandlerPath)" Lines="$([MSBuild]::Escape($(_IsoplaneHandlerSource)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(_IsoplaneHandlerPath)" IsoplaneRuntimeSource="true" /></ItemGroup>
  </Target>
</Project>
