<Project>
  <Import Project="Wisp.NativeExports.targets" Condition="'$(WispGuestRuntime)' != 'Mono'" />
  <Target Name="WispNativeAotExportBindings" BeforeTargets="WriteIlcRspFileForCompilation"
          DependsOnTargets="WispNativeAotVerifyCommonPack;SetupOSSpecificProps;WispNativeAotLinkShims;WispCompilePal;SelectNativeLibrariesForWasmLink"
          Condition="'$(WispContainerBuild)' != 'true'">
    <PropertyGroup>
      <_WispAotExports>$(NativeIntermediateOutputPath)native-exports.txt</_WispAotExports>
      <_WispAotDirect>$(NativeIntermediateOutputPath)direct-pinvokes.txt</_WispAotDirect>
    </PropertyGroup>
    <ItemGroup>
      <_WispAotNativeExportInput Include="@(NativeLibrary)" Condition="'%(Extension)' == '.a' OR '%(Extension)' == '.o'">
        <Library Condition="'%(NativeLibrary.Library)' == ''">%(NativeLibrary.Filename)</Library>
      </_WispAotNativeExportInput>
    </ItemGroup>
    <Wisp.Conformance.NativeExports Tool="$(_NativeWasmSdkBinPath)llvm-nm$(_HostToolExeExt)"
        Inputs="@(_WispAotNativeExportInput)" SymbolsFile="$(_WispAotExports)" DirectPInvokeFile="$(_WispAotDirect)"
        Compiler="$(_NativeWasmSdkBinPath)clang$(_HostToolExeExt)" TargetTriple="$(IlcLlvmTarget)"
        SystemLibraries="libc.a" IncludeCompilerBuiltins="true">
      <Output TaskParameter="ResolvedLibraries" ItemName="NativeLibrary" />
    </Wisp.Conformance.NativeExports>
    <ItemGroup>
      <DirectPInvoke Remove="@(DirectPInvoke)" />
      <DirectPInvokeList Include="$(_WispAotDirect)" />
      <LinkerArg Include="-Wl,--error-unresolved-symbols" />
      <FileWrites Include="$(_WispAotExports);$(_WispAotDirect)" />
    </ItemGroup>
  </Target>
  <Target Name="WispNativeAotVerifyCommonPack" BeforeTargets="IlcCompile" Condition="'$(WispContainerBuild)' != 'true'">
    <Error Condition="'$(ILCompilerVersion)' != '$(WispGuestNativeAotSdkPackVersion)'"
           Text="The NativeAOT targets version must match the supplied toolchain. Remove the ILCompilerVersion override." />
    <PropertyGroup>
      <_WispCommonPackDirectory>$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', 'microsoft.dotnet.ilcompiler.llvm', '$(WispGuestNativeAotSdkPackVersion)'))</_WispCommonPackDirectory>
      <_WispCommonPackDigestFile>$(_WispCommonPackDirectory)microsoft.dotnet.ilcompiler.llvm.$(WispGuestNativeAotSdkPackVersion.ToLowerInvariant()).nupkg.sha512</_WispCommonPackDigestFile>
    </PropertyGroup>
    <Error Condition="'$(WispGuestNativeAotSdkPackVersion)' == '' OR !Exists('$(_WispCommonPackDigestFile)')"
           Text="The source-built NativeAOT targets package is missing. Run isoplane setup with the matching toolchain and restore the project." />
    <ReadLinesFromFile File="$(_WispCommonPackDigestFile)">
      <Output TaskParameter="Lines" PropertyName="_WispCommonPackDigest" />
    </ReadLinesFromFile>
    <Error Condition="'$(_WispCommonPackDigest)' != '$(WispGuestNativeAotSdkPackSha512)'"
           Text="The NativeAOT targets package differs from the supplied toolchain. Restore the matching package before building." />
  </Target>
  <!-- Teach the SDK which compiler handles WASI; its bundled compiler does not. -->
  <Target Name="WispSelectLlvmCompiler" BeforeTargets="ProcessFrameworkReferences" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_WispCompilerPlatform Include="@(KnownILCompilerPack)" Condition="'%(TargetFramework)' == '$(TargetFramework)'" />
      <KnownILCompilerPack Remove="@(_WispCompilerPlatform)" />
      <KnownILCompilerPack Include="Microsoft.DotNet.ILCompiler.LLVM">
        <TargetFramework>$(TargetFramework)</TargetFramework>
        <ILCompilerPackNamePattern>runtime.**RID**.Microsoft.DotNet.ILCompiler.LLVM</ILCompilerPackNamePattern>
        <ILCompilerPackVersion>$(ILCompilerVersion)</ILCompilerPackVersion>
        <ILCompilerRuntimeIdentifiers>@(_WispCompilerPlatform->'%(ILCompilerRuntimeIdentifiers)');wasi-wasm</ILCompilerRuntimeIdentifiers>
        <ILCompilerPortableRuntimeIdentifiers>@(_WispCompilerPlatform->'%(ILCompilerPortableRuntimeIdentifiers)')</ILCompilerPortableRuntimeIdentifiers>
      </KnownILCompilerPack>
    </ItemGroup>
  </Target>
  <!-- Explicit references above resolve the separately versioned host and guest packs. -->
  <Target Name="WispUseExplicitCompilerPacks" AfterTargets="ProcessFrameworkReferences" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <PackageDownload Remove="runtime.$(NETCoreSdkRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM;runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM;runtime.wasi-wasm.Microsoft.DotNet.ILCompiler.LLVM" />
    </ItemGroup>
  </Target>
  <!-- The pack the compile draws on must be the pack the feed offers: NuGet
       keeps one extraction per version, so a stale copy could shadow a
       republished pack. The compiler's targets name the directory they
       resolved. -->
  <Target Name="WispNativeAotVerifyFrameworkPack" DependsOnTargets="WispResolveNativeAotPackages" BeforeTargets="IlcCompile"
          Condition="'$(WispContainerBuild)' != 'true'">
    <Error Condition="'$(RuntimePackagePath)' == ''"
           Text="wisp: the compiler resolved no framework pack; expected the feed's runtime.wasi-wasm.Microsoft.DotNet.ILCompiler.LLVM $(WispGuestNativeAotPackVersion)." />
    <PropertyGroup>
      <_WispNativeAotPackDirectory>$([MSBuild]::NormalizeDirectory('$(RuntimePackagePath)'))</_WispNativeAotPackDirectory>
      <_WispNativeAotPackDigestFile>$(_WispNativeAotPackDirectory)runtime.wasi-wasm.microsoft.dotnet.ilcompiler.llvm.$(WispGuestNativeAotPackVersion.ToLowerInvariant()).nupkg.sha512</_WispNativeAotPackDigestFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WispNativeAotPackDigestFile)')"
           Text="wisp: the framework pack at $(_WispNativeAotPackDirectory) records no package digest ($(_WispNativeAotPackDigestFile)); it is not a NuGet extraction of the feed's pack $(WispGuestNativeAotPackVersion)." />
    <ReadLinesFromFile File="$(_WispNativeAotPackDigestFile)">
      <Output TaskParameter="Lines" PropertyName="_WispNativeAotPackDigest" />
    </ReadLinesFromFile>
    <Error Condition="'$(_WispNativeAotPackDigest)' != '$(WispGuestNativeAotPackSha512)'"
           Text="wisp: the framework pack at $(_WispNativeAotPackDirectory) is not the pack the feed offers (digest $(_WispNativeAotPackDigest) vs $(WispGuestNativeAotPackSha512)); delete that directory or republish the feed with guest-runtime/build.sh feed." />
  </Target>
  <Target Name="WispNativeAotVerifyCompiler" DependsOnTargets="WispResolveNativeAotPackages;WispRequireGuestCompiler" BeforeTargets="IlcCompile"
          Condition="'$(WispContainerBuild)' != 'true'">
    <PropertyGroup>
      <_WispCompilerDigestFile>$([MSBuild]::NormalizeDirectory('$(IlcHostPackagePath)'))runtime.$(NETCoreSdkRuntimeIdentifier).microsoft.dotnet.ilcompiler.llvm.$(WispGuestCompilerVersion.ToLowerInvariant()).nupkg.sha512</_WispCompilerDigestFile>
    </PropertyGroup>
    <Error Condition="'$(IlcHostPackagePath)' == '' OR !Exists('$(_WispCompilerDigestFile)')" Text="The resolved NativeAOT compiler has no verified package identity. Run isoplane setup and restore the project." />
    <ReadLinesFromFile File="$(_WispCompilerDigestFile)">
      <Output TaskParameter="Lines" PropertyName="_WispCompilerDigest" />
    </ReadLinesFromFile>
    <Error Condition="'$(_WispCompilerDigest)' != '$(WispGuestCompilerSha512)'" Text="The resolved NativeAOT compiler differs from the supplied toolchain. Restore the matching compiler package before building." />
  </Target>
  <!-- The native shims from the pack, each after the shim that calls it:
       OpenSSL behind the cryptography shim, zlib behind the compression one. -->
  <Target Name="WispNativeAotLinkShims" DependsOnTargets="SetupProperties" BeforeTargets="WispPalInputs;LinkNativeLlvm"
          Condition="'$(WispContainerBuild)' != 'true'">
    <ItemGroup>
      <NativeLibrary Include="$(IlcFrameworkNativePath)libSystem.Security.Cryptography.Native.OpenSsl.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libssl.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libcrypto.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libSystem.IO.Compression.Native.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libz.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libbrotlienc.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libbrotlidec.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libbrotlicommon.a" />
    </ItemGroup>
  </Target>
  <!-- The identity of the framework the module was compiled against, beside
       it, so a test result is attributable to those bytes. -->
  <Target Name="WispNativeAotRecordFramework" AfterTargets="CopyNativeBinary" DependsOnTargets="WispNativeAotVerifyFrameworkPack"
          Condition="'$(WispContainerBuild)' != 'true'">
    <WriteLinesToFile File="$(PublishDir)$([System.IO.Path]::GetFileName('$(NativeBinary)')).runtime"
                      Lines="$(WispGuestNativeAotPackVersion)@sha512:$(WispGuestNativeAotPackSha512)" Overwrite="true" />
  </Target>
</Project>
