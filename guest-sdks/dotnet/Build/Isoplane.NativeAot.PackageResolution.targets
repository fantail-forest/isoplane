<Project>
  <!-- The host backend and patched framework have independent package versions.
       The selected toolchain pins their exact digests; equality of NuGet labels
       cannot establish compatibility for this pair. Import after LLVM's targets
       so every compiler setup verifies the selected artifacts. -->
  <Target Name="ImportRuntimeIlcPackageTarget"
          Condition="'$(BuildingFrameworkLibrary)' != 'true' AND '$(_targetArchitecture)' == 'wasm'"
          DependsOnTargets="IsoplaneResolveNativeAotPackages;IsoplaneNativeAotVerifyFrameworkPack;IsoplaneNativeAotVerifyCompiler"
          BeforeTargets="Publish" />
  <Target Name="IsoplaneResolveNativeAotPackages" DependsOnTargets="$(ImportRuntimeIlcPackageTargetDependsOn)">
    <Error Condition="'@(PackageDefinitions)' == ''"
           Text="The NativeAOT compiler requires restored package definitions. Restore the project before building." />
    <PropertyGroup>
      <IlcHostPackagePath Condition="'%(PackageDefinitions.Name)' == '$(_hostPackageName)'">%(PackageDefinitions.ResolvedPath)</IlcHostPackagePath>
      <RuntimePackagePath Condition="'%(PackageDefinitions.Name)' == '$(_targetPackageName)'">%(PackageDefinitions.ResolvedPath)</RuntimePackagePath>
    </PropertyGroup>
  </Target>
</Project>
