<Project>
  <PropertyGroup>
    <_WispNativeTaskProject>$(MSBuildThisFileDirectory)../Conformance/Conformance.csproj</_WispNativeTaskProject>
    <_WispNativeTaskConfiguration Condition="'$(Configuration)' != ''">$(Configuration)</_WispNativeTaskConfiguration>
    <_WispNativeTaskConfiguration Condition="'$(_WispNativeTaskConfiguration)' == ''">Debug</_WispNativeTaskConfiguration>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(_WispNativeTaskProject)')">
    <ProjectReference Include="$(_WispNativeTaskProject)" ReferenceOutputAssembly="false" PrivateAssets="all"
                      AdditionalProperties="Configuration=$(_WispNativeTaskConfiguration);UseArtifactsOutput=false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;PublishAot;SelfContained;OutputPath;BaseOutputPath;BaseIntermediateOutputPath;ArtifactsPath;PublishDir;TargetFramework;TargetFrameworks" />
  </ItemGroup>
  <UsingTask TaskName="Wisp.Conformance.NativeExports" AssemblyFile="$(MSBuildThisFileDirectory)../Conformance/bin/$(_WispNativeTaskConfiguration)/net10.0/Isoplane.Conformance.dll"
             Condition="Exists('$(_WispNativeTaskProject)')" />
  <UsingTask TaskName="Wisp.Conformance.NativeExports" AssemblyFile="$(MSBuildThisFileDirectory)../Conformance/Isoplane.Conformance.dll"
             Condition="!Exists('$(_WispNativeTaskProject)')" />
</Project>
