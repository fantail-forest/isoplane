<Project>
  <!-- The workload's emitter compiles every resource whenever invoked. Keep
       its object naming and registration logic, and let MSBuild track the
       complete input inventory and the actual outputs returned by that task. -->
  <Target Name="_GenerateObjectFilesForSingleFileBundle" Returns="@(_WasmObjectFilesForBundle)"
          Condition="'$(WasmSingleFileBundle)' == 'true'"
          DependsOnTargets="WispMonoBundleInputs;WispMonoGenerateBundleObjects;WispMonoCollectBundleObjects" />

  <Target Name="WispMonoBundleInputs">
    <Error Condition="'$(_IsToolchainMissing)' == 'true'" Text="$(_ToolchainMissingErrorMessage) SDK is required for building native files." />
    <MakeDir Directories="$(_WasmIntermediateOutputPath)" />
    <PropertyGroup>
      <_WispBundleInventory>$(_WasmIntermediateOutputPath)wisp-bundle.inputs</_WispBundleInventory>
      <_WispBundleManifest>$(_WasmIntermediateOutputPath)wisp-bundle.outputs</_WispBundleManifest>
    </PropertyGroup>
    <ItemGroup>
      <_WispBundleInputs Include="@(_WasmBundleItem);@(_WasmBundleItem->'%(SymbolFile)');$(WasmClang);$(MonoTargetsTasksAssemblyPath);$(MSBuildThisFileFullPath);$([System.IO.Path]::GetDirectoryName('$(WasmClang)'))/*.cfg;$(WASI_SDK_PATH)/share/wasi-sysroot/include/**/*.h;$(WASI_SDK_PATH)/lib/clang/**/include/**/*.h" />
    </ItemGroup>
    <WriteLinesToFile File="$(_WispBundleInventory)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="@(_WispBundleInputs);@(_WasmBundleItem->'%(Identity)|%(RegisteredName)|%(Culture)|%(SymbolFile)|%(BundleFile)|%(BundleRegistrationFunctionName)');$(WispGuestRuntimePackVersion);$(WispGuestRuntimePackSha512)" />
    <ReadLinesFromFile File="$(_WispBundleManifest)" Condition="Exists('$(_WispBundleManifest)')">
      <Output TaskParameter="Lines" ItemName="_WispBundleManifestLines" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_WispBundleCompletion Include="@(_WispBundleManifestLines)" Condition="'%(Identity)' == '#wisp-bundle-complete'" />
      <_WispPreviousBundleOutputs Include="@(_WispBundleManifestLines)" Exclude="#wisp-bundle-complete" />
    </ItemGroup>
    <Delete Files="$(_WispBundleManifest)"
            Condition="'@(_WispBundleCompletion)' == '' OR ('@(_WasmBundleItem)' != '' AND '@(_WispPreviousBundleOutputs)' == '')" />
  </Target>

  <Target Name="WispMonoGenerateBundleObjects"
          Inputs="@(_WispBundleInputs);$(_WispBundleInventory)"
          Outputs="$(_WispBundleManifest);@(_WispPreviousBundleOutputs)">
    <EmitBundleObjectFiles FilesToBundle="@(_WasmBundleItem)" ClangExecutable="$(WasmClang)"
                           BundleRegistrationFunctionName="%(_WasmBundleItem.BundleRegistrationFunctionName)"
                           BundleFile="%(_WasmBundleItem.BundleFile)" OutputDirectory="$(_WasmIntermediateOutputPath)">
      <Output TaskParameter="BundledResources" ItemName="_WispBundleResources" />
      <Output TaskParameter="BundleRegistrationFile" ItemName="_WispBundleRegistrations" />
    </EmitBundleObjectFiles>
    <WriteLinesToFile File="$(_WispBundleManifest).tmp" Overwrite="true"
                      Lines="@(_WispBundleResources->'%(DestinationFile)');@(_WispBundleRegistrations);#wisp-bundle-complete" />
    <Move SourceFiles="$(_WispBundleManifest).tmp" DestinationFiles="$(_WispBundleManifest)" />
  </Target>

  <Target Name="WispMonoCollectBundleObjects">
    <ReadLinesFromFile File="$(_WispBundleManifest)">
      <Output TaskParameter="Lines" ItemName="_WasmObjectFilesForBundle" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_WasmObjectFilesForBundle Remove="#wisp-bundle-complete" />
      <FileWrites Include="@(_WasmObjectFilesForBundle);$(_WispBundleInventory);$(_WispBundleManifest)" />
    </ItemGroup>
  </Target>
</Project>
