<Project>
  <UsingTask TaskName="IsoplaneDebugManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task><Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)DebugManifest.cs" /></Task>
  </UsingTask>
  <Target Name="IsoplaneNativeAotDebugSettings" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DebugType)' != 'portable' OR '$(Optimize)' != 'false' OR '$(StripSymbols)' != 'false'"
           Text="NativeAOT local debugging requires portable symbols, Optimize=false and StripSymbols=false. Remove conflicting overrides." />
    <Error Condition="'$(IsoplaneContainerBuild)' == 'true'" Text="NativeAOT local debugging requires the native toolchain." />
  </Target>
  <Target Name="IsoplaneNativeAotDebugPublish" AfterTargets="CopyNativeBinary">
    <PropertyGroup>
      <_IsoplaneNativeDebugModule>$(PublishDir)$([System.IO.Path]::GetFileName('$(NativeBinary)'))</_IsoplaneNativeDebugModule>
      <_IsoplaneNativeDebugManifest>$([System.IO.Path]::ChangeExtension('$(_IsoplaneNativeDebugModule)', '.debug.xml'))</_IsoplaneNativeDebugManifest>
    </PropertyGroup>
    <!-- DWARF carries native debugger names; the duplicate Wasm name table consumes the admission metadata budget. -->
    <Exec Command="&quot;$(_NativeWasmSdkBinPath)llvm-objcopy$(_HostToolExeExt)&quot; --remove-section=name &quot;$(_IsoplaneNativeDebugModule)&quot;" />
    <IsoplaneDebugManifest Module="$(_IsoplaneNativeDebugModule)" Symbols="$(_IsoplaneNativeDebugModule)" Endpoint="native" Output="$(_IsoplaneNativeDebugManifest)" />
    <ItemGroup><FileWrites Include="$(_IsoplaneNativeDebugManifest)" /></ItemGroup>
  </Target>
</Project>
