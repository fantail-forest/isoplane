<Project>
  <Target Name="_GenerateManagedToNative"
          DependsOnTargets="WispMonoManagedToNativeInputs;WispMonoGenerateManagedToNative">
    <ItemGroup><FileWrites Include="@(_WispManagedToNativeOutputs);$(_WispManagedToNativeInventory);$(_WispManagedToNativeStamp)" /></ItemGroup>
  </Target>

  <Target Name="WispMonoManagedToNativeInputs">
    <Error Condition="'$(_MonoAotCrossCompilerPath)' == ''" Text="Managed-to-native generation requires the Mono AOT cross compiler; restore the WASI workload before building." />
    <MakeDir Directories="$(_WasmIntermediateOutputPath)" />
    <ItemGroup>
      <_WasmPInvokeModules Include="%(_WasmNativeFileForLinking.FileName)" Condition="'%(_WasmNativeFileForLinking.ScanForPInvokes)' != 'false'" />
      <_WasmPInvokeModules Include="libSystem.Native;libSystem.IO.Compression.Native;libSystem.Globalization.Native" />
      <_WasmPInvokeModules Include="libSystem.Security.Cryptography.Native.OpenSsl" Condition="Exists('$(MicrosoftNetCoreAppRuntimePackRidNativeDir)libSystem.Security.Cryptography.Native.OpenSsl.a')" />
      <_WispMscorlib Include="@(_WasmAssembliesInternal)" Condition="'%(Filename)%(Extension)' == 'mscorlib.dll'" />
    </ItemGroup>
    <PropertyGroup>
      <_MscorlibPath Condition="'@(_WispMscorlib)' == ''">$([System.IO.Path]::Combine('$(MicrosoftNetCoreAppRuntimePackRidLibTfmDir)', 'mscorlib.dll'))</_MscorlibPath>
      <_WispManagedToNativeInventory>$(_WasmIntermediateOutputPath)wisp-managed-to-native.inputs</_WispManagedToNativeInventory>
      <_WispManagedToNativeStamp>$(_WasmIntermediateOutputPath)wisp-managed-to-native.complete</_WispManagedToNativeStamp>
    </PropertyGroup>
    <ItemGroup>
      <_WispManagedToNativeInputs Include="@(_WasmAssembliesInternal);$(_MscorlibPath);$(WasmPInvokeSymbolInventoryFile);$(_MonoAotCrossCompilerPath);$(WasmAppBuilderTasksAssemblyPath);$(MSBuildAllProjects);$(MSBuildThisFileFullPath)" />
      <_WispManagedToNativeOutputs Include="$(_WasmRuntimeICallTablePath);$(_WasmICallTablePath);$(_WasmPInvokeTablePath);$(_WasmInterpToNativeTablePath)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_WispManagedToNativeInputs.Identity)')" Text="A managed-to-native generation input is missing: %(_WispManagedToNativeInputs.Identity)" />
    <WriteLinesToFile File="$(_WispManagedToNativeInventory)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="@(_WispManagedToNativeInputs);@(_WasmPInvokeModules);@(_WispManagedToNativeOutputs);$(_IsLibraryMode);$(WasmRequirePInvokeSymbolInventory);$(WispGuestRuntimePackVersion);$(WispGuestRuntimePackSha512)" />
    <Delete Files="$(_WispManagedToNativeStamp)" Condition="!Exists('%(_WispManagedToNativeOutputs.Identity)')" />
  </Target>

  <!-- The generator preserves unchanged headers. A completion stamp tracks
       successful analysis without making unchanged headers force a relink. -->
  <Target Name="WispMonoGenerateManagedToNative"
          Inputs="@(_WispManagedToNativeInputs);$(_WispManagedToNativeInventory)"
          Outputs="$(_WispManagedToNativeStamp)">
    <Delete Files="$(_WispManagedToNativeStamp)" />
    <Exec Command="&quot;$(_MonoAotCrossCompilerPath)&quot; --print-icall-table &gt; &quot;$(_WasmRuntimeICallTablePath)&quot;" />
    <ManagedToNativeGenerator
        Assemblies="@(_WasmAssembliesInternal);$(_MscorlibPath)"
        RuntimeIcallTableFile="$(_WasmRuntimeICallTablePath)"
        IcallOutputPath="$(_WasmICallTablePath)"
        PInvokeModules="@(_WasmPInvokeModules)"
        PInvokeSymbolInventoryFile="$(WasmPInvokeSymbolInventoryFile)"
        RequirePInvokeSymbolInventory="$(WasmRequirePInvokeSymbolInventory)"
        PInvokeOutputPath="$(_WasmPInvokeTablePath)"
        InterpToNativeOutputPath="$(_WasmInterpToNativeTablePath)"
        IsLibraryMode="$(_IsLibraryMode)">
      <Output TaskParameter="FileWrites" ItemName="FileWrites" />
    </ManagedToNativeGenerator>
    <Touch Files="$(_WispManagedToNativeStamp)" AlwaysCreate="true" />
  </Target>
</Project>
