<Project>
  <Target Name="IsoplaneGenerateExports" BeforeTargets="CoreCompile" Condition="'$(IsoplaneManagedBundleBuild)' != 'true'">
    <PropertyGroup>
      <_IsoplaneExportsPath>$(IntermediateOutputPath)Isoplane.Exports.g.cs</_IsoplaneExportsPath>
      <_IsoplaneExportsSource><![CDATA[
#nullable enable
using System.Runtime.InteropServices;
using Guest = Isoplane.Abi.Exports<IsoplaneGeneratedRouter>;
internal static class IsoplaneGeneratedExports {
#if ISOPLANE_MONO
  [System.Diagnostics.CodeAnalysis.DynamicDependency(System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicMethods, typeof(IsoplaneGeneratedExports))]
  public static void Main() { }
#endif
#if !ISOPLANE_MONO
  [UnmanagedCallersOnly(EntryPoint="isoplane_alloc")]
#endif
  public static int Alloc(int size, int align) => Guest.Alloc(size, align);
#if !ISOPLANE_MONO
  [UnmanagedCallersOnly(EntryPoint="isoplane_handle")]
#endif
  public static long Handle(int ptr, int len) => Guest.Handle(ptr, len);
#if !ISOPLANE_MONO
  [UnmanagedCallersOnly(EntryPoint="isoplane_wake")]
#endif
  public static long Wake(long future, int ptr, int len) => Guest.Wake(future, ptr, len);
#if !ISOPLANE_MONO
  [UnmanagedCallersOnly(EntryPoint="isoplane_initialize")]
#endif
  public static long Initialize() => Guest.Initialize();
#if !ISOPLANE_MONO
  [UnmanagedCallersOnly(EntryPoint="isoplane_gc_hint")]
#endif
  public static void GcHint(int pressure) => Guest.GcHint(pressure);
}
]]></_IsoplaneExportsSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(_IsoplaneExportsPath)" Lines="$([MSBuild]::Escape($(_IsoplaneExportsSource)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(_IsoplaneExportsPath)" IsoplaneRuntimeSource="true" /></ItemGroup>
  </Target>
</Project>
