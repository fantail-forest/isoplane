<Project>
  <PropertyGroup>
    <_IsoplaneNativeTaskProject>$(MSBuildThisFileDirectory)../Conformance/Conformance.csproj</_IsoplaneNativeTaskProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(_IsoplaneNativeTaskProject)')">
    <ProjectReference Include="$(_IsoplaneNativeTaskProject)" ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="$(_IsoplaneSourceReferencePropertiesToRemove)" />
  </ItemGroup>
  <Import Project="../Conformance/Build.props" Condition="Exists('$(_IsoplaneNativeTaskProject)')" />
  <UsingTask TaskName="Isoplane.Conformance.NativeExports" AssemblyFile="$(_IsoplaneConformanceAssembly)"
             Condition="Exists('$(_IsoplaneNativeTaskProject)')" />
  <UsingTask TaskName="Isoplane.Conformance.NativeExports" AssemblyFile="$(MSBuildThisFileDirectory)../Conformance/Isoplane.Conformance.dll"
             Condition="!Exists('$(_IsoplaneNativeTaskProject)')" />
</Project>
