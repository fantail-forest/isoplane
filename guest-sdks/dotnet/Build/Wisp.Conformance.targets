<Project>
  <UsingTask TaskName="Wisp.Conformance.InspectManagedAssemblies"
             AssemblyFile="$(MSBuildThisFileDirectory)../Conformance/Isoplane.Conformance.dll" />
  <Target Name="WispInspectManagedAssemblies" AfterTargets="CoreCompile" DependsOnTargets="WispResolveManagedPlatform"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(WasmBuildingForNestedPublish)' != 'true'">
    <ItemGroup>
      <_WispConformanceAssembly Include="@(IntermediateAssembly)" />
      <_WispConformanceAssembly Include="@(ReferenceCopyLocalPaths)"
                                Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' AND '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Wisp.Sdk' AND '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Wisp.AspNetCore'" />
      <_WispConformanceAssembly Remove="@(WispBundlePlatformReference)" MatchOnMetadata="Filename;Extension" MatchOnMetadataOptions="CaseInsensitive" />
      <_WispConformanceAssembly Remove="@(RuntimePackAsset)" />
    </ItemGroup>
    <Wisp.Conformance.InspectManagedAssemblies Assemblies="@(_WispConformanceAssembly)" />
  </Target>
</Project>
