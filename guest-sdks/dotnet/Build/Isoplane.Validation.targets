<Project>
  <!--
    Every publish that links a module runs `isoplane doctor` on it, after the
    link, so a validator rejection costs a build rather than a deploy. The
    gate is mandatory: a rejection (ISOPLANE0001), a missing CLI (ISOPLANE0002) and a
    CLI that reached no verdict (ISOPLANE0003) are all errors, since a module
    nothing has judged is not a publication. `dotnet build` on a guest
    compiles to IL only and produces no module, which the target below says.
    A local debugging publish links a raw artifact the control plane refuses
    by design and is not a publication either.
  -->
  <PropertyGroup>
    <IsoplaneCli Condition="'$(IsoplaneCli)' == '' AND '$(ISOPLANE_CLI)' != ''">$(ISOPLANE_CLI)</IsoplaneCli>
    <IsoplaneCli Condition="'$(IsoplaneCli)' == ''">isoplane</IsoplaneCli>
    <IsoplaneCliAssembly Condition="'$(IsoplaneCliAssembly)' == ''">$(ISOPLANE_CLI_ASSEMBLY)</IsoplaneCliAssembly>

    <!-- Empty: `isoplane doctor` reads the plan from the app's `isoplane.toml`. Not
         defaulted from IsoplaneMemoryMaxBytes, which is what the module declares
         rather than what it is allowed to. -->
  </PropertyGroup>

  <Target Name="IsoplaneValidateModule"
          AfterTargets="IsoplaneMonoPublishCore"
          Condition="'$(IsoplaneLocalDebug)' != 'true' AND '$(NativeBinary)' != '' AND Exists('$(NativeBinary)')">

    <PropertyGroup>
      <!-- Absolute, so the paths in the messages can be pasted back. -->
      <_IsoplaneModule>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(NativeBinary)'))))</_IsoplaneModule>
      <_IsoplaneDoctor>&quot;$(IsoplaneCli)&quot; doctor &quot;$(_IsoplaneModule)&quot; --no-color</_IsoplaneDoctor>
      <_IsoplaneDoctor Condition="'$(IsoplaneCliAssembly)' != ''">dotnet &quot;$(IsoplaneCliAssembly)&quot; doctor &quot;$(_IsoplaneModule)&quot; --no-color</_IsoplaneDoctor>
      <_IsoplaneDoctor Condition="'$(IsoplaneGuestMemoryBytes)' != ''">$(_IsoplaneDoctor) --guest-memory-bytes $(IsoplaneGuestMemoryBytes)</_IsoplaneDoctor>
    </PropertyGroup>

    <!-- The exit code is the result: 0 accepted, 2 rejected, 127 or 9009 no
         such command, anything else no answer. -->
    <Exec Command="$(_IsoplaneDoctor)"
          IgnoreExitCode="true"
          ContinueOnError="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_IsoplaneDoctorExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_IsoplaneDoctorSaid" />
    </Exec>

    <Message Condition="'$(_IsoplaneDoctorExit)' != '0'" Importance="high" Text="@(_IsoplaneDoctorSaid, '%0a')" />

    <!-- One line on the happy path, naming the plan the verdict was reached
         against. -->
    <ItemGroup Condition="'$(_IsoplaneDoctorExit)' == '0'">
      <_IsoplanePlanLine Include="@(_IsoplaneDoctorSaid)"
                     Condition="$([System.String]::Copy('%(Identity)').Contains('judged against'))" />
    </ItemGroup>
    <Message Condition="'$(_IsoplaneDoctorExit)' == '0'" Importance="high"
             Text="isoplane: $(TargetName).wasm passes validator rules V1-V4 — @(_IsoplanePlanLine->Trim(), '; ')" />

    <!-- The end-of-build summary reprints only the Error text, so the
         violation is in it. -->
    <ItemGroup Condition="'$(_IsoplaneDoctorExit)' == '2'">
      <_IsoplaneVerdict Include="@(_IsoplaneDoctorSaid)"
                    Condition="$([System.String]::Copy('%(Identity)').Contains('✗'))" />
    </ItemGroup>
    <ItemGroup Condition="'$(_IsoplaneDoctorExit)' == '2' AND '@(_IsoplaneVerdict)' == ''">
      <_IsoplaneVerdict Include="see the report above" />
    </ItemGroup>

    <Error Condition="'$(_IsoplaneDoctorExit)' == '2'"
           Code="ISOPLANE0001"
           File="$(MSBuildProjectFullPath)"
           Text="the control plane would reject $(_IsoplaneModule): @(_IsoplaneVerdict->Trim(), ' / ') — reproduce with `$(IsoplaneCli) doctor $(_IsoplaneModule)`." />

    <Error Condition="'$(_IsoplaneDoctorExit)' == '127' OR '$(_IsoplaneDoctorExit)' == '9009'"
           Code="ISOPLANE0002"
           File="$(MSBuildProjectFullPath)"
           Text="the module was not validated: no `isoplane` CLI at '$(IsoplaneCli)'. $(_IsoplaneModule) was linked but nothing judged it against validator rules V1-V4, and an unjudged module is not a publication. Install the Isoplane CLI, run `isoplane setup` with the supplied toolchain bundle, then `isoplane doctor`." />

    <Error Condition="'$(_IsoplaneDoctorExit)' != '0' AND '$(_IsoplaneDoctorExit)' != '2' AND '$(_IsoplaneDoctorExit)' != '127' AND '$(_IsoplaneDoctorExit)' != '9009'"
           Code="ISOPLANE0003"
           File="$(MSBuildProjectFullPath)"
           Text="the module was not validated: `$(IsoplaneCli) doctor` exited $(_IsoplaneDoctorExit) without reaching a verdict (its output is above). $(_IsoplaneModule) is unjudged, and an unjudged module is not a publication. Reproduce with `$(_IsoplaneDoctor)`." />
  </Target>

  <!-- `_IsPublishing` is set for `dotnet publish` and empty for `dotnet build`. -->
  <Target Name="IsoplaneSaysBuildDoesNotProduceAModule"
          AfterTargets="Build"
          Condition="'$(_IsPublishing)' != 'true' AND '$(WasmBuildingForNestedPublish)' != 'true' AND '$(_IsoplaneBuildsRunnableModule)' != 'true'">
    <Message Importance="high"
             Text="isoplane: this was `dotnet build` — it compiled to IL and produced no .wasm, so nothing was validated. `dotnet publish` (what the guest's build.sh runs) is what links a module in, and where rules V1-V4 are checked." />
  </Target>

</Project>
