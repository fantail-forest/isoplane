<Project>
  <Target Name="WispManagedBundle" DependsOnTargets="Build">
    <Error Condition="'$(WispManagedBundleBuild)' != 'true'" Text="Use isoplane bundle to build managed deployment input." />
    <Error Condition="'$(WispApplicationFactory)' == ''" Text="Set WispApplicationFactory to the application's public static factory method." />
    <ItemGroup>
      <_WispBundleAspNetReference Include="$(NuGetPackageRoot)/microsoft.aspnetcore.app.runtime.linux-x64/$(WispAspNetCoreRuntimeVersion)/runtimes/linux-x64/lib/net10.0/*.dll" Condition="'$(WispAspNetCoreRuntimeVersion)' != ''" />
      <WispBundlePlatformReference Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' != '' OR '%(ReferencePath.NuGetPackageId)' == 'Wisp.Sdk' OR '%(ReferencePath.NuGetPackageId)' == 'Wisp.AspNetCore'" />
      <WispBundlePlatformReference Remove="@(_WispBundleAspNetReference)" MatchOnMetadata="Filename;Extension" MatchOnMetadataOptions="CaseInsensitive" />
      <WispBundlePlatformReference Include="@(_WispBundleAspNetReference)" />
      <WispBundleAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' AND '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Wisp.Sdk' AND '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Wisp.AspNetCore'" />
      <WispBundleAssembly Remove="@(WispBundlePlatformReference)" MatchOnMetadata="Filename;Extension" MatchOnMetadataOptions="CaseInsensitive" />
      <WispBundleAssembly Remove="@(RuntimePackAsset)" />
      <WispBundleAssembly Include="$(TargetPath);@(IntermediateSatelliteAssembliesWithTargetPath)" />
      <_WispBundleSymbol Include="@(WispBundleAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <WispBundleSymbol Include="@(_WispBundleSymbol)" Condition="Exists('%(_WispBundleSymbol.Identity)')" />
      <WispBundleAsset Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' != '.dll' AND '%(Extension)' != '.pdb' AND '%(Extension)' != '.xml'" />
      <WispBundleAsset Remove="@(RuntimePackAsset)" />
      <WispBundleAsset Include="@(_NoneWithTargetPath)" Condition="'%(_NoneWithTargetPath.CopyToPublishDirectory)' != 'Never' AND (('%(_NoneWithTargetPath.CopyToOutputDirectory)' != '' AND '%(_NoneWithTargetPath.CopyToOutputDirectory)' != 'Never') OR '%(_NoneWithTargetPath.CopyToPublishDirectory)' != '')" />
      <WispBundleAsset Include="@(ContentWithTargetPath)" Condition="'%(ContentWithTargetPath.CopyToPublishDirectory)' != 'Never' AND (('%(ContentWithTargetPath.CopyToOutputDirectory)' != '' AND '%(ContentWithTargetPath.CopyToOutputDirectory)' != 'Never') OR ('%(ContentWithTargetPath.CopyToPublishDirectory)' != '' AND '%(ContentWithTargetPath.CopyToPublishDirectory)' != 'Never'))" />
      <WispBundleAsset Remove="NuGet.Config;nuget.config;$(MSBuildProjectDirectory)/NuGet.Config;$(MSBuildProjectDirectory)/nuget.config" />
    </ItemGroup>
  </Target>
</Project>
