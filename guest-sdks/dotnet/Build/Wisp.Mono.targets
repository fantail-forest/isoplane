<Project>
  <Target Name="WispMonoSelectRuntimePack" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(WispGuestRuntimePackVersion)" />
    </ItemGroup>
  </Target>
  <Import Project="Wisp.Validation.targets" />
  <ItemGroup>
    <LinkerArg Include="-nostartfiles" />
    <LinkerArg Include="-Wl,--skip-wit-component,--no-entry,--export=wisp_alloc,--export=wisp_handle,--export=wisp_wake,--export=wisp_initialize,--export=wisp_gc_hint,--export=__stack_pointer,--max-memory=$(WispMemoryMaxBytes)" />
    <LinkerArg Include="@(WispWrappedSymbol->'-Wl,--wrap=%(Identity)')" />
  </ItemGroup>
  <Target Name="WispMonoPaths">
    <PropertyGroup>
      <_WispMonoDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'wisp-mono'))</_WispMonoDir>
    </PropertyGroup>
    <MakeDir Directories="$(_WispMonoDir)" />
  </Target>
  <!-- The source-built runtime pack integrates scheduling, sockets, DNS and
       cryptography with the host in source, so no assembly is adapted; the
       pack's prebuilt runtime module gives way to the native link below. -->
  <Target Name="WispMonoDropPrebuiltRuntime" BeforeTargets="_ComputeManagedAssemblyToLink">
    <ItemGroup>
      <_WispMonoPrebuilt Include="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'dotnet' AND '%(Extension)' == '.wasm'" />
      <ResolvedFileToPublish Remove="@(_WispMonoPrebuilt)" />
    </ItemGroup>
  </Target>
  <Target Name="WispMonoNativeEntry" BeforeTargets="_PrepareForWasiBuildNative" DependsOnTargets="WispMonoPaths">
    <WriteLinesToFile File="$(_WispMonoDir)mono_assembly.h" Lines="#define WISP_MONO_ASSEMBLY &quot;$(AssemblyName)&quot;" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(_WispSdkDirectory)native/mono_entry.c" DestinationFiles="$(_WispMonoDir)mono_entry.c" />
    <ItemGroup>
      <NativeFileReference Include="$(_WispMonoDir)mono_entry.c;$(_WispSdkDirectory)native/wisp_clock.c" />
      <NativeFileReference Include="$(_WispSdkDirectory)native/wisp_pal.c" Condition="'$(WispLocalDebug)' != 'true'" />
      <FileWrites Include="$(_WispMonoDir)mono_entry.c;$(_WispMonoDir)mono_assembly.h" />
    </ItemGroup>
  </Target>
  <!-- The pack the link draws on must be the pack the feed offers: NuGet
       keeps one extraction per version, so a stale copy could shadow a
       republished pack. The workload names the directory it links from. -->
  <Target Name="WispMonoVerifyRuntimePack" DependsOnTargets="_InitializeCommonProperties">
    <Error Condition="'$(MicrosoftNetCoreAppRuntimePackDir)' == ''"
           Text="wisp: the workload resolved no runtime pack directory; expected the feed's Microsoft.NETCore.App.Runtime.Mono.wasi-wasm $(WispGuestRuntimePackVersion)." />
    <PropertyGroup>
      <_WispMonoRuntimePackDirectory>$([MSBuild]::NormalizeDirectory('$(MicrosoftNetCoreAppRuntimePackDir)'))</_WispMonoRuntimePackDirectory>
      <_WispMonoRuntimePackDigestFile>$(_WispMonoRuntimePackDirectory)microsoft.netcore.app.runtime.mono.wasi-wasm.$(WispGuestRuntimePackVersion.ToLowerInvariant()).nupkg.sha512</_WispMonoRuntimePackDigestFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WispMonoRuntimePackDigestFile)')"
           Text="wisp: the runtime pack at $(_WispMonoRuntimePackDirectory) records no package digest ($(_WispMonoRuntimePackDigestFile)); it is not a NuGet extraction of the feed's pack $(WispGuestRuntimePackVersion)." />
    <ReadLinesFromFile File="$(_WispMonoRuntimePackDigestFile)">
      <Output TaskParameter="Lines" PropertyName="_WispMonoRuntimePackDigest" />
    </ReadLinesFromFile>
    <Error Condition="'$(_WispMonoRuntimePackDigest)' != '$(WispGuestRuntimePackSha512)'"
           Text="wisp: the runtime pack at $(_WispMonoRuntimePackDirectory) is not the pack the feed offers (digest $(_WispMonoRuntimePackDigest) vs $(WispGuestRuntimePackSha512)); delete that directory or republish the feed with guest-runtime/build.sh feed." />
  </Target>
  <Target Name="WispMonoPublishCore" AfterTargets="_WasiLinkDotNet" DependsOnTargets="WispMonoVerifyRuntimePack">
    <PropertyGroup><NativeBinary>$(PublishDir)$(AssemblyName).wasm</NativeBinary></PropertyGroup>
    <Copy SourceFiles="$(_WasiOutputFileName)" DestinationFiles="$(NativeBinary)" />
    <!-- The identity of the runtime the module links, beside it, so a test
         result is attributable to those bytes. -->
    <WriteLinesToFile File="$(NativeBinary).runtime" Lines="$(WispGuestRuntimePackVersion)@sha512:$(WispGuestRuntimePackSha512)" Overwrite="true" />
    <ItemGroup><FileWrites Include="$(NativeBinary);$(NativeBinary).runtime" /></ItemGroup>
  </Target>
  <Import Project="Wisp.Mono.Debug.targets" Condition="'$(WispLocalDebug)' == 'true'" />
</Project>
