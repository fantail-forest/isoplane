<Project>
  <Import Project="Isoplane.NativeAot.targets" />
  <UsingTask TaskName="IsoplaneContainerPublish" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)ContainerPublish.cs" />
    </Task>
  </UsingTask>

  <Target Name="IsoplanePublishInContainer" BeforeTargets="Publish"
          Condition="'$(IsoplaneContainerBuild)' == 'true'">
    <PropertyGroup>
      <IsoplaneBuildRoot Condition="'$(IsoplaneBuildRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'nuget.config'))</IsoplaneBuildRoot>
      <IsoplaneBuildRoot Condition="'$(IsoplaneBuildRoot)' == ''">$(MSBuildProjectDirectory)</IsoplaneBuildRoot>
      <IsoplaneContainerCommandTimeoutSeconds Condition="'$(IsoplaneContainerCommandTimeoutSeconds)' == ''">60</IsoplaneContainerCommandTimeoutSeconds>
    </PropertyGroup>
    <IsoplaneContainerPublish ProjectPath="$(MSBuildProjectFullPath)" SourceRoot="$(IsoplaneBuildRoot)"
                          SdkDirectory="$(_IsoplaneSdkDirectory)" PublishDirectory="$(PublishDir)"
                          GuestRuntimeFeed="$(IsoplaneGuestRuntimeFeed)" WasiSdkPackDirectory="$(IsoplaneGuestWasiSdkPackDirectory)" Validator="$(IsoplaneCli)"
                          GuestMemoryBytes="$(IsoplaneGuestMemoryBytes)" MemoryMaxBytes="$(IsoplaneMemoryMaxBytes)"
                          Configuration="$(Configuration)" Offline="$(IsoplaneOffline)"
                          CacheDirectory="$(IsoplaneCompilerCache)"
                          CommandTimeoutSeconds="$(IsoplaneContainerCommandTimeoutSeconds)">
      <Output TaskParameter="Module" PropertyName="NativeBinary" />
    </IsoplaneContainerPublish>
  </Target>

  <Target Name="IsoplanePalInputs"
          Condition="'$(IsoplaneContainerBuild)' != 'true'">
    <PropertyGroup>
      <WASI_SDK_PATH Condition="'$(WASI_SDK_PATH)' == ''">/opt/wasi-sdk</WASI_SDK_PATH>
      <IsoplanePalObject>$(IntermediateOutputPath)isoplane_pal.o</IsoplanePalObject>
      <IsoplaneClockObject>$(IntermediateOutputPath)isoplane_clock.o</IsoplaneClockObject>
    </PropertyGroup>
    <Error Condition="!Exists('$(WASI_SDK_PATH)/bin/clang')"
           Text="isoplane: missing wasi-sdk clang at $(WASI_SDK_PATH)/bin/clang; run isoplane setup with the supplied toolchain bundle, then isoplane doctor." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup>
      <NativeLibrary Include="$(IsoplanePalObject);$(IsoplaneClockObject)" />
      <_IsoplanePalInputs Include="$(_IsoplaneSdkDirectory)native/isoplane_pal.c;$(_IsoplaneSdkDirectory)native/isoplane_clock.c;$(_IsoplaneSdkDirectory)native/**/*.h;$(MSBuildAllProjects);$(WASI_SDK_PATH)/bin/clang;$(WASI_SDK_PATH)/share/wasi-sysroot/include/**/*.h;$(WASI_SDK_PATH)/lib/clang/**/include/**/*.h" />
      <LinkerArg Include="@(IsoplaneWrappedSymbol->'-Wl,--wrap=%(Identity)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)isoplane-pal.inputs"
                      Lines="@(_IsoplanePalInputs);@(NativeObjects);@(NativeLibrary);@(LinkerArg);$(IsoplaneGuestNativeAotPackVersion);$(IsoplaneGuestNativeAotPackSha512);$(IsoplaneGuestCompilerVersion);$(IsoplaneGuestCompilerSha512)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="IsoplaneCompilePal" BeforeTargets="LinkNativeLlvm" DependsOnTargets="IsoplanePalInputs"
          Condition="'$(IsoplaneContainerBuild)' != 'true'"
          Inputs="@(_IsoplanePalInputs);$(IntermediateOutputPath)isoplane-pal.inputs"
          Outputs="$(IsoplanePalObject);$(IsoplaneClockObject)">
    <Exec Command="&quot;$(WASI_SDK_PATH)/bin/clang&quot; --target=wasm32-unknown-wasip2 -O2 -c -o &quot;$(IsoplanePalObject)&quot; &quot;$(_IsoplaneSdkDirectory)native/isoplane_pal.c&quot;" />
    <Exec Command="&quot;$(WASI_SDK_PATH)/bin/clang&quot; --target=wasm32-unknown-wasip2 -O2 -c -o &quot;$(IsoplaneClockObject)&quot; &quot;$(_IsoplaneSdkDirectory)native/isoplane_clock.c&quot;" />
  </Target>

  <!-- PublishDir may be outside OutDir, where MSBuild's FileWrites cleanup stops. -->
  <Target Name="IsoplaneRecordPublishOutputs" AfterTargets="IsoplanePublishInContainer;Publish"
          Condition="'$(NativeBinary)' != '' AND Exists('$(NativeBinary)')">
    <ItemGroup>
      <_IsoplanePublishOutput Include="$(NativeBinary)" />
      <_IsoplanePublishOutput Include="$(NativeBinary).runtime" Condition="Exists('$(NativeBinary).runtime')" />
      <_IsoplanePublishOutput Include="$(IsoplanePalObject)" Condition="'$(IsoplanePalObject)' != ''" />
      <_IsoplanePublishOutput Include="$(IsoplaneClockObject)" Condition="'$(IsoplaneClockObject)' != ''" />
      <_IsoplanePublishOutput Include="$(PublishDir)$([System.IO.Path]::GetFileName('$(NativeBinary)'))"
                          Condition="'$(IsoplaneContainerBuild)' != 'true'" />
      <_IsoplanePublishOutput Include="$(PublishDir)$([System.IO.Path]::GetFileName('$(NativeBinary)')).runtime"
                          Condition="'$(IsoplaneContainerBuild)' != 'true'" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)$(MSBuildProjectFile).Isoplane.FileListAbsolute.txt"
                      Lines="@(_IsoplanePublishOutput->'%(FullPath)')" />
  </Target>

  <Target Name="IsoplaneCleanPublishOutputs" BeforeTargets="CoreClean">
    <ReadLinesFromFile File="$(IntermediateOutputPath)$(MSBuildProjectFile).Isoplane.FileListAbsolute.txt">
      <Output TaskParameter="Lines" ItemName="_IsoplaneFilesToClean" />
    </ReadLinesFromFile>
    <Delete Files="@(_IsoplaneFilesToClean);$(IntermediateOutputPath)$(MSBuildProjectFile).Isoplane.FileListAbsolute.txt" />
  </Target>
</Project>
