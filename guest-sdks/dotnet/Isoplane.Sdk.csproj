<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C# Isoplane guest SDK: the ABI, the async runtime, and the bindings.
    Compiles to IL; the guest that references it is what publishes to wasm.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Isoplane</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>false</ImplicitUsings>
    <DebugType>none</DebugType>
    <!-- The guest publishes; this project never does. -->
    <IsPackable>true</IsPackable>
    <Description>Isoplane guest ABI, request bindings and cooperative runtime.</Description>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>

    <!-- A public member without a doc comment fails the build (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <InternalsVisibleTo Include="Isoplane.AspNetCore.Tests" />
    <InternalsVisibleTo Include="Isoplane.AspNetCore" />
    <InternalsVisibleTo Include="Isoplane.MonoRuntime" />
    <Compile Include="Abi/**/*.cs" Exclude="Abi/Tests/**/*.cs" />
    <Compile Include="Runtime/**/*.cs" />
    <Compile Include="Sdk/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Conformance/Conformance.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;PublishAot;SelfContained" />
    <!-- Built here and packed under analyzers/, where NuGet hands them to the compiler and to editors. -->
    <ProjectReference Include="Analyzers/Isoplane.Analyzers.csproj;Analyzers.CodeFixes/Isoplane.Analyzers.CodeFixes.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;PublishAot;SelfContained" />
    <None Update="PackageReadme.md" Pack="true" PackagePath="/" />
    <None Include="MSBuild/Sdk.targets" Pack="true" PackagePath="Sdk/" />
    <None Include="Build/Isoplane.ManagedBundle.*;Build/Isoplane.Conformance.targets;Build/Isoplane.Run.targets" Pack="true" PackagePath="tools/Build/" />
  </ItemGroup>
  <!-- The shared runtimes interpreted applications run on, production and
       local-debug. Their directory comes from guest-sdks/dotnet/MonoRuntime/build.sh,
       whose manifest must name this SDK version, and in a release build this
       source revision. The package carries the runtimes' identity, runtime.json,
       beside them; application packages built against this SDK carry it too. -->
  <ItemGroup>
    <_IsoplaneRuntimeModuleName Include="Isoplane.MonoRuntime;Isoplane.MonoRuntime.Debug" />
  </ItemGroup>
  <Import Project="Conformance/Build.props" />
  <UsingTask TaskName="Isoplane.Conformance.ValidateRuntimeReceipt"
             AssemblyFile="$(_IsoplaneConformanceArtifacts)bin/Conformance/$(Configuration.ToLowerInvariant())/Isoplane.Conformance.dll" />
  <Target Name="IsoplanePackSharedRuntime" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <IsoplaneRuntimeModuleDirectory Condition="'$(IsoplaneRuntimeModuleDirectory)' == ''">$(ISOPLANE_RUNTIME_MODULE_DIRECTORY)</IsoplaneRuntimeModuleDirectory>
      <_IsoplaneRuntimeDirectory>$([MSBuild]::EnsureTrailingSlash('$(IsoplaneRuntimeModuleDirectory)'))</_IsoplaneRuntimeDirectory>
      <_IsoplaneRuntimeProvenance>$(_IsoplaneRuntimeDirectory)runtime.json</_IsoplaneRuntimeProvenance>
      <_IsoplaneRuntimeNativeImports>$(_IsoplaneRuntimeDirectory)native-imports.txt</_IsoplaneRuntimeNativeImports>
    </PropertyGroup>
    <ItemGroup>
      <_IsoplaneRuntimeModule Include="@(_IsoplaneRuntimeModuleName->'$(_IsoplaneRuntimeDirectory)%(Identity).wasm')" />
      <_IsoplaneMissingRuntime Include="@(_IsoplaneRuntimeModule)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Error Condition="'$(IsoplaneRuntimeModuleDirectory)' == '' OR '@(_IsoplaneMissingRuntime)' != '' OR !Exists('$(_IsoplaneRuntimeProvenance)') OR !Exists('$(_IsoplaneRuntimeNativeImports)')"
           Text="Pack the SDK with -p:IsoplaneRuntimeModuleDirectory naming the output of guest-sdks/dotnet/MonoRuntime/build.sh, which holds Isoplane.MonoRuntime.wasm, Isoplane.MonoRuntime.Debug.wasm, runtime.json, native-imports.txt; without its shared runtimes the SDK cannot run or debug interpreted applications." />
    <GetFileHash Files="@(_IsoplaneRuntimeModule)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_IsoplaneHashedRuntime" />
    </GetFileHash>
    <Isoplane.Conformance.ValidateRuntimeReceipt ReceiptFile="$(_IsoplaneRuntimeProvenance)"
        SdkVersion="$(PackageVersion)" SourceRevision="$(SourceRevisionId)"
        ContinuousIntegrationBuild="$([MSBuild]::ValueOrDefault('$(ContinuousIntegrationBuild)', 'false'))"
        Modules="@(_IsoplaneHashedRuntime)" />
    <ItemGroup>
      <None Include="@(_IsoplaneRuntimeModule);$(_IsoplaneRuntimeProvenance);$(_IsoplaneRuntimeNativeImports)" Pack="true" PackagePath="tools/runtime/" />
    </ItemGroup>
  </Target>
  <Target Name="StampCoreSdkVersion" BeforeTargets="_GetPackageFiles">
    <PropertyGroup><_CoreSdkProps>$(IntermediateOutputPath)package/Sdk.props</_CoreSdkProps></PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)package" />
    <Copy SourceFiles="MSBuild/Sdk.props" DestinationFiles="$(_CoreSdkProps)" />
    <XmlPoke XmlInputPath="$(_CoreSdkProps)" Query="/Project/ItemGroup/PackageReference[@Include='Isoplane.Sdk']/@Version" Value="$(PackageVersion)" />
    <XmlPoke XmlInputPath="$(_CoreSdkProps)" Query="/Project/PropertyGroup/IsoplaneSdkVersion" Value="$(PackageVersion)" />
    <ItemGroup><None Include="$(_CoreSdkProps)" Pack="true" PackagePath="Sdk/Sdk.props" /></ItemGroup>
  </Target>
  <Import Project="../../licenses/SdkPackage.props" />
  <Import Project="Conformance/Pack.targets" />
  <Import Project="Analyzers/Pack.targets" />
</Project>
