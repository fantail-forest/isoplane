<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C# Isoplane guest SDK: the ABI, the async runtime, and the bindings.
    Compiles to IL; the guest that references it is what publishes to wasm.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Isoplane</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>false</ImplicitUsings>
    <DebugType>none</DebugType>
    <!-- The guest publishes; this project never does. -->
    <IsPackable>true</IsPackable>
    <Description>Isoplane guest ABI, request bindings and cooperative runtime.</Description>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>

    <!-- A public member without a doc comment fails the build (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <InternalsVisibleTo Include="Isoplane.AspNetCore.Tests" />
    <InternalsVisibleTo Include="Isoplane.AspNetCore" />
    <Compile Include="Abi/**/*.cs" Exclude="Abi/Tests/**/*.cs" />
    <Compile Include="Runtime/**/*.cs" />
    <Compile Include="Sdk/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reference's built output becomes the packed task assembly, so the pack ships what this build produced. -->
    <ProjectReference Include="Conformance/Conformance.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;PublishAot;SelfContained"
                      OutputItemType="None" Pack="true" PackagePath="tools/Conformance/" />
    <None Update="PackageReadme.md" Pack="true" PackagePath="/" />
    <None Include="MSBuild/Sdk.targets" Pack="true" PackagePath="Sdk/" />
    <None Include="Isoplane.Guest.props;Isoplane.Guest.targets" Pack="true" PackagePath="tools/" />
    <None Include="Build/**" Exclude="Build/**/obj/**;Build/**/bin/**" Pack="true" PackagePath="tools/Build/" />
    <None Include="native/**" Pack="true" PackagePath="tools/native/" />
  </ItemGroup>
  <!-- The shared runtimes interpreted applications run on, production and
       local-debug. Their directory comes from guest-sdks/dotnet/MonoRuntime/build.sh,
       whose receipt must name this SDK version, and in a release build this
       source revision. The package carries the runtimes' identity, runtime.json,
       beside them; application packages built against this SDK carry it too. -->
  <ItemGroup>
    <_IsoplaneRuntimeModuleName Include="Isoplane.MonoRuntime;Isoplane.MonoRuntime.Debug" />
  </ItemGroup>
  <Target Name="IsoplanePackSharedRuntime" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <IsoplaneRuntimeModuleDirectory Condition="'$(IsoplaneRuntimeModuleDirectory)' == ''">$(ISOPLANE_RUNTIME_MODULE_DIRECTORY)</IsoplaneRuntimeModuleDirectory>
      <_IsoplaneRuntimeDirectory>$([MSBuild]::EnsureTrailingSlash('$(IsoplaneRuntimeModuleDirectory)'))</_IsoplaneRuntimeDirectory>
      <_IsoplaneRuntimeReceipt>$(_IsoplaneRuntimeDirectory)runtime-build.json</_IsoplaneRuntimeReceipt>
      <_IsoplaneRuntimeProvenance>$(_IsoplaneRuntimeDirectory)runtime.json</_IsoplaneRuntimeProvenance>
    </PropertyGroup>
    <ItemGroup>
      <_IsoplaneRuntimeModule Include="@(_IsoplaneRuntimeModuleName->'$(_IsoplaneRuntimeDirectory)%(Identity).wasm')" />
      <_IsoplaneMissingRuntime Include="@(_IsoplaneRuntimeModule)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Error Condition="'$(IsoplaneRuntimeModuleDirectory)' == '' OR '@(_IsoplaneMissingRuntime)' != '' OR !Exists('$(_IsoplaneRuntimeReceipt)') OR !Exists('$(_IsoplaneRuntimeProvenance)')"
           Text="Pack the SDK with -p:IsoplaneRuntimeModuleDirectory naming the output of guest-sdks/dotnet/MonoRuntime/build.sh, which holds Isoplane.MonoRuntime.wasm, Isoplane.MonoRuntime.Debug.wasm, runtime-build.json and runtime.json; without its shared runtimes the SDK cannot run or debug interpreted applications." />
    <ReadLinesFromFile File="$(_IsoplaneRuntimeReceipt)">
      <Output TaskParameter="Lines" PropertyName="_IsoplaneReceipt" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_IsoplaneReceiptVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_IsoplaneReceipt)', '^.*"sdkVersion":"([^"]*)".*$', '$1'))</_IsoplaneReceiptVersion>
      <_IsoplaneReceiptRevision>$([System.Text.RegularExpressions.Regex]::Replace('$(_IsoplaneReceipt)', '^.*"sourceRevision":"([^"]*)".*$', '$1'))</_IsoplaneReceiptRevision>
    </PropertyGroup>
    <Error Condition="'$(_IsoplaneReceiptVersion)' != '$(PackageVersion)'"
           Text="The shared runtimes in $(IsoplaneRuntimeModuleDirectory) were built for SDK $(_IsoplaneReceiptVersion), not $(PackageVersion); rebuild them from this source." />
    <Error Condition="'$(ContinuousIntegrationBuild)' == 'true' AND '$(_IsoplaneReceiptRevision)' != '$(SourceRevisionId)'"
           Text="The shared runtimes in $(IsoplaneRuntimeModuleDirectory) were built from $(_IsoplaneReceiptRevision), not $(SourceRevisionId); rebuild them from this source." />
    <GetFileHash Files="@(_IsoplaneRuntimeModule)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_IsoplaneHashedRuntime" />
    </GetFileHash>
    <ItemGroup>
      <_IsoplaneHashedRuntime><Sha256>$([System.String]::Copy('%(FileHash)').ToLowerInvariant())</Sha256></_IsoplaneHashedRuntime>
    </ItemGroup>
    <Error Condition="!$(_IsoplaneReceipt.Contains('&quot;%(_IsoplaneHashedRuntime.Filename)%(_IsoplaneHashedRuntime.Extension)&quot;:&quot;%(_IsoplaneHashedRuntime.Sha256)&quot;'))"
           Text="%(_IsoplaneHashedRuntime.Filename)%(_IsoplaneHashedRuntime.Extension) is not the module runtime-build.json records; rebuild the shared runtimes." />
    <ReadLinesFromFile File="$(_IsoplaneRuntimeProvenance)">
      <Output TaskParameter="Lines" PropertyName="_IsoplaneProvenance" />
    </ReadLinesFromFile>
    <Error Condition="!$(_IsoplaneProvenance.Contains('&quot;sdkVersion&quot;:&quot;$(PackageVersion)&quot;')) OR !$(_IsoplaneProvenance.Contains('&quot;%(_IsoplaneHashedRuntime.Filename)%(_IsoplaneHashedRuntime.Extension)&quot;:{&quot;sha256&quot;:&quot;%(_IsoplaneHashedRuntime.Sha256)&quot;}'))"
           Text="runtime.json does not identify this SDK version and %(_IsoplaneHashedRuntime.Filename)%(_IsoplaneHashedRuntime.Extension); rebuild the shared runtimes." />
    <ItemGroup>
      <None Include="@(_IsoplaneRuntimeModule);$(_IsoplaneRuntimeProvenance)" Pack="true" PackagePath="tools/runtime/" />
    </ItemGroup>
  </Target>
  <Target Name="StampCoreSdkVersion" BeforeTargets="_GetPackageFiles">
    <PropertyGroup><_CoreSdkProps>$(IntermediateOutputPath)package/Sdk.props</_CoreSdkProps></PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)package" />
    <Copy SourceFiles="MSBuild/Sdk.props" DestinationFiles="$(_CoreSdkProps)" />
    <XmlPoke XmlInputPath="$(_CoreSdkProps)" Query="/Project/ItemGroup/PackageReference[@Include='Isoplane.Sdk']/@Version" Value="$(PackageVersion)" />
    <XmlPoke XmlInputPath="$(_CoreSdkProps)" Query="/Project/PropertyGroup/IsoplaneSdkVersion" Value="$(PackageVersion)" />
    <ItemGroup><None Include="$(_CoreSdkProps)" Pack="true" PackagePath="Sdk/Sdk.props" /></ItemGroup>
  </Target>
  <Import Project="../../licenses/SdkPackage.props" />
</Project>
