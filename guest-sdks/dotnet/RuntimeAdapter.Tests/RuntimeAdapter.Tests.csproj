<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)/Microsoft.Build.Framework.dll" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll" />
    <Compile Include="../Build/MonoDebugSymbols.cs" Link="MonoDebugSymbols.cs" />
    <Compile Include="../Build/MonoDebugManifest.cs" Link="MonoDebugManifest.cs" />
    <ProjectReference Include="../Wisp.Sdk.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.0" GeneratePathProperty="true" PrivateAssets="all" />
    <Reference Include="Mono.Cecil" HintPath="$(PkgMicrosoft_NET_ILLink_Tasks)/tools/net/Mono.Cecil.dll" />
    <Compile Include="../Build/RuntimeAdapter/CryptoRuntime.cs" Link="CryptoRuntime.cs" />
    <Compile Include="../Build/RuntimeAdapter/RuntimeMethods.cs" Link="RuntimeMethods.cs" />
    <Compile Include="../Build/RuntimeAdapter/ManagedPbkdf2.cs" Link="ManagedPbkdf2.cs" />
    <Compile Include="../Build/RuntimeAdapter/NativeImports.cs" Link="NativeImports.cs" />
    <EmbeddedResource Include="../Build/RuntimeAdapter/NativeImports.tsv" LogicalName="RuntimeAdapter.NativeImports.tsv" />
  </ItemGroup>
</Project>
