<Project>
  <PropertyGroup>
    <_IsoplaneSdkPropsImported>true</_IsoplaneSdkPropsImported>
  </PropertyGroup>
  <!-- The agent skill this package carries; `isoplane skills install` reads it from the project's evaluation. -->
  <ItemGroup>
    <IsoplaneAgentSkillBase Include="$(MSBuildThisFileDirectory)../tools/skill/SKILL.md" />
  </ItemGroup>
</Project>
