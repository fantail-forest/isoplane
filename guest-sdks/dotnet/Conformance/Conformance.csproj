<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Isoplane.Conformance</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="Build.props" />
  <PropertyGroup>
    <OutputPath>$(_IsoplaneConformanceOutputPath)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)/Microsoft.Build.Framework.dll" Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll" Private="false" />
    <Compile Include="../../../tools/BuildProtocol/AssemblyClosure.cs" Link="AssemblyClosure.cs" />
    <Compile Include="../../../tools/BuildProtocol/BuildDiagnostics.cs" Link="BuildDiagnostics.cs" />
    <Compile Include="../../../tools/BuildProtocol/ErrorCodeReference.cs" Link="ErrorCodeReference.cs" />
    <Compile Include="../../../tools/BuildProtocol/AssetPaths.cs" Link="AssetPaths.cs" />
    <Compile Include="../../../tools/BuildProtocol/ApplicationEntryDiscovery.cs" Link="ApplicationEntryDiscovery.cs" />
    <Compile Include="../../../tools/BuildProtocol/ManagedApplication.cs" Link="ManagedApplication.cs" />
  </ItemGroup>
  <!-- Windows loads PE images with execute access, including over SMB. -->
  <Target Name="MakeConformanceLoadableFromWindows" AfterTargets="Build"
          Condition="'$(OS)' != 'Windows_NT' AND Exists('$(TargetPath)')">
    <Exec Command="chmod a+x &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
