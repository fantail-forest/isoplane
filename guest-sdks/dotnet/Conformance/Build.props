<Project>
  <PropertyGroup>
    <_IsoplaneConformanceConfiguration Condition="'$(Configuration)' != ''">$(Configuration)</_IsoplaneConformanceConfiguration>
    <_IsoplaneConformanceConfiguration Condition="'$(_IsoplaneConformanceConfiguration)' == ''">Debug</_IsoplaneConformanceConfiguration>
    <_IsoplaneConformanceOutputPath Condition="'$(ArtifactsPath)' != ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)', 'bin', 'Conformance', '$(_IsoplaneConformanceConfiguration.ToLowerInvariant())'))</_IsoplaneConformanceOutputPath>
    <_IsoplaneConformanceOutputPath Condition="'$(ArtifactsPath)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'bin', '$(_IsoplaneConformanceConfiguration)', 'net10.0'))</_IsoplaneConformanceOutputPath>
    <_IsoplaneConformanceAssembly>$(_IsoplaneConformanceOutputPath)Isoplane.Conformance.dll</_IsoplaneConformanceAssembly>
  </PropertyGroup>
</Project>
