<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Isoplane.Analyzers</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Description>Editor fixes for the entry method diagnostics. Kept apart from the analyzer because only editors can load its workspace dependency.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <ProjectReference Include="../Analyzers/Isoplane.Analyzers.csproj" />
    <InternalsVisibleTo Include="Isoplane.Analyzers.Tests" />
  </ItemGroup>
</Project>
