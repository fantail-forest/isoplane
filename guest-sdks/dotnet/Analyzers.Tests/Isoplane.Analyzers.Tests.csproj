<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <Description>Tests of the entry method analyzer and its fixes, and of its agreement with the build's check of the compiled assembly.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <ProjectReference Include="../Analyzers/Isoplane.Analyzers.csproj" />
    <ProjectReference Include="../Analyzers.CodeFixes/Isoplane.Analyzers.CodeFixes.csproj" />
    <ProjectReference Include="../Isoplane.Sdk.csproj" />
    <!-- The build's own check of a compiled assembly, which the analyzer must agree with. -->
    <!-- The hosts whose Run and RunAsync the analyzers know. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../../../tools/BuildProtocol/AssemblyClosure.cs" Link="AssemblyClosure.cs" />
    <Compile Include="../../../tools/BuildProtocol/AssetPaths.cs" Link="AssetPaths.cs" />
    <Compile Include="../../../tools/BuildProtocol/ApplicationEntryDiscovery.cs" Link="ApplicationEntryDiscovery.cs" />
    <Compile Include="../../../tools/BuildProtocol/ManagedApplication.cs" Link="ManagedApplication.cs" />
  </ItemGroup>
</Project>
