<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <PackageId>Isoplane.AspNetCore.DataProtection.EntityFrameworkCore</PackageId>
    <Description>Keeps ASP.NET Core Data Protection keys in an Entity Framework Core database from an Isoplane application.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <ProjectReference Include="../AspNetCore/Isoplane.AspNetCore.csproj" />
    <None Update="PackageReadme.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <Import Project="../../../licenses/SdkPackage.props" />
  <!-- This package's section of the isoplane agent skill. -->
  <ItemGroup><None Include="../Skill/sections/dataprotection-efcore.md" Pack="true" PackagePath="tools/skill/" /></ItemGroup>
</Project>
