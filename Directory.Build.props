<Project>
  <!-- The one declaration of the release version. Every first-party package,
       the CLI tool and the generated template carry it; scripts/release-version.py
       moves it together with the in-repo SDK pins that must match. -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory).build')) AND !$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory).test-runs'))">
    <!-- Every build of a project in this checkout, from Task, an editor or a bare dotnet command,
         writes to the checkout's own .build and never beside the sources. A caller that names
         another artifacts path keeps it. -->
    <UseArtifactsOutput Condition="'$(ArtifactsPath)' == ''">true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory).build/clr-anycpu/managed</ArtifactsPath>
    <Version>0.1.0-preview.4</Version>
    <RepositoryUrl>https://github.com/fantail-forest/isoplane</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <!-- Probes, fixtures and prepared template projects built anywhere in this checkout, .build included,
       would otherwise write the agent skill into this repository. -->
  <PropertyGroup>
    <IsoplaneWriteAgentSkill>false</IsoplaneWriteAgentSkill>
  </PropertyGroup>
</Project>
