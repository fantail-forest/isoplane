<Project Sdk="Wisp.Sdk/0.1.0">
  <PropertyGroup>
    <WispMemoryMaxBytes>536870912</WispMemoryMaxBytes>
    <Configurations>Debug;Release;WispInterpretedDebug;WispNativeAotRelease</Configurations>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishAot Condition="'$(Configuration)' == 'WispNativeAotRelease'">true</PublishAot>
    <Optimize Condition="'$(Configuration)' == 'WispNativeAotRelease'">true</Optimize>
    <WispApplicationFactory>MinimalTodo.Application.Create</WispApplicationFactory>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>
</Project>
