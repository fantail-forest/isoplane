<Project Sdk="Wisp.Sdk/0.1.0">
  <PropertyGroup>
    <WispMemoryMaxBytes>536870912</WispMemoryMaxBytes>
    <Configurations>Debug;Release;WispInterpretedDebug;WispNativeAotRelease</Configurations>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishAot Condition="'$(Configuration)' == 'WispNativeAotRelease'">true</PublishAot>
    <Optimize Condition="'$(Configuration)' == 'WispNativeAotRelease'">true</Optimize>
    <WispApplicationFactory>MinimalGallery.Application.Create</WispApplicationFactory>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Design/**/*.cs" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.2" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="StbImageResizeSharp" Version="0.97.1" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>
</Project>
