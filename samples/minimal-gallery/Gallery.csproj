<Project Sdk="Isoplane.Sdk/0.1.0-preview.1">
  <PropertyGroup>
    <IsoplaneMemoryMaxBytes>536870912</IsoplaneMemoryMaxBytes>
    <Configurations>Debug;Release;IsoplaneInterpretedDebug;IsoplaneNativeAotRelease</Configurations>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishAot Condition="'$(Configuration)' == 'IsoplaneNativeAotRelease'">true</PublishAot>
    <Optimize Condition="'$(Configuration)' == 'IsoplaneNativeAotRelease'">true</Optimize>
    <IsoplaneApplicationFactory>MinimalGallery.Application.Create</IsoplaneApplicationFactory>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Design/**/*.cs" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.2" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="StbImageResizeSharp" Version="0.97.1" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>
</Project>
