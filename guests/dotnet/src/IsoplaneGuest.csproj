<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    The reference C# guest: its name, and its build flavours. How a C# guest
    is built lives in the SDK's Isoplane.Guest.props.
  -->
  <Import Project="../../../guest-sdks/dotnet/Isoplane.Guest.props" />
  <Import Project="Stock.targets" Condition="'$(IsoplaneStock)' == 'true'" />

  <PropertyGroup>
    <AssemblyName>isoplane_guest_dotnet</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../guest-sdks/dotnet/Isoplane.Sdk.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsoplaneFilesystemProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_FILESYSTEM_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsoplaneFilesystemProbe)' == 'true'">
    <EmbeddedResource Include="App/filesystem-resource.txt" LogicalName="filesystem-resource" />
    <Compile Remove="App/Api.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsoplaneRequestProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_REQUEST_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneStreamingProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_STREAMING_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneActivationProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_ACTIVATION_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneCertificateProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_CERTIFICATE_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneHashingProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_HASHING_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneTrustProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_TRUST_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneRandomnessProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_RANDOMNESS_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneConfigProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_CONFIG_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneFailingBoot)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_FAILING_BOOT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneNetworkRefusalProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_NETWORK_REFUSAL_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneDnsProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_DNS_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneStreamProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_STREAM_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneConnectProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_CONNECT_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneCleanupProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_CLEANUP_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneTimerProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_TIMER_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneLogProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_LOG_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneAsyncProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_ASYNC_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- The BCL compatibility probe (App/Compat.cs). -->
  <PropertyGroup Condition="'$(IsoplaneCompatProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_COMPAT_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- The clone-uniqueness probe (App/Entropy.cs). Off by default. -->
  <PropertyGroup Condition="'$(IsoplaneEntropyProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);ISOPLANE_ENTROPY_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- The Mono targets replace a workload target, so they follow the SDK targets. -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../../guest-sdks/dotnet/Isoplane.Guest.targets" />

</Project>
