<Project>
  <!-- These hostile fixtures expose the BCL imports to the PAL adapter tests. -->
  <PropertyGroup>
    <WispValidate>false</WispValidate>
  </PropertyGroup>
  <!-- Leaving the shim out changes the link and nothing ILC sees, so the
       module a previous publish linked with it must not be reused. -->
  <Target Name="WispCompilePal" BeforeTargets="LinkNativeLlvm">
    <Delete Files="$(NativeBinary)" />
  </Target>
  <Target Name="WispValidateImports" />
</Project>
