<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reference C# guest: its name, and its build flavours. How a C# guest
    is built lives in the SDK's Wisp.Guest.props.
  -->
  <Import Project="../../../guest-sdks/dotnet/Wisp.Guest.props" />

  <PropertyGroup>
    <AssemblyName>wisp_guest_dotnet</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../guest-sdks/dotnet/Wisp.Sdk.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(WispRequestProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_REQUEST_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- The BCL compatibility probe (App/Compat.cs). -->
  <PropertyGroup Condition="'$(WispCompatProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_COMPAT_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- The clone-uniqueness probe (App/Entropy.cs). Off by default. -->
  <PropertyGroup Condition="'$(WispEntropyProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_ENTROPY_PROBE</DefineConstants>
  </PropertyGroup>

</Project>
