<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reference C# guest: its name, and its build flavours. How a C# guest
    is built lives in the SDK's Wisp.Guest.props.
  -->
  <Import Project="../../../guest-sdks/dotnet/Wisp.Guest.props" />
  <Import Project="Stock.targets" Condition="'$(WispStock)' == 'true'" />

  <PropertyGroup>
    <AssemblyName>wisp_guest_dotnet</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../guest-sdks/dotnet/Wisp.Sdk.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(WispFilesystemProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_FILESYSTEM_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WispFilesystemProbe)' == 'true'">
    <EmbeddedResource Include="App/filesystem-resource.txt" LogicalName="filesystem-resource" />
    <Compile Remove="App/Api.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(WispRequestProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_REQUEST_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispRandomnessProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_RANDOMNESS_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispConfigProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_CONFIG_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispFailingBoot)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_FAILING_BOOT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispNetworkRefusalProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_NETWORK_REFUSAL_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispDnsProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_DNS_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispStreamProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_STREAM_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispConnectProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_CONNECT_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispTimerProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_TIMER_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WispAsyncProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_ASYNC_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- The BCL compatibility probe (App/Compat.cs). -->
  <PropertyGroup Condition="'$(WispCompatProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_COMPAT_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- The clone-uniqueness probe (App/Entropy.cs). Off by default. -->
  <PropertyGroup Condition="'$(WispEntropyProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);WISP_ENTROPY_PROBE</DefineConstants>
  </PropertyGroup>

</Project>
