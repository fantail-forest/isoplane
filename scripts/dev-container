#!/usr/bin/env bash
# Run a development command in an automatically removed Compose container.
set -euo pipefail
export DEV_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DEV_UID="$(id -u)" DEV_GID="$(id -g)"
export DEV_GIT="$(git -C "$DEV_ROOT" rev-parse --path-format=absolute --git-common-dir)"
tree="$(printf '%s' "$DEV_ROOT" | shasum -a 256 | cut -c1-12)"
compose=(docker compose -f "$DEV_ROOT/compose.dev.yml" -p "isoplane-$DEV_UID-$tree")
case "${1:-}" in
  --build) exec "${compose[@]}" build ;;
  --stop) exec "${compose[@]}" down ;;
  --status) exec "${compose[@]}" ps --all ;;
  --reap) exec "${compose[@]}" rm --force ;;
esac
options=(--rm)
[ -t 0 ] || options+=(-T)
for variable in "${!ISOPLANE_@}"; do
  [ "$variable" != ISOPLANE_PORTS ] || continue
  options+=(-e "$variable=${!variable}")
done
for port in ${ISOPLANE_PORTS:-}; do options+=(-p "$port"); done
[ $# -gt 0 ] || set -- bash
exec "${compose[@]}" run "${options[@]}" toolchain task --dir "$DEV_ROOT" exec -- "$@"
