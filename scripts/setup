#!/usr/bin/env bash
# Bootstrap Task, then install the repository's development tools.
set -euo pipefail
if ! command -v task >/dev/null; then
  curl --fail --location https://taskfile.dev/install.sh | sh -s -- -b "$HOME/.local/bin" v3.53.1
  export PATH="$HOME/.local/bin:$PATH"
fi
cd "$(dirname "${BASH_SOURCE[0]}")/.."
exec task setup
