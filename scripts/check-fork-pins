#!/usr/bin/env bash
# Check that every fork commit this checkout pins is on that fork's
# isoplane-revisions branch: scripts/check-fork-pins [--base COMMIT] [--status SHA]
# COMMIT is the base branch the checkout merges into; a pin it shares with
# that base is reported as the base's to move. Fails when a pin has not landed
# or it could not tell. In a GitHub Actions run, --status posts the result as
# the fork-pins commit status of SHA instead, pending while a pin has not
# landed, and fails only when it could not tell. Needs a signed-in GitHub CLI.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# shellcheck source=scripts/fork-pins.sh
source scripts/fork-pins.sh

base=""
status_commit=""
while [ "$#" -gt 0 ]; do
  case "$1:$#" in
    --base:1) echo "--base needs a commit." >&2; exit 2 ;;
    --base:*) base=$2; shift 2 ;;
    --status:1) echo "--status needs a commit." >&2; exit 2 ;;
    --status:*) status_commit=$2; shift 2 ;;
    *)
      echo "Usage: $0 [--base COMMIT] [--status SHA]" >&2
      exit 2 ;;
  esac
done

pins=$(fork_pins)
base_pins=""
move_command="scripts/move-fork-pins --commit"
if [ -n "$base" ]; then
  base_pins=$(fork_pins "$base")
  move_command+=" --since \"\$(git merge-base HEAD $(git rev-parse "$base^{commit}"))\""
fi
unlanded=()
undetermined=0
while read -r fork location revision; do
  if ! status=$(trunk_status "$fork" "$revision"); then
    echo "$fork: could not compare $revision with $trunk; the fork may not have that commit." >&2
    undetermined=1
    continue
  fi
  case "$status" in
    identical|behind)
      echo "$fork: $revision is on $trunk." >&2
      continue ;;
    ahead|diverged) ;;
    *)
      echo "$fork: unexpected comparison of $revision with $trunk: $status" >&2
      undetermined=1
      continue ;;
  esac
  # Wasmtime can have more than one pin.
  [[ " ${unlanded[*]} " == *" $fork "* ]] || unlanded+=("$fork")
  if grep --quiet --fixed-strings --line-regexp "$fork $location $revision" <<<"$base_pins"; then
    echo "$fork: $revision is not on $trunk, and the base branch pins it too, so the pull request lower in the stack that changed the pin moves it. This pull request takes the move when the stack is rebased, for example with gh stack rebase and gh stack push." >&2
    continue
  fi
  # A failed lookup has already printed why, and the pin is reported as unlanded either way.
  landed=$(landed_pull_request "$fork" "$revision") || landed=""
  if [ -n "$landed" ]; then
    read -r number commit <<<"$landed"
    echo "$fork: $revision is not on $trunk, but pull request #$number, whose head it is, landed there as $commit. Move the pin to that commit: $move_command" >&2
  elif [ "$status" = ahead ]; then
    echo "$fork: $revision is not on $trunk. Merge its fork pull request; the pin then moves to the merged commit." >&2
  else
    echo "$fork: $revision has diverged from $trunk. Rebase its branch onto the fork's $trunk and pin the rebased commit." >&2
  fi
done <<<"$pins"
if [ "$undetermined" = 1 ]; then
  state=error description="Could not tell whether the fork pins have landed."
elif [ "${#unlanded[@]}" -gt 0 ]; then
  # Names alone keep the four forks within the 140 characters GitHub allows a status description.
  printf -v summary '%s, ' "${unlanded[@]}"
  state=pending description="Not on $trunk: ${summary%, }"
else
  state=success description="Every fork pin is on $trunk."
fi
echo "$description"
if [ -z "$status_commit" ]; then
  [ "$state" = success ]
else
  gh api "repos/$GITHUB_REPOSITORY/statuses/$status_commit" --silent \
    -f state="$state" -f context=fork-pins -f description="$description" \
    -f target_url="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
  [ "$state" != error ]
fi
