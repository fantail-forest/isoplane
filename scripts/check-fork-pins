#!/usr/bin/env bash
# Fail unless every fork commit this checkout pins is on that fork's
# isoplane-revisions branch: scripts/check-fork-pins
# Needs a signed-in GitHub CLI.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# shellcheck source=scripts/fork-pins.sh
source scripts/fork-pins.sh

pins=$(fork_pins)
unlanded=0
while read -r fork _ revision; do
  if ! status=$(trunk_status "$fork" "$revision"); then
    echo "$fork: could not compare $revision with $trunk; the fork may not have that commit." >&2
    unlanded=1
    continue
  fi
  case "$status" in
    identical|behind)
      echo "$fork: $revision is on $trunk."
      continue ;;
    ahead|diverged) ;;
    *)
      echo "$fork: unexpected comparison of $revision with $trunk: $status" >&2
      unlanded=1
      continue ;;
  esac
  unlanded=1
  # A failed lookup has already printed why, and the pin is reported as unlanded either way.
  landed=$(landed_pull_request "$fork" "$revision") || landed=""
  if [ -n "$landed" ]; then
    read -r number commit <<<"$landed"
    echo "$fork: $revision is not on $trunk, but pull request #$number, whose head it is, landed there as $commit. Move the pin to that commit: scripts/move-fork-pins --commit" >&2
  elif [ "$status" = ahead ]; then
    echo "$fork: $revision is not on $trunk. Merge its fork pull request; the pin then moves to the merged commit." >&2
  else
    echo "$fork: $revision has diverged from $trunk. Rebase its branch onto the fork's $trunk and pin the rebased commit." >&2
  fi
done <<<"$pins"
exit "$unlanded"
