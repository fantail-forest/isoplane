#!/usr/bin/env python3
"""Build once and run Rust test binaries concurrently: scripts/dev scripts/test."""

import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import json
import importlib.util
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
SPEC = importlib.util.spec_from_file_location("build_storage", ROOT / "scripts/build_storage.py")
storage = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(storage)

# Docker startup contention can consume the process tests' deliberate kill deadlines.
EXCLUSIVE_BINARIES = {"isoplane-prepare/process"}


def execution_batches(binaries, name):
    exclusive = [[binary] for binary in binaries if name(binary) in EXCLUSIVE_BINARIES]
    shared = [binary for binary in binaries if name(binary) not in EXCLUSIVE_BINARIES]
    return [*exclusive, shared]



def binary_environment(name, environment):
    result = dict(environment)
    if name in EXCLUSIVE_BINARIES:
        result["RUST_TEST_THREADS"] = "1"
    return result


def require_guest_tools(environment):
    try:
        sdk = subprocess.run(["dotnet", "--version"], cwd=ROOT, env=environment,
                             capture_output=True, text=True, timeout=30)
    except FileNotFoundError as error:
        raise RuntimeError("The test suite needs the pinned .NET SDK. Run scripts/setup, then scripts/dev scripts/test.") from error
    if sdk.returncode:
        raise RuntimeError("The repository's .NET SDK is unavailable. Run scripts/setup, then scripts/dev scripts/test.\n"
                           + sdk.stdout + sdk.stderr)
    wasi = environment.get("WASI_SDK_PATH", "")
    if not wasi or not (Path(wasi) / "bin/clang").is_file():
        raise RuntimeError("The test suite needs the WASI compiler. Build the guest-runtime toolchain, then run scripts/dev scripts/test.")


def run(command, cwd, environment, log, timeout_seconds):
    started = time.monotonic()
    with log.open("w") as output:
        with subprocess.Popen(command, cwd=cwd, env=environment, stdout=output,
                              stderr=subprocess.STDOUT, start_new_session=True) as process:
            try:
                code = process.wait(timeout=timeout_seconds)
            except subprocess.TimeoutExpired:
                if os.name == "nt":
                    subprocess.run(["taskkill", "/PID", str(process.pid), "/T", "/F"],
                                   stdout=output, stderr=subprocess.STDOUT, check=True)
                else:
                    os.killpg(process.pid, signal.SIGKILL)
                process.wait()
                output.write(f"\nTest process exceeded {timeout_seconds}s; its process group was stopped.\n")
                code = 124
    return {"code": code, "seconds": time.monotonic() - started, "log": str(log)}


def test_binaries(messages):
    binaries = {}
    library_paths = set()
    for message in messages:
        if message.get("reason") == "build-script-executed":
            library_paths.update(path.split("=", 1)[-1] for path in message["linked_paths"])
        if (message.get("reason") == "compiler-artifact"
                and message["profile"]["test"] and message["executable"]):
            binary = message["executable"]
            binaries[binary] = message
            library_paths.add(str(Path(binary).parent))
    return list(binaries.values()), library_paths


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    cpus = os.cpu_count() or 1
    parser.add_argument("--jobs", type=int, default=min(8, max(1, cpus // 4)))
    parser.add_argument("--test-threads", type=int,
                        default=int(os.environ.get("RUST_TEST_THREADS", "4")))
    parser.add_argument("--timeout-seconds", type=int, default=600)
    parser.add_argument("-p", "--package", action="append", default=[])
    parser.add_argument("--exclude-binary", action="append", default=[], metavar="PACKAGE/TARGET")
    args = parser.parse_args()
    if min(args.jobs, args.test_threads, args.timeout_seconds) < 1:
        parser.error("jobs, test threads and timeout must be positive")
    if not args.package:
        require_guest_tools(dict(os.environ))
    selection = [item for package in args.package for item in ("-p", package)] or ["--workspace"]
    metadata = json.loads(subprocess.check_output(
        ["cargo", "metadata", "--no-deps", "--format-version", "1"], cwd=ROOT))
    packages = {package["id"]: package for package in metadata["packages"]}
    runs = storage.diagnostics_root()
    with storage.retained_run(runs) as logs:
        return execute(args, parser, cpus, selection, packages, runs, logs)


def execute(args, parser, cpus, selection, packages, runs, logs):
    environment = dict(os.environ)
    environment["RUST_TEST_THREADS"] = str(args.test_threads)
    environment.setdefault("RAYON_NUM_THREADS", str(max(1, min(16, cpus // args.jobs))))
    started = time.monotonic()
    print(f"Logs: {logs}", flush=True)
    build = run(["cargo", "test", *selection, "--no-run", "--message-format=json"],
                ROOT, environment, logs / "build.log", args.timeout_seconds)
    if build["code"]:
        print(f"Build failed: {build['log']}", flush=True)
        return build["code"]
    messages = []
    for line in (logs / "build.log").read_text().splitlines():
        if line.startswith("{"):
            messages.append(json.loads(line))
    binaries, library_paths = test_binaries(messages)
    if not binaries:
        raise RuntimeError("Cargo produced no test binaries")
    library_paths.add(subprocess.check_output(
        ["rustc", "--print", "target-libdir"], cwd=ROOT, text=True).strip())
    variable = {"darwin": "DYLD_FALLBACK_LIBRARY_PATH", "win32": "PATH"}.get(sys.platform, "LD_LIBRARY_PATH")
    environment[variable] = os.pathsep.join(sorted(library_paths) + [environment.get(variable, "")])
    history_path = runs / "durations.json"
    history = json.loads(history_path.read_text()) if history_path.exists() else {}

    def name(binary):
        return f"{packages[binary['package_id']]['name']}/{binary['target']['name']}"

    unknown = set(args.exclude_binary) - {name(binary) for binary in binaries}
    if unknown:
        parser.error(f"unknown excluded binaries: {', '.join(sorted(unknown))}")
    binaries = [binary for binary in binaries if name(binary) not in args.exclude_binary]
    for excluded in args.exclude_binary:
        print(f"Explicitly excluded: {excluded}", flush=True)
    # Preserve one process per binary so its shared fixture setup remains shared.
    binaries.sort(key=lambda binary: (history.get(name(binary), 0),
                                     "test" in binary["target"]["kind"],
                                     Path(binary["executable"]).stat().st_size), reverse=True)
    if any(dependency['name'] == 'isoplane-fixtures'
           for binary in binaries
           for dependency in packages[binary['package_id']]['dependencies']):
        preparation = run([sys.executable, str(ROOT / "scripts/prepare-fixtures.py")],
                          ROOT, environment, logs / "fixtures.log", max(3600, args.timeout_seconds))
        if preparation["code"]:
            print(f"Fixture preparation failed: {preparation['log']}", flush=True)
            return preparation["code"]
    print(f"Running {len(binaries)} binaries, {args.jobs} at a time, "
          f"{args.test_threads} test threads each", flush=True)
    results = []
    indexed = {binary["executable"]: index for index, binary in enumerate(binaries)}
    with ThreadPoolExecutor(max_workers=args.jobs) as executor:
        for batch in execution_batches(binaries, name):
            pending = {}
            for binary in batch:
                index = indexed[binary["executable"]]
                package = packages[binary["package_id"]]
                cwd = Path(package["manifest_path"]).parent
                future = executor.submit(run, [binary["executable"]], cwd, binary_environment(name(binary), environment),
                                         logs / f"{index:03d}-{binary['target']['name']}.log",
                                         args.timeout_seconds)
                pending[future] = name(binary)
            for future in as_completed(pending):
                result = {"name": pending[future], **future.result()}
                results.append(result)
                history[result["name"]] = result["seconds"]
                status = "PASS" if result["code"] == 0 else "FAIL"
                print(f"{status} {result['name']} {result['seconds']:.2f}s", flush=True)
                if result["code"]:
                    print(f"  {result['log']}", flush=True)
    docs = run(["cargo", "test", *selection, "--doc"], ROOT, environment,
               logs / "doctests.log", args.timeout_seconds)
    results.append({"name": "doctests", **docs})
    elapsed = time.monotonic() - started
    summary = {"seconds": elapsed, "build": build, "excluded": args.exclude_binary,
               "results": results}
    (logs / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
    with tempfile.NamedTemporaryFile(mode="w", dir=runs, delete=False) as output:
        json.dump(history, output)
    Path(output.name).replace(history_path)
    failures = sum(result["code"] != 0 for result in results)
    print(f"Finished in {elapsed:.2f}s including build and doctests; "
          f"{failures} failing binaries. Summary: {logs / 'summary.json'}", flush=True)
    return int(failures != 0)


if __name__ == "__main__":
    with storage.development(ROOT, os.environ) as environment:
        os.environ.update(environment)
        raise SystemExit(main())
