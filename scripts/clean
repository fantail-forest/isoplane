#!/usr/bin/env bash
# Reclaim build intermediates.
#
#   scripts/clean            # caches and intermediates only, no rebuild
#   scripts/clean --all      # everything, including compiled output
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

before=$(du -sm . | cut -f1)

JUNK=(target/debug/incremental target/release/incremental
      guests/target guests/dotnet/src/obj guests/dotnet/src/bin
      guests/dotnet/obj
      guest-sdks/dotnet/obj guest-sdks/dotnet/bin)

rm -rf "${JUNK[@]}"
find . -name '*.rs.bk' -delete

if [ "${1:-}" = "--all" ]; then
  cargo clean
fi

after=$(du -sm . | cut -f1)
echo "project: ${before} MB -> ${after} MB  (freed $((before - after)) MB)"
df -h / | tail -1
