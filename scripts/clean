#!/usr/bin/env bash
# Reclaim inactive managed build storage; report other generated directories.
set -euo pipefail
usage() { printf 'Usage: scripts/clean [--all] [--dry-run | --report]\nReclaim managed caches; --all clears inactive entries regardless of age or size.\nUnleased and legacy output is reported, never removed while its ownership is unknown.\n'; }
for argument in "$@"; do
  case "$argument" in
    --all|--dry-run|--report) ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
exec python3 "$(dirname "${BASH_SOURCE[0]}")/clean.py" "$@"
