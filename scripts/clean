#!/usr/bin/env bash
# Reclaim build artifacts. Rust build trees for a workspace containing
# wasmtime get very large very fast, so this is worth running between phases
# of work rather than only at the end.
#
#   scripts/clean            # cheap: caches and intermediates only, no rebuild
#   scripts/clean --all      # everything, including compiled output
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

before=$(du -sm . 2>/dev/null | cut -f1)

# Always safe: pure caches and intermediates. Nothing here is an input to
# anything; the worst case is a slower next build.
rm -rf target/debug/incremental target/release/incremental
rm -rf guests/target guests/dotnet/src/obj guests/dotnet/src/bin
rm -rf crates/spike/target
find . -name '*.rs.bk' -delete 2>/dev/null || true

if [ "${1:-}" = "--all" ]; then
  # A container build can leave a root-owned target that the host user cannot
  # remove; delete it from inside the container, where we are root.
  if [ -d target ] && [ ! -w target ]; then
    "$ROOT/scripts/dev" rm -rf /wisp/target
  else
    cargo clean 2>/dev/null || rm -rf target
  fi
fi

after=$(du -sm . 2>/dev/null | cut -f1)
echo "project: ${before} MB -> ${after} MB  (freed $((before - after)) MB)"
df -h / | tail -1
