#!/usr/bin/env python3
"""Run a local development command: scripts/dev [--container] [command ...]"""

import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent


def main():
    args = sys.argv[1:]
    if args and args[0] == "--container":
        os.execv(str(ROOT / "scripts/dev-container"), ["dev-container", *args[1:]])
    if args and args[0] in ("--help", "-h"):
        print(__doc__)
        print("Commands inherit your environment and run in the repository root.")
        return
    if args and args[0] == "--":
        args.pop(0)
    args = args or [os.environ.get("SHELL", "/bin/bash")]
    os.chdir(ROOT)
    os.environ["PATH"] = str(ROOT / ".wisp-dev/tools/bin") + os.pathsep + os.environ.get("PATH", os.defpath)
    os.execvp(args[0], args)


if __name__ == "__main__":
    main()
