[Unit]
Description=Isoplane application host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isoplane
Group=isoplane
WorkingDirectory=/var/lib/isoplane
ExecStart=/opt/isoplane/current/isoplaned serve --config /etc/isoplane/node.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
