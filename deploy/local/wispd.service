[Unit]
Description=Isoplane cell node
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=wisp
Group=wisp
SupplementaryGroups=docker
WorkingDirectory=/var/lib/wisp
EnvironmentFile=/etc/wisp/node.env
ExecStart=/opt/wisp/current/wispd --config /etc/wisp/node.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
