<Project Sdk="Microsoft.NET.Sdk">
  <!-- Evaluated by task setup:workload. Installing an SDK can replace the workload manifests without
       installing the packs they name; dotnet workload list still lists the workload, and the guest
       build then fails to load these task assemblies. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <Target Name="RequireWorkloadPacks">
    <ItemGroup>
      <_WorkloadTaskAssembly Include="MonoTargetsTasksAssemblyPath" Path="$(MonoTargetsTasksAssemblyPath)" />
      <_WorkloadTaskAssembly Include="WasmAppBuilderTasksAssemblyPath" Path="$(WasmAppBuilderTasksAssemblyPath)" />
    </ItemGroup>
    <Error Condition="'%(_WorkloadTaskAssembly.Path)' == '' OR !Exists('%(_WorkloadTaskAssembly.Path)')"
           Text="The wasi-experimental workload packs do not match the installed manifests of SDK $(NETCoreSdkVersion): %(_WorkloadTaskAssembly.Identity) is '%(_WorkloadTaskAssembly.Path)'." />
  </Target>
</Project>
