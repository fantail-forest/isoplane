<Project>
  <Target Name="StageProject">
    <ItemGroup>
      <ProjectFile Include="$(Directory)/*.csproj" />
    </ItemGroup>
    <XslTransformation XmlInputPaths="@(ProjectFile)" XslInputPath="$(MSBuildThisFileDirectory)Scenario.xslt"
                       OutputPaths="@(ProjectFile->'%(Identity).staged')"
                       Parameters="&lt;Parameter Name='Root' Value='$(Root)' /&gt;" />
    <Move SourceFiles="@(ProjectFile->'%(Identity).staged')" DestinationFiles="@(ProjectFile)" />
  </Target>
</Project>
