<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Workload SDK assemblies are executable tools, not project references. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NuspecFile>$(MSBuildThisFileDirectory)Toolchain.nuspec</NuspecFile>
    <NuspecProperties>platform=$(Platform);version=$(Version);stage=$(StageDirectory)</NuspecProperties>
  </PropertyGroup>
</Project>
