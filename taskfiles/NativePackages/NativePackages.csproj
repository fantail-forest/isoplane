<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking Condition="'$(PackageId)' == 'Isoplane.Cli'">true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <Description>Isoplane local application development using the shared WASM runtime.</Description>
    <PackageType Condition="'$(PackageId)' == 'Isoplane.Cli'">DotnetTool</PackageType>
  </PropertyGroup>
  <Import Project="../NativeAssets.props" />
  <Import Project="../../licenses/SdkPackage.props" />
  <ItemGroup>
    <None Condition="'$(NoticesDirectory)' != ''" Include="$(NoticesDirectory)/**/*" Pack="true" PackagePath="notices/" />
    <None Include="../../tools/$(PackageId)/PackageReadme.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageId)' == 'Isoplane.Cli'">
    <None Include="$(ManagedDirectory)/publish/Isoplane.Cli/release/**/*" Pack="true" PackagePath="tools/net10.0/any/" />
    <None Include="$(ManagedDirectory)/obj/Isoplane.Cli/release/DotnetToolSettings.xml" Pack="true" PackagePath="tools/net10.0/any/" />
    <None Include="@(IsoplaneNativeAsset)" Pack="true" PackagePath="tools/net10.0/any/runtime/" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageId)' == 'Isoplane.Native'">
    <None Include="$(ManagedDirectory)/bin/Isoplane.Native/release/Isoplane.Native.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="@(IsoplaneNativeAsset)" Pack="true" PackagePath="runtimes/%(RuntimeIdentifier)/native/" />
  </ItemGroup>
  <Target Name="ValidatePreparedPackage" BeforeTargets="_GetPackageFiles">
    <Error Condition="!Exists('$(NoticesDirectory)/rust-dependencies.json') OR !Exists('$(NoticesDirectory)/managed-dependencies.json')" Text="Run task notices and supply NoticesDirectory before packing." />
    <Error Condition="'$(PackageId)' != 'Isoplane.Native' AND '$(PackageId)' != 'Isoplane.Cli'" Text="Select Isoplane.Native or Isoplane.Cli with PackageId." />
    <Error Condition="!Exists('$(ManagedDirectory)/bin/$(PackageId)/release/$(PackageId).dll')" Text="Run task managed:build on Linux before packing." />
    <Error Condition="'@(IsoplaneNativeAsset)' == ''" Text="Supply IsoplaneNativePath or IsoplaneNativeRoot with prepared native libraries." />
  </Target>
</Project>
