<Project>
  <ItemGroup Condition="'$(IsoplaneNativeRoot)' != ''">
    <IsoplaneNativeAsset Include="$(IsoplaneNativeRoot)/linux-x64/native/release/libisoplane_native.so" RuntimeIdentifier="linux-x64" />
    <IsoplaneNativeAsset Include="$(IsoplaneNativeRoot)/osx-arm64/native/release/libisoplane_native.dylib" RuntimeIdentifier="osx-arm64" />
    <IsoplaneNativeAsset Include="$(IsoplaneNativeRoot)/win-x64/native/release/isoplane_native.dll" RuntimeIdentifier="win-x64" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsoplaneNativePath)' != ''">
    <IsoplaneNativeAsset Include="$(IsoplaneNativePath)" RuntimeIdentifier="$(IsoplaneNativeRid)" />
  </ItemGroup>
  <Target Name="ValidateNativeAssets" BeforeTargets="_GetPackageFiles" Condition="'@(IsoplaneNativeAsset)' != ''">
    <Error Condition="!Exists('%(IsoplaneNativeAsset.Identity)')" Text="Build the native library before packing: %(IsoplaneNativeAsset.Identity)" />
  </Target>
</Project>
