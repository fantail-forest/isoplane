<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Isoplane.Testing</PackageId>
    <Version>0.1.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Integration-test ownership of real Isoplane CLI development sessions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ProcessOwnership/OwnedProcess.cs" Link="OwnedProcess.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Isoplane.Testing.Tests" />
  </ItemGroup>
</Project>
