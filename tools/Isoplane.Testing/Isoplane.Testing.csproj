<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Isoplane.Testing</PackageId>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <Description>Integration-test ownership of real Isoplane CLI development sessions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Isoplane.Native/Isoplane.Native.csproj" />
    <Compile Include="../Isoplane.Cli/TelemetryVariables.cs" Link="TelemetryVariables.cs" />
    <None Include="PackageReadme.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Isoplane.Testing.Tests" />
  </ItemGroup>
  <Import Project="../../licenses/SdkPackage.props" />
</Project>
