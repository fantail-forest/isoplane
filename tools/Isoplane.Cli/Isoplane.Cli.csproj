<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>isoplane</ToolCommandName>
    <PackageId>Isoplane.Cli</PackageId>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <Description>Isoplane local application development using the shared WASM runtime.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../BuildProtocol/DebugSessionProtocol.cs" Link="DebugSessionProtocol.cs" />
    <ProjectReference Include="../Isoplane.Native/Isoplane.Native.csproj" />
    <ProjectReference Include="../Isoplane.Debugging/Isoplane.Debugging.csproj" />
    <Compile Include="../BuildProtocol/ManagedApplication.cs" Link="ManagedApplication.cs" />
    <Compile Include="../BuildProtocol/AssemblyClosure.cs" Link="AssemblyClosure.cs" />
    <Compile Include="../BuildProtocol/BuildDiagnostics.cs" Link="BuildDiagnostics.cs" />
    <Compile Include="../BuildProtocol/ApplicationEntryDiscovery.cs" Link="ApplicationEntryDiscovery.cs" />
    <Compile Include="../BuildProtocol/AssetPaths.cs" Link="AssetPaths.cs" />
    <InternalsVisibleTo Include="Isoplane.Cli.Tests" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <None Include="PackageReadme.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../taskfiles/NativeAssets.props" />
  <ItemGroup>
    <None Include="@(IsoplaneNativeAsset)" Pack="true" PackagePath="tools/$(TargetFramework)/any/runtime/" />
  </ItemGroup>
  <Import Project="../../licenses/SdkPackage.props" />
</Project>
