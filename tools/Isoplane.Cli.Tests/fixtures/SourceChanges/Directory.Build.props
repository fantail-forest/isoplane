<Project>
  <PropertyGroup>
    <CustomBeforeMicrosoftCommonTargets>$(MSBuildThisFileDirectory)BuildInputs.targets</CustomBeforeMicrosoftCommonTargets>
    <TargetFramework>net10.0</TargetFramework>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
