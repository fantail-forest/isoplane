<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="fixtures/**/*.cs" />
    <EmbeddedResource Remove="fixtures/**/*" />
    <Compile Include="../TestSupport/FileSystemTestDirectory.cs" Link="FileSystemTestDirectory.cs" />
    <Compile Include="../TestSupport/PosixTheoryAttribute.cs" Link="PosixTheoryAttribute.cs" />
    <Compile Include="../TestSupport/PosixFactAttribute.cs" Link="PosixFactAttribute.cs" />
    <Compile Include="../TestSupport/TemporaryFilePermissions.cs" Link="TemporaryFilePermissions.cs" />
    <None Include="../../guest-sdks/dotnet/Build/Isoplane.ManagedBundle.targets" Link="Isoplane.ManagedBundle.targets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../TelemetryProtocol/*.json" Link="TelemetryProtocol/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <ProjectReference Include="../Isoplane.Cli/Isoplane.Cli.csproj" />
  </ItemGroup>
</Project>
