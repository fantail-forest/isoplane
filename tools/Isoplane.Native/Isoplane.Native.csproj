<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Generated managed bindings and native local development support for Isoplane.</Description>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <NativeLibraryName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libisoplane_native.so</NativeLibraryName>
    <NativeLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libisoplane_native.dylib</NativeLibraryName>
    <NativeLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">isoplane_native.dll</NativeLibraryName>
  </PropertyGroup>
  <Import Project="../../taskfiles/NativeAssets.props" />
  <ItemGroup>
    <None Include="PackageReadme.md" Pack="true" PackagePath="/" />
    <None Include="@(IsoplaneNativeAsset)" Pack="true" PackagePath="runtimes/%(RuntimeIdentifier)/native/" />
    <InternalsVisibleTo Include="Isoplane.Cli" />
    <InternalsVisibleTo Include="Isoplane.Cli.Tests" />
    <InternalsVisibleTo Include="Isoplane.Testing" />
    <InternalsVisibleTo Include="Isoplane.Testing.Tests" />
  </ItemGroup>
  <Target Name="RequireNativeLibrary" BeforeTargets="PrepareForBuild;_GetPackageFiles" Condition="'$(IsoplaneManagedOnly)' != 'true' AND '$(IsoplaneNativeRoot)' == ''">
    <Error Condition="!Exists('$(IsoplaneNativePath)')" Text="Run task native, then supply -p:IsoplaneNativePath with the prepared library, or use task cli." />
    <ItemGroup>
      <None Include="$(IsoplaneNativePath)" Link="runtime/$(NativeLibraryName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Import Project="../../licenses/SdkPackage.props" />
</Project>
