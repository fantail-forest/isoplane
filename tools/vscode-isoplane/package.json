{
  "name": "isoplane",
  "displayName": "Isoplane",
  "description": "Build and debug your Isoplane .NET APIs without leaving VS Code.",
  "version": "0.1.0",
  "publisher": "Isoplane",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onDebug:isoplane",
    "onDebugResolve:dotnet",
    "onDebugResolve:coreclr"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "debuggers": [
      {
        "type": "isoplane",
        "label": "Isoplane",
        "languages": [
          "csharp"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "port"
            ],
            "properties": {
              "port": {
                "type": "number",
                "minimum": 1,
                "maximum": 65535,
                "description": "Debugger port printed by the local Isoplane debug session."
              },
              "cliPath": {
                "type": "string",
                "default": "isoplane",
                "description": "Path to the Isoplane CLI executable or assembly (.dll)."
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Map source directories recorded by the compiler to absolute local directories."
              }
            }
          },
          "launch": {
            "required": [
              "project"
            ],
            "properties": {
              "project": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Directory containing the Isoplane application project."
              },
              "configuration": {
                "type": "string",
                "default": "Debug",
                "description": "MSBuild configuration to compile for debugging."
              },
              "watch": {
                "type": "boolean",
                "default": true,
                "description": "Rebuild source edits for the next request while keeping the debugger attached."
              },
              "port": {
                "type": "number",
                "minimum": 0,
                "maximum": 65535,
                "description": "HTTP listener port. Use 0 to select an available port."
              },
              "cliPath": {
                "type": "string",
                "default": "isoplane",
                "description": "Path to the Isoplane CLI executable or assembly (.dll)."
              },
              "console": {
                "type": "string",
                "enum": [
                  "integratedTerminal",
                  "internalConsole"
                ],
                "default": "integratedTerminal",
                "description": "The integrated terminal keeps the application running after debugger detach; Ctrl+C stops it."
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Map source directories recorded by the compiler to absolute local directories."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "isoplane",
            "request": "launch",
            "name": "Debug local Isoplane",
            "project": "${workspaceFolder}",
            "configuration": "Debug"
          },
          {
            "type": "isoplane",
            "request": "attach",
            "name": "Attach to local Isoplane",
            "port": "${command:isoplane.debugPort}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Isoplane: launch local application",
            "body": {
              "type": "isoplane",
              "request": "launch",
              "name": "Debug local Isoplane",
              "project": "${workspaceFolder}",
              "configuration": "Debug"
            }
          },
          {
            "label": "Isoplane: attach to local guest",
            "body": {
              "type": "isoplane",
              "request": "attach",
              "name": "Attach to local Isoplane",
              "port": "^\"${command:isoplane.debugPort}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "isoplane.detach",
        "title": "Isoplane: Disconnect and Keep Running",
        "icon": "$(debug-disconnect)",
        "enablement": "debugType == isoplane && inDebugMode"
      },
      {
        "command": "isoplane.applyCodeChanges",
        "title": "Isoplane: Apply Code Changes",
        "icon": "$(debug-restart)",
        "enablement": "debugType == isoplane && inDebugMode"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "command": "isoplane.detach",
          "when": "debugType == isoplane && inDebugMode",
          "group": "navigation@71"
        },
        {
          "command": "isoplane.applyCodeChanges",
          "when": "debugType == isoplane && inDebugMode",
          "group": "navigation@70"
        }
      ]
    }
  },
  "scripts": {
    "test": "node test/run.js",
    "test:launch": "node test/run.js launch",
    "package": "vsce package --out out/ --allow-missing-repository",
    "prepackage": "node -e \"const fs=require('node:fs'); fs.mkdirSync('out',{recursive:true}); fs.copyFileSync('../../licenses/Isoplane-SDK-LICENSE.txt','LICENSE.txt')\""
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  },
  "icon": "icon.png",
  "homepage": "https://isoplane.dev",
  "keywords": [
    "isoplane",
    "dotnet",
    "csharp",
    "debugging",
    "webassembly"
  ]
}
