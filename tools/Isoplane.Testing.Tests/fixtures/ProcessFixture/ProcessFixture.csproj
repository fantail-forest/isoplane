<Project>
  <PropertyGroup>
    <_IsoplaneFixtureArtifactsName>managed-fixtures</_IsoplaneFixtureArtifactsName>
  </PropertyGroup>
  <Import Project="../../../../taskfiles/ManagedFixture.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
