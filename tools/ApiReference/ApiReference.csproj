<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Generates and checks the customer SDK reference: the API from assemblies and XML documentation, and the settings, template, error code and telemetry pages from the build files, launch profile keys, debugger manifest, template definitions, diagnostics and event schema that define them; and the release that added each documented item, recorded when the docs are snapshotted for a release.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="XmlDocMarkdown.Core" Version="2.9.0" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
    <ProjectReference Include="../../guest-sdks/dotnet/Isoplane.Sdk.csproj" />
    <ProjectReference Include="../../guest-sdks/dotnet/AspNetCore/Isoplane.AspNetCore.csproj" />
    <ProjectReference Include="../../guest-sdks/dotnet/AspNetCore.DataProtection.EntityFrameworkCore/Isoplane.AspNetCore.DataProtection.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../guest-sdks/dotnet/OpenTelemetry/Isoplane.OpenTelemetry.csproj" />
    <ProjectReference Include="../Isoplane.Testing/Isoplane.Testing.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../../guest-sdks/dotnet/Build/Isoplane.Conformance.targets" LogicalName="Isoplane.Conformance.targets" />
    <EmbeddedResource Include="../../guest-sdks/dotnet/Build/Isoplane.AgentSkill.targets" LogicalName="Isoplane.AgentSkill.targets" />
    <EmbeddedResource Include="../vscode-isoplane/package.json" LogicalName="vscode-isoplane.package.json" />
    <Compile Include="../Isoplane.Cli/LaunchProfileKeys.cs" Link="LaunchProfileKeys.cs" />
    <Compile Include="../BuildProtocol/BuildDiagnostics.cs" Link="BuildDiagnostics.cs" />
    <Compile Include="../Isoplane.Cli/TelemetryVariables.cs" Link="TelemetryVariables.cs" />
    <Compile Include="../Isoplane.Cli/CliCommandLine.cs" Link="CliCommandLine.cs" />
    <Compile Include="../Isoplane.Cli/AgentHarness.cs" Link="AgentHarness.cs" />
    <Compile Include="../Isoplane.Cli/AgentToolCatalogue.cs" Link="AgentToolCatalogue.cs" />
    <Compile Include="../Isoplane.Cli/ShellCompletions.cs" Link="ShellCompletions.cs" />
    <EmbeddedResource Include="../TelemetryProtocol/command-event.schema.json" LogicalName="command-event.schema.json" />
    <EmbeddedResource Include="../TelemetryProtocol/installation-event.schema.json" LogicalName="installation-event.schema.json" />
    <EmbeddedResource Include="ErrorCodes.md" LogicalName="ErrorCodes.md" />
    <EmbeddedResource Include="../../guest-sdks/dotnet/Templates/content/**/.template.config/template.json" LogicalName="Templates/%(RecursiveDir)template.json" />
    <EmbeddedResource Include="../../guest-sdks/dotnet/Templates/content/**/.template.config/dotnetcli.host.json" LogicalName="TemplateOptions/%(RecursiveDir)template.json" />
    <!-- Loads the analyzers to read the diagnostics they declare; the version is the one they are built against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <ProjectReference Include="../../guest-sdks/dotnet/Analyzers/Isoplane.Analyzers.csproj" />
  </ItemGroup>
</Project>
