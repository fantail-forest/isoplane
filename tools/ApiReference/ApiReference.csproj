<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Generates and checks the customer SDK API reference from assemblies and XML documentation.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="XmlDocMarkdown.Core" Version="2.9.0" />
    <ProjectReference Include="../../guest-sdks/dotnet/Isoplane.Sdk.csproj" />
    <ProjectReference Include="../../guest-sdks/dotnet/AspNetCore/Isoplane.AspNetCore.csproj" />
    <ProjectReference Include="../Isoplane.Testing/Isoplane.Testing.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
