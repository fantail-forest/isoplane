<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Generates and checks the customer SDK reference: the API from assemblies and XML documentation, and the settings pages from the build files, launch profile keys and debugger manifest that define them.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="XmlDocMarkdown.Core" Version="2.9.0" />
    <ProjectReference Include="../../guest-sdks/dotnet/Isoplane.Sdk.csproj" />
    <ProjectReference Include="../../guest-sdks/dotnet/AspNetCore/Isoplane.AspNetCore.csproj" />
    <ProjectReference Include="../Isoplane.Testing/Isoplane.Testing.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../../guest-sdks/dotnet/Build/Isoplane.Conformance.targets" LogicalName="Isoplane.Conformance.targets" />
    <EmbeddedResource Include="../vscode-isoplane/package.json" LogicalName="vscode-isoplane.package.json" />
    <Compile Include="../Isoplane.Cli/LaunchProfileKeys.cs" Link="LaunchProfileKeys.cs" />
  </ItemGroup>
</Project>
