# Copy to search/.env (ignored by Git) and fill in. Read by build-index.sh and
# serve.sh; nothing in production reads this file.

# The search-only key value, any long random string. build-index.sh bakes it
# into the index and deploy.sh sets it as the DOCS_SEARCH_KEY secret on Fly
# (nginx admits it) and on the Worker.
DOCS_SEARCH_KEY=

# Fireworks API key, for the model named in scraper.config.json. The index
# build embeds every section with it and the baked index carries it for
# embedding queries.
DOCS_SEARCH_EMBEDDING_API_KEY=

# Keyword-only index, for a build without a provider.
# DOCS_SEARCH_EMBEDDINGS=off
