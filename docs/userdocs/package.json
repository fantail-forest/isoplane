{
  "name": "isoplane-userdocs",
  "version": "0.1.0",
  "private": true,
  "description": "Isoplane customer development guides",
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1 --port 3123",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3123",
    "clear": "docusaurus clear",
    "generate:reference": "dotnet run --project ../../tools/ApiReference -p:IsoplaneManagedOnly=true -- docs/reference",
    "check:reference": "dotnet run --project ../../tools/ApiReference -p:IsoplaneManagedOnly=true -- docs/reference --check",
    "prebuild": "pnpm run check:reference"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "packageManager": "pnpm@12.11.2"
}
