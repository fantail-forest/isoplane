{
  "name": "isoplane-userdocs",
  "version": "0.1.0",
  "private": true,
  "description": "Isoplane customer development guides",
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1 --port 3123 --no-open",
    "build": "docusaurus clear && docusaurus build --out-dir build/docs",
    "serve": "docusaurus serve --dir build/docs --host 127.0.0.1 --port 3123",
    "test": "node --test",
    "deploy:prod": "pnpm run build && pnpm run search:index && search/deploy.sh",
    "search:index": "search/build-index.sh",
    "search:serve": "search/serve.sh",
    "search:deploy": "search/deploy.sh",
    "clear": "docusaurus clear",
    "generate:reference": "dotnet run --project ../../tools/ApiReference -p:IsoplaneManagedOnly=true -- docs/reference --since since.json",
    "check:reference": "dotnet run --project ../../tools/ApiReference -p:IsoplaneManagedOnly=true -- docs/reference --since since.json --check",
    "prestart": "task --dir ../.. docs:limits",
    "prebuild": "task --dir ../.. docs:limits && pnpm run check:reference",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-theme-search-typesense": "^0.27.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "mdast-util-to-string": "4.0.0",
    "remark-directive": "3.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "semver": "7.8.5",
    "unified": "11.0.5",
    "wrangler": "4.149.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "^20.12.0 || >=21.7.0"
  },
  "packageManager": "pnpm@12.11.2"
}
