# Docusaurus build output and caches. All regenerated by `npm run build`.
/build
/.docusaurus
/.cache-loader

# Dependencies. `package-lock.json` IS committed: it pins the exact toolchain
# this site was built and verified against, and an unpinned float is a docs
# build that breaks on someone else's machine on a different day.
/node_modules

# Node / npm noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Local environment overrides
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
