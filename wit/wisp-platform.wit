// wisp:platform@1 — the capability world, in WIT.
//
// STATUS IN THIS PoC: nothing reads this file. It is the readable statement of
// the capability surface; the surface the code actually enforces is
// `wisp-abi::imports::IMPORTS`, which the validator, the linker and the guest
// SDKs all read. Where the two disagree, IMPORTS is what runs.
//
// They are not the same list. Every function below carries its core-ABI name
// and future class in an `ImportDef`, but nine imports have no counterpart
// here — `abort`, the four `init_*` pre-init interposers, the three `resp_*`
// response builders, and `service_call`. Those are ABI plumbing rather than
// capabilities, which is why they were never given WIT signatures. Nothing
// checks the correspondence: `ImportDef::wit` is a string a human typed.
//
// The prototype implements this world as a flat core-wasm ABI (module "wisp")
// rather than as a component, because pre-initialization (Wizer) and the
// copy-on-write template mapping both operate on a single core module with a
// single linear memory. Componentization would be a lowering change, not a
// semantics change.

package wisp:platform@1.0.0;

interface types {
    /// Host-side pending operation. Every potentially-slow import returns one
    /// of these immediately; there is no import that waits.
    type future-id = u64;

    /// Opaque host resource. The guest never holds a host pointer.
    type handle = u32;

    /// Declared per import; governs what happens to an in-flight future when
    /// the instance hibernates.
    enum future-class {
        /// Buffered host-side across hibernation; delivery on wake is lossless.
        bounded,
        /// Not preserved across hibernation; guest observes future-lost on wake.
        unbounded,
    }

    variant future-error {
        /// An unbounded future did not survive hibernation. Re-issue.
        future-lost(lost-reason),
        /// Dispatch CPU budget or an explicit deadline elapsed.
        timeout,
        /// The dispatch's implicit cancellation future completed.
        cancelled,
        /// Capability policy refused this call (e.g. SSRF guard).
        denied(string),
        /// Fencing epoch stale — this activation was deposed.
        fenced,
        not-found,
        io(string),
    }

    enum lost-reason { hibernated, evicted, cell-loss }

    record trace-context {
        trace-id: string,
        span-id: string,
        sampled: bool,
    }
}

interface clock {
    use types.{future-id};
    /// Millisecond granularity, monotonic per instance, and FROZEN for the
    /// duration of a dispatch slice — it advances only at host-call and wake
    /// boundaries. This removes the measurement primitive that Spectre-class
    /// attacks need.
    now-coarse: func() -> u64;
    /// Timers are host futures, never guest loops. Class: bounded.
    deadline-in: func(ms: u64) -> future-id;
}

interface entropy {
    /// Host CSPRNG, drawn per call. Host generator state stays outside captured
    /// guest memory. Guest code can retain returned bytes or its own PRNG state
    /// in a template.
    fill: func(len: u32) -> list<u8>;
}

interface http {
    use types.{future-id, handle};
    record request  { method: string, url: string, headers: list<tuple<string, string>>, body: list<u8> }
    record response { status: u16, headers: list<tuple<string, string>>, body-handle: handle }
    /// The ONLY outbound HTTP. SSRF policy is enforced host-side.
    /// Class: bounded (response head).
    fetch: func(req: request) -> future-id;
    /// Class: UNBOUNDED — a streaming body does not survive hibernation.
    read-body: func(h: handle, max: u32) -> future-id;
}

interface kv {
    use types.{future-id};
    get:    func(ns: string, key: string) -> future-id;          // bounded
    put:    func(ns: string, key: string, value: list<u8>, ttl-ms: option<u64>) -> future-id;
    delete: func(ns: string, key: string) -> future-id;
    list:   func(ns: string, prefix: string, limit: u32) -> future-id;
}

interface blob {
    use types.{future-id};
    get: func(bucket: string, key: string) -> future-id;         // UNBOUNDED
    put: func(bucket: string, key: string, value: list<u8>) -> future-id;
}

interface queue {
    use types.{future-id};
    send: func(q: string, body: list<u8>) -> future-id;          // bounded
}

interface sql {
    use types.{future-id};
    query: func(binding: string, statement: string, params: list<list<u8>>) -> future-id;
}

interface durable {
    use types.{future-id};
    /// Addressed call to another Durable Instance. Class: bounded.
    call: func(class: string, name: string, method: string, payload: list<u8>) -> future-id;
    /// Transactional write, fenced by the current epoch.
    persist: func(state: list<u8>) -> future-id;
    storage-get: func(key: string) -> future-id;
    storage-put: func(key: string, value: list<u8>) -> future-id;
    /// Durable, at-least-once, survives hibernation; lives in the control
    /// plane, not the guest (invariant 2).
    alarm-set:    func(name: string, at-ms: u64);
    alarm-cancel: func(name: string);
    /// Exposed so tenants can build idempotency keys.
    fencing-epoch: func() -> u64;
    /// Effectively-once external effects: persisted atomically with state
    /// under the same fencing epoch, then executed at-least-once with an
    /// idempotency key.
    outbox-enqueue: func(effect: list<u8>) -> future-id;
}

interface socket {
    use types.{future-id, handle};
    /// Registers a host-owned socket against this instance. The instance may
    /// then hibernate while the socket stays open.
    accept:    func(h: handle, tag: string);
    send:      func(h: handle, frame: list<u8>) -> future-id;
    broadcast: func(frame: list<u8>, except-tag: option<string>) -> future-id;
    close:     func(h: handle);
}

interface secret {
    use types.{future-id};
    /// SENSITIVE. Runtime only — never available at init — and excluded from
    /// every capture path, including `wisp replay`.
    get: func(name: string) -> future-id;
}

interface observe {
    enum level { trace, debug, info, warn, error }
    /// Logging costs the caller: it counts against the dispatch CPU budget.
    emit: func(lvl: level, fields-json: string);
    span-begin: func(name: string) -> u64;
    span-end: func(span: u64);
}

interface ctx {
    use types.{future-id};
    /// Extends instance lifetime past the response for fire-and-forget work,
    /// bounded by the CPU budget.
    wait-until: func(f: future-id);

    /// The host-published remaining-budget value. Signed
    /// nanoseconds left against the dispatch's CPU budget B; negative once the
    /// dispatch is in its grace window. The runtime layer reads it at the
    /// allocation slow path, GC entry and task switch, and raises
    /// `BudgetExceededException` when it is <= 0 — which is what makes clean
    /// kills the common case.
    budget-remaining-ns: func() -> s64;

    /// The runtime layer's *unsafe-to-trap* bit. Set around GC phases
    /// and scheduler queue mutations. Grace entry defers while it is set; the
    /// hard deadline at B+G ignores it, so a pinned bit buys exactly G.
    unsafe-to-trap: func(on: bool);
}

/// What the platform provides to a guest.
world wisp-platform {
    import types;
    import clock;
    import entropy;
    import http;
    import kv;
    import blob;
    import queue;
    import sql;
    import durable;
    import socket;
    import secret;
    import observe;
    import ctx;

    /// Host->guest buffer handoff. No host pointer ever enters guest
    /// memory; data is copied into a guest-allocated buffer.
    export wisp-alloc: func(size: u32, align: u32) -> u32;

    /// A new top-level work item: HTTP request, DI message, alarm, socket
    /// frame, queue batch, or cron tick.
    export wisp-handle: func(dispatch: list<u8>) -> u64;

    /// Completion of a previously returned future. Delivery order for
    /// distinct futures is UNSPECIFIED.
    export wisp-wake: func(f: u64, result: list<u8>) -> u64;

    /// Pre-snapshot compaction hint. A guest that ignores it is
    /// correct but stores a larger delta — and pays for it.
    export wisp-gc-hint: func(pressure: u8);

    /// Pre-initialization entrypoint, run ONCE at deploy time inside the
    /// sealed init sandbox where every I/O import traps.
    export wisp-initialize: func();
}
