+// The WebAssembly C ABI extends scalar integers smaller than i32 at the call
+// boundary. LLVM integer types alone leave the high bits unspecified.
+static llvm::Attribute::AttrKind getUnmanagedIntegerExtension(CorInfoType type)
+{
+    switch (type)
+    {
+        case CORINFO_TYPE_BOOL:
+        case CORINFO_TYPE_CHAR:
+        case CORINFO_TYPE_UBYTE:
+        case CORINFO_TYPE_USHORT:
+            return llvm::Attribute::ZExt;
+        case CORINFO_TYPE_BYTE:
+        case CORINFO_TYPE_SHORT:
+            return llvm::Attribute::SExt;
+        default:
+            return llvm::Attribute::None;
+    }
+}
