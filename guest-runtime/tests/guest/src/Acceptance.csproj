<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    The acceptance guest for the source-built runtime: one handler per family
    of runtime modification, each request path one behaviour. Built by
    ../build.sh in either SDK profile, each of which compiles against the
    pack guest-runtime/build.sh publishes for it.
  -->
  <Import Project="../../../../guest-sdks/dotnet/Wisp.Guest.props" />

  <PropertyGroup>
    <AssemblyName>guest_runtime_acceptance</AssemblyName>
    <RootNamespace>Acceptance</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../guest-sdks/dotnet/Wisp.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosting family: the application stack a customer builds on. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../../../guest-sdks/dotnet/Wisp.Guest.targets" />
</Project>
