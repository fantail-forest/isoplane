<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    The acceptance guest for the source-built runtime: one handler per family
    of runtime modification, each request path one behaviour. Built by
    ../build.sh in either SDK profile, each of which compiles against the
    pack guest-runtime/build.sh publishes for it.
  -->
  <Import Project="../../../../guest-sdks/dotnet/Isoplane.Guest.props" />

  <PropertyGroup>
    <AssemblyName>guest_runtime_acceptance</AssemblyName>
    <RootNamespace>Acceptance</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <EventSourceSupport>true</EventSourceSupport>
    <!-- The multi-family fixture exceeds WASI's 50 MiB static-image default. -->
    <WasmInitialHeapSize>67108864</WasmInitialHeapSize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsoplaneCompilerProbe)' == 'true'">
    <Optimize>false</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);ISOPLANE_COMPILER_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsoplaneCompilerProbe)' == 'true'">
    <Compile Remove="App/**/*.cs" />
    <Compile Include="../compiler/Handler.cs" />
    <Compile Include="../../../../guest-sdks/dotnet/Abi/Tests/NativeCompilerProbe.cs" />
    <NativeLibrary Include="$(IsoplaneCompilerProbeObject)" Library="isoplane_compiler_probe" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Payload/**/*.cs" />
    <Compile Include="../../../../guest-sdks/dotnet/Abi/Tests/NativeLibraryProbe.cs" />
    <ProjectReference Include="../../../../guest-sdks/dotnet/Isoplane.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosting family: the application stack a customer builds on. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsoplaneGuestRuntime)' == 'Mono'">
    <TrimmerRootAssembly Include="System.Runtime" />
    <EmbeddedResource Include="$(IsoplaneAcceptancePayload)" LogicalName="dynamic-payload" />
  </ItemGroup>

  <Target Name="RequireAcceptancePayload" BeforeTargets="PrepareForBuild"
          Condition="'$(IsoplaneGuestRuntime)' == 'Mono'">
    <Error Condition="!Exists('$(IsoplaneAcceptancePayload)')"
           Text="Build the acceptance payload through guest-runtime/tests/guest/build.sh." />
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../../../guest-sdks/dotnet/Isoplane.Guest.targets" />
</Project>
