<Project>
  <PropertyGroup>
    <ArtifactsPath>$(ISOPLANE_FIXTURE_ARTIFACTS)</ArtifactsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    The acceptance guest for the source-built runtime: one handler per family
    of runtime modification, each request path one behaviour. Task packages
    its managed assemblies for the shared Mono runtime.
  -->

  <PropertyGroup>
    <AssemblyName>guest_runtime_acceptance</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BaseOutputPath>$(ISOPLANE_FIXTURE_ARTIFACTS)/bin/</BaseOutputPath>
    <RootNamespace>Acceptance</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <Import Project="../../../../guest-sdks/dotnet/Build/Isoplane.ManagedBundle.props" />

  <ItemGroup>
    <Compile Remove="Payload/**/*.cs" />
    <Compile Include="../../../../guest-sdks/dotnet/Abi/Tests/NativeLibraryProbe.cs" />
    <ProjectReference Include="../../../../guest-sdks/dotnet/Isoplane.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosting family: the application stack a customer builds on. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="System.Runtime" />
    <ProjectReference Include="Payload/Payload.csproj" ReferenceOutputAssembly="false" OutputItemType="EmbeddedResource" LogicalName="dynamic-payload" />
  </ItemGroup>


  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../../../guest-sdks/dotnet/Build/Isoplane.ManagedBundle.targets" />
</Project>
