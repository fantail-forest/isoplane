<Project>
  <PropertyGroup>
    <ArtifactsPath>$(ISOPLANE_FIXTURE_ARTIFACTS)</ArtifactsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(IsoplaneProbe)</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <BaseOutputPath>$(ISOPLANE_FIXTURE_ARTIFACTS)/bin/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="../../../guest-sdks/dotnet/Build/Isoplane.ManagedBundle.props" />
  <ItemGroup>
    <Compile Include="../../../guests/dotnet/src/$(IsoplaneProbe)/*.cs;../../../guests/dotnet/src/Shared/*.cs" />
    <EmbeddedResource Include="../../../guests/dotnet/src/$(IsoplaneProbe)/*.txt" LogicalName="%(Filename)" />
    <ProjectReference Include="../../../guest-sdks/dotnet/Isoplane.Sdk.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="../../../guest-sdks/dotnet/Build/Isoplane.ManagedBundle.targets" />
</Project>
