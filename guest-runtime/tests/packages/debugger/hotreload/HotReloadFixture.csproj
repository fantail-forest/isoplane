<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Debugger.HotReload.Fixture</AssemblyName>
    <Description>Shared debugger fixture with compiler-generated Hot Reload updates.</Description>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DeltaScript>deltas.json</DeltaScript>
    <EnableSourceLink>false</EnableSourceLink>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10-transport/nuget/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../hotreload.cs" />
    <PackageReference Include="Microsoft.DotNet.HotReload.Utils.Generator.BuildTool" Version="10.0.0-alpha.0.25479.2" PrivateAssets="all" IncludeAssets="build" />
  </ItemGroup>
</Project>
