using System;

namespace Debugger.HotReload;

/// <summary>A statement edited in source while the invocation that ran it is paused.</summary>
public static class EditedStatement
{
    public static string Handle()
    {
        int value = 1;

        value += Added(); // HOT_RELOAD_BODY
        System.Diagnostics.Debugger.Break();
        return value.ToString();
    }

    /// <summary>A method introduced by the edit.</summary>
    public static int Added() => 100;
}

/// <summary>Receives a field through a source edit.</summary>
public static class EditedStatementStorage
{
    /// <summary>The field introduced by the edit.</summary>
    public static int Added;
}
