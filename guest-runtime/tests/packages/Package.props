<Project>
  <!--
    What every package fixture imports first: an interpreted application built
    as the Isoplane SDK builds one, stopping at the managed bundle.
  -->
  <PropertyGroup>
    <IsoplaneGuestRuntime>Mono</IsoplaneGuestRuntime>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Import Project="../../../guest-sdks/dotnet/Isoplane.Guest.props" />
  <Import Project="../../../guest-sdks/dotnet/Build/Isoplane.ManagedBundle.props" />
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../guest-sdks/dotnet/Isoplane.Sdk.csproj" />
  </ItemGroup>
</Project>
