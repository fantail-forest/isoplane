# The exact inputs of the Isoplane guest runtime build. build.sh reads this file;
# every version literal for the guest runtime lives here and nowhere else.

# dotnet/runtime, released servicing tag. The tarball hash pins the source
# bytes independently of the tag.
RUNTIME_TAG=v10.0.11
RUNTIME_COMMIT=79d0c463f1b55624c874a11585f7e47731e8d675
RUNTIME_TARBALL_URL=https://codeload.github.com/dotnet/runtime/tar.gz/refs/tags/v10.0.11
RUNTIME_TARBALL_SHA256=25ffd0053a423b00c2e08010c00e07b6044b7288aa6dffcf741b7bce2b0b87e7

# OpenSSL, compiled into the guest as the BCL's cryptography backend.
OPENSSL_TAG=openssl-3.5.0
OPENSSL_TARBALL_URL=https://codeload.github.com/openssl/openssl/tar.gz/refs/tags/openssl-3.5.0
OPENSSL_TARBALL_SHA256=576740bfe93209efda2be7cecb00dfeabe77fe9c5c908c1790cbe8fa50b223d0

# One wasi-sdk for the runtime archives, OpenSSL, the PAL and the final link.
# The runtime build provisions this version itself under its source tree.
WASI_SDK_VERSION=29.0

# The runtime pack's version: Arcade derives
# <major>.<minor>.<patch>-<label>-<inputs digest>-<time of day>.<iteration>.<date stamp>.1
# from these, with the digest and time stamps added by build.sh so no two
# builds share a version; build.sh feed records the exact version for the SDK.
PACK_PATCH=11
PACK_LABEL=isoplane
PACK_ITERATION=1

# wasi-sdk release archive, provisioned into work/wasi-sdk by build.sh toolchain.
WASI_SDK_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-29/wasi-sdk-29.0-x86_64-linux.tar.gz
WASI_SDK_SHA256=87d1d1a2879d139cdc624b968efad3d4a97b8078cdff95e63ac88ecafd1a0171
WASI_SDK_WINDOWS_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-29/wasi-sdk-29.0-x86_64-windows.tar.gz
WASI_SDK_WINDOWS_SHA256=6c19b820577486f00332ad8d04ac506da67b0892316b8d485371a58cbf216dee

# Complete data from the same ICU subtree as the pinned native transport.
ICU_SOURCE_COMMIT=0f2ad524e8e5c745ecd62b757387c62a780e3c3e
ICU_SOURCE_URL=https://api.github.com/repos/dotnet/icu/tarball/0f2ad524e8e5c745ecd62b757387c62a780e3c3e
ICU_SOURCE_SHA256=f72d2413f2fcd515a8a54e1283c2e3faaa4e4f371384d083b6c8bd39280b70c9
ICU_DATA_FILE=icudt68l.dat
ICU_MONO_TRANSPORT_VERSION=10.0.0-rtm.26364.2
ICU_MONO_TRANSPORT_URL=https://pkgs.dev.azure.com/dnceng/9ee6d478-d288-47f7-aacc-f6e6d082ae6d/_packaging/8ea23ec3-b9b2-4976-90d7-7c4a6f529fdc/nuget/v3/flat2/microsoft.netcore.runtime.icu.transport/10.0.0-rtm.26364.2/microsoft.netcore.runtime.icu.transport.10.0.0-rtm.26364.2.nupkg
ICU_MONO_TRANSPORT_SHA256=ef1e4bb7c411db82306f1e60fd441f13d79b029cca870fc3c61033eb3b0d0019
