# Host toolchain downloads used by local builds. Runtime package inputs are
# pinned in vendor/dotnet-runtime/eng/isoplane/manifest.env.

# One wasi-sdk for the runtime archives, OpenSSL, the PAL and the final link.
# The runtime build provisions this version itself under its source tree.
WASI_SDK_VERSION=29.0

# SHA-256 of the wasi-sdk release archive for each build host.
WASI_SDK_X86_64_LINUX_SHA256=87d1d1a2879d139cdc624b968efad3d4a97b8078cdff95e63ac88ecafd1a0171
WASI_SDK_X86_64_WINDOWS_SHA256=6c19b820577486f00332ad8d04ac506da67b0892316b8d485371a58cbf216dee
WASI_SDK_ARM64_MACOS_SHA256=e11552913e3f99e834d7fe7da1bd081abaf764759ed76b6097a34c63fc83665e
WASI_SDK_X86_64_MACOS_SHA256=d0de2fd3ea5c57060efa87e4356c164bec3689972f2386f0c9a89c58e10cec8d
