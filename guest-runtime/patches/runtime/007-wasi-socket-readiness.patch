+int32_t SystemNative_GetWasiSocketReadiness(intptr_t socket, uint32_t* handles, int32_t capacity, int32_t* count, int32_t* events)
+{
+    if (handles == NULL || count == NULL || events == NULL || capacity < 0)
     {
