diff --git a/src/mono/mono/sgen/sgen-memory-governor.c b/src/mono/mono/sgen/sgen-memory-governor.c
index d28ec1f9668..a2a9b11b47c 100644
--- a/src/mono/mono/sgen/sgen-memory-governor.c
+++ b/src/mono/mono/sgen/sgen-memory-governor.c
@@ -434,8 +434,15 @@ sgen_assert_memory_alloc (void *ptr, size_t requested_size, const char *assert_d
 {
 	if (ptr || !assert_description)
 		return;
+#ifdef HOST_WASI
+	/* A WASI embedding has no console; the runtime's log is how it learns
+	   why start-up failed, so the text survives disabled assert messages. */
+	g_log (G_LOG_DOMAIN, G_LOG_LEVEL_ERROR, "Garbage collector could not allocate %" G_GSIZE_FORMAT "u bytes of memory for %s.", requested_size, assert_description);
+	eg_unreachable ();
+#else
 	fprintf (stderr, "Error: Garbage collector could not allocate %" G_GSIZE_FORMAT "u bytes of memory for %s.\n", requested_size, assert_description);
 	exit (1);
+#endif
 }
 
