diff --git a/src/native/libs/System.Security.Cryptography.Native/CMakeLists.txt b/src/native/libs/System.Security.Cryptography.Native/CMakeLists.txt
index 26886f4a2..8539e9f8f 100644
--- a/src/native/libs/System.Security.Cryptography.Native/CMakeLists.txt
+++ b/src/native/libs/System.Security.Cryptography.Native/CMakeLists.txt
@@ -3,10 +3,6 @@ cmake_minimum_required(VERSION 3.10..3.20)
 
 project(System.Security.Cryptography.Native C)
 
-if(CLR_CMAKE_TARGET_ARCH_WASM)
-    message(FATAL_ERROR "Not implemented for WASM")
-endif()
-
 # These are happening inside of OpenSSL-defined macros out of our control
 add_compile_options(-Wno-cast-align)
 add_compile_options(-Wno-reserved-id-macro)
diff --git a/src/native/libs/build-native.proj b/src/native/libs/build-native.proj
index a3b3c78ea..f1fd5d92e 100644
--- a/src/native/libs/build-native.proj
+++ b/src/native/libs/build-native.proj
@@ -42,6 +42,18 @@
     <Copy SourceFiles="@(_IcuArtifacts)" DestinationFolder="$([MSBuild]::NormalizeDirectory('$(ArtifactsBinDir)', 'native', '$(_BuildNativeOutConfig)'))" SkipUnchangedFiles="true" />
   </Target>
 
+  <!-- OpenSSL compiled to wasm, supplied by the caller, ships beside the
+       cryptography shim it links so the target pack carries the whole
+       backend. -->
+  <Target Name="BinplaceWasiOpenSsl"
+          AfterTargets="BuildNativeUnix"
+          Condition="'$(TargetOS)' == 'wasi' and '$(WasiOpenSslLibDir)' != ''">
+    <Error Condition="!Exists('$(WasiOpenSslLibDir)/libcrypto.a')" Text="WasiOpenSslLibDir=$(WasiOpenSslLibDir) has no libcrypto.a" />
+    <Copy SourceFiles="$(WasiOpenSslLibDir)/libssl.a;$(WasiOpenSslLibDir)/libcrypto.a"
+          DestinationFolder="$([MSBuild]::NormalizeDirectory('$(ArtifactsBinDir)', 'native', '$(_BuildNativeOutConfig)'))"
+          SkipUnchangedFiles="true" />
+  </Target>
+
   <Target Name="BuildNativeUnix"
           DependsOnTargets="BuildNativeCommon"
           BeforeTargets="Build"
