<Project Sdk="Isoplane.AspNetCore/0.1.0-preview.2">
  <PropertyGroup>
    <PublishAot>false</PublishAot>
    <PublishAot Condition="'$(Configuration)' == 'IsoplaneNativeAotRelease'">true</PublishAot>
    <IsoplaneApplicationFactory>Example.App.Create</IsoplaneApplicationFactory>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Update="greeting.txt" CopyToOutputDirectory="PreserveNewest" TargetPath="data/greeting.txt" />
  </ItemGroup>
</Project>
