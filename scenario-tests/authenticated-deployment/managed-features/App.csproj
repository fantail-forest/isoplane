<Project Sdk="Isoplane.AspNetCore/0.1.0-preview.2">
  <PropertyGroup>
    <PublishAot>false</PublishAot>
    <PublishAot Condition="'$(Configuration)' == 'IsoplaneNativeAotRelease'">true</PublishAot>
    <IsoplaneApplicationFactory>ManagedFeatures.App.Create</IsoplaneApplicationFactory>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>
</Project>
